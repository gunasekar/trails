#!/bin/sh
# A stand-in for fzf, so a test can drive the picker without a keyboard. It reads the rows
# on stdin and prints the first whose drawn text matches $FZF_PICK (an extended regex,
# matched with the colour codes stripped). No match, or no FZF_PICK, is an abort, as ctrl-c
# is: exit 130. FZF_PICK=!esc is Esc: the key, where --expect names esc as the picker's
# screens do, and an abort where it does not, as fzf's own Esc is. FZF_PICK=!query is Enter on
# what was typed, $FZF_QUERY, with nothing picked: what accept-or-print-query does.
#
# With --print-query among the arguments it prints $FZF_QUERY first, as fzf does, which
# is how the picker's ctrl-n carries a trail's name. $FZF_KEYS names the keys a test
# "pressed" before Enter: ctrl-n runs the bound execute-silent, which is how the picker
# learns a name was typed.
# $FZF_KEYS may name a file instead: then its first line is this fzf's keys, taken off the
# top, so one run's several fzfs each get their own.
keys=${FZF_KEYS:-}
# $FZF_KEY, the --expect key, may name a file too: one line per fzf, empty for Enter.
expect_key=${FZF_KEY:-}
if [ -n "$expect_key" ] && [ -f "$expect_key" ]; then
  kf=$expect_key
  expect_key=$(head -n 1 "$kf")
  sed -i.bak 1d "$kf" && rm -f "$kf.bak"
fi
if [ -n "$keys" ] && [ -f "$keys" ]; then
  f=$keys
  keys=$(head -n 1 "$f")
  sed -i.bak 1d "$f" && rm -f "$f.bak"
fi
query=; expect=; esc=; multi=1
for a in "$@"; do
  case $a in
    --print-query) query=1 ;;
    --multi=*) multi=${a#--multi=} ;;
    --multi) multi=999 ;;
    --expect=*)
      expect=1
      case ",${a#--expect=}," in
        *,esc,*) esc=1 ;;
        *) ;;
      esac
      ;;
    # ctrl-x, as the picker binds it: run on the picked row, its {2} the row's second field.
    --bind=ctrl-x:execute-silent\(*)
      xcmd=${a#--bind=ctrl-x:execute-silent(}
      xcmd=${xcmd%%)+*}
      ;;
    --bind=ctrl-n:execute-silent\(*)
      case ",$keys," in
        *,ctrl-n,*)
          cmd=${a#--bind=ctrl-n:execute-silent(}
          cmd=${cmd%%)*}
          sh -c "$cmd"
          ;;
      esac
      ;;
    *) ;;
  esac
done

rows=$(cat)
# $FZF_DUMP names a file to copy the rows to, as they arrived: how a test reads the menu.
# With several fzfs in one run (a screen leading to another), $FZF_DUMP gets each one's
# rows appended under a "--- N" line, and $FZF_PICKS names a file of picks, one per fzf
# in order, each line taken off the top as it is used.
[ -n "${FZF_DUMP:-}" ] && {
  n=$(grep -c '^--- ' "$FZF_DUMP" 2>/dev/null || echo 0)
  printf -- '--- %s\n%s\n' "$((n + 1))" "$rows" >>"$FZF_DUMP"
}
if [ -n "${FZF_PICKS:-}" ] && [ -s "$FZF_PICKS" ]; then
  FZF_PICK=$(head -n 1 "$FZF_PICKS")
  sed -i.bak 1d "$FZF_PICKS" && rm -f "$FZF_PICKS.bak"
fi
[ -n "${FZF_PICK:-}" ] || exit 130
if [ "$FZF_PICK" = '!query' ]; then
  [ -n "$query" ] && printf '%s\n' "${FZF_QUERY:-}"
  exit 0
fi
# FZF_PICK=!all:REGEX picks every row that matches, up to --multi's limit, as Tab on each would.
case $FZF_PICK in
  '!all:'*)
    printf '%s\n' "$rows" | while IFS= read -r row; do
      plain=$(printf '%s' "$row" | sed 's/\x1b\[[0-9;]*m//g')
      printf '%s' "$plain" | grep -Eq "${FZF_PICK#!all:}" && printf '%s\n' "$row"
    done | head -n "$multi"
    exit 0
    ;;
  *) ;;
esac
if [ "$FZF_PICK" = '!esc' ]; then
  [ -n "$esc" ] || exit 130
  [ -n "$query" ] && printf '%s\n' "${FZF_QUERY:-}"
  printf 'esc\n'
  exit 0
fi
pick=$(printf '%s\n' "$rows" | while IFS= read -r row; do
  plain=$(printf '%s' "$row" | sed 's/\x1b\[[0-9;]*m//g')
  if printf '%s' "$plain" | grep -Eq "$FZF_PICK"; then
    printf '%s\n' "$row"
    break
  fi
done)
[ -n "$pick" ] || exit 130
# $FZF_KEYS naming ctrl-x: the bound command runs on the picked row, and fzf is left as Esc
# would leave it. Without a ctrl-x binding on this screen, nothing runs.
case ",$keys," in
  *,ctrl-x,*)
    [ -z "${xcmd:-}" ] || sh -c "$(printf '%s' "$xcmd" | sed "s|{2}|'$(printf '%s' "$pick" | cut -f2)'|")"
    exit 130
    ;;
  *) ;;
esac
# --expect prints the key that ended fzf after the query: $FZF_KEY, or an empty line for Enter.
[ -n "$query" ] && printf '%s\n' "${FZF_QUERY:-}"
[ -n "$expect" ] && printf '%s\n' "$expect_key"
printf '%s\n' "$pick"
