#!/bin/sh
# A stand-in for fzf, so a test can drive the picker without a keyboard. It reads the rows
# on stdin and prints the first whose drawn text matches $FZF_PICK (an extended regex,
# matched with the colour codes stripped). No match, or no FZF_PICK, is Esc: exit 130.
#
# With --print-query among the arguments it prints $FZF_QUERY first, as fzf does, which
# is how the picker's ctrl-n carries a trail's name. $FZF_KEYS names the keys a test
# "pressed" before Enter: ctrl-n runs the bound execute-silent, which is how the picker
# learns a name was typed.
query=; keys=
for a in "$@"; do
  case $a in
    --print-query) query=1 ;;
    --bind=ctrl-n:execute-silent\(*)
      case ",${FZF_KEYS:-}," in
        *,ctrl-n,*)
          cmd=${a#--bind=ctrl-n:execute-silent(}
          cmd=${cmd%%)*}
          sh -c "$cmd"
          ;;
      esac
      ;;
    *) ;;
  esac
done

rows=$(cat)
# $FZF_DUMP names a file to copy the rows to, as they arrived: how a test reads the menu.
[ -n "${FZF_DUMP:-}" ] && printf '%s\n' "$rows" >"$FZF_DUMP"
[ -n "${FZF_PICK:-}" ] || exit 130
pick=$(printf '%s\n' "$rows" | while IFS= read -r row; do
  plain=$(printf '%s' "$row" | sed 's/\x1b\[[0-9;]*m//g')
  if printf '%s' "$plain" | grep -Eq "$FZF_PICK"; then
    printf '%s\n' "$row"
    break
  fi
done)
[ -n "$pick" ] || exit 130
[ -n "$query" ] && printf '%s\n' "${FZF_QUERY:-}"
printf '%s\n' "$pick"
