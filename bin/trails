#!/usr/bin/env sh
# trails — an fzf picker for AI coding agents that live in tmux. Run it from any shell, or
# make it an editor's terminal command (nvim's agent panel, Zed's terminal_init_command) so
# every frontend lands on the same sessions. https://github.com/gunasekar/trails
#
#   trails                  pick a running session to rejoin, or an agent to start
#   trails help             the commands and picker keys (also -h, --help)
#   trails ls [-a | DIR]    this directory's trails: running, lost with tmux, or
#                           ended in the last 10 days; DIR's instead, or -a for every one.
#                           A table on a terminal, TSV when piped, for a notifier to read.
#                           See "Session states" below.
#   trails restore          bring back every session that died with tmux (a reboot, a
#                           crash, kill-server), each resuming its conversation, detached.
#                           See "Surviving tmux" below.
#   trails config           the agents file, ~/.config/trails/config.json. See
#                           "Agents" below.
#   trails map [N]          several agents at once in one window. Pick them, or take the
#                           N that most want you. Bare `map` re-attaches to a map
#                           already up rather than rebuilding; `map new` forces a fresh
#                           pick. Inside, all stock tmux: C-b ←↑↓→ move, C-b z zoom one
#                           full-screen, C-b Space cycle layout, C-b d detach. C-b C-b s
#                           re-points one pane at a different agent — C-b C-b is send-prefix,
#                           so the key lands on the pane's own (inner) client rather than on
#                           the map. To add one, split a shell off (C-b |) and run
#                           `trails` there: the agent gets its own session as usual and
#                           that pane becomes its session.
#
# In the picker: "＋ new trail…", which lists the agents you can start, then this directory's
# trails — ● running, ○ not.
# Enter opens the highlighted row (attach, restore, resume, start), tab toggles YOLO on an
# agent or a closed session, ctrl-x ends a running session or forgets a lost one.
#
# Env:
#   TRAILS_RECENT_DAYS     how far back closed rows look, in the picker and `trails ls` (default 10)
#   TRAILS_RECENT_MAX      how many of them to show (default 5)
#
# Not `agent`: the bin directories on PATH are a shared namespace, and cursor-agent ships
# a binary called `agent` that overwrote this script's symlink on install and on every
# self-update. Owning a name a vendor also wants is a fight you re-lose on every update.
# It was `aigent` for a while, which dodged that but not speech-to-text, which hears
# "agent" every time. `trails` is a word nobody mishears and no other tool claims.
#
# Trails live in tmux: each is a small session of its own, <workspace>/<codebase>, holding
# the agent and nothing else — what an editor attaches to — and is shown in a session named
# after its workspace through a trail's window, a window attached to it, beside which the editor and a
# shell go (see "Workspaces", "Trails" and "Editor and shell" below, and docs/design/trails-1.0.md).
# Before 1.0 each was a session named trails-<project>; those keep working until they end.
#
# Why tmux: Zed's remote mode runs this on the ssh host, and when Zed disconnects the
# agent process dies with its terminal, leaving `claude --resume` (which replays the
# transcript into a *new* process) as the only way back. Held in tmux the process
# stays alive, so reconnecting re-attaches to the running conversation with nothing to
# resume. Every frontend goes through this one script; the same trail is reachable
# from a plain terminal with `tmux a -t <workspace>/<codebase>`.

# LAUNCH_DETACHED belongs to restore_one alone (see there). One inherited from the
# environment is a leak from a trails before 0.4.2, which exported it into tmux; clear it so it
# can't stop this run from attaching.
unset LAUNCH_DETACHED

# `trails state working|waiting|idle [--id ID] [--agent PROGRAM]`: an agent's hooks telling
# trails what it is doing, and which conversation it is in (ADR 18, ADR 19). It marks the
# agent's own pane, which the hook inherits as TMUX_PANE, with the word, which classify reads
# back; with @trails_worked once the conversation has had a turn, so one that never did stays
# out of the history (hist_add); and with the conversation's ID when the hook passes one. How
# a hook gets the ID out of its agent is the hook's business: trails takes it as given, and
# reads nothing of the agent's.
#
# Here at the top, before anything reads the config: it runs on every turn of every agent
# that has the hooks. Silent and 0 whatever happens, outside tmux or with a word it doesn't
# know included, since a hook's output can land in the agent's transcript and a failing hook
# is reported on every turn.
#
# Whatever runs in the trail's pane inherits it, an agent the trail's agent starts from its
# shell (a `claude -p`) included, and that agent's hooks speak of their own state and their
# own conversation. Two guards, neither naming an agent:
#
#   --agent    the hook's program (the snippets pass it). One that isn't the trail's agent's
#              (@trails_program, from launch) is not the trail's: its word and ID are dropped.
#   depth      the same program, started by the agent: the trail's agent is the one nearest
#              the pane's process, so the first ID records how many processes up the pane's
#              process is (@trails_said_depth), and an ID from deeper down is left out.
#
# An ID is taken only if it is one (id_ok's rule, spelled out here, before it is defined). A
# new one moves the trail's record at once, in the background (--said), rather than at the
# next listing, which a reboot might come before. "Had a turn" is a working, or any word after
# the first: an agent whose prompt hook doesn't fire (Cursor's CLI) still ends turns.
if [ "${1:-}" = state ]; then
  st_word=${2:-}
  case $st_word in
    working | waiting | idle) ;;
    *) exit 0 ;;
  esac
  [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] || exit 0
  shift 2
  st_id='' st_agent=''
  while [ $# -ge 2 ]; do
    case $1 in
      --id) st_id=$2 ;;
      --agent) st_agent=$2 ;;
      *) ;;
    esac
    shift 2
  done
  case $st_id in
    [A-Za-z0-9]*) ;;
    *) st_id= ;;
  esac
  case $st_id in
    *[!A-Za-z0-9_.-]*) st_id= ;;
    *) ;;
  esac
  st_pane=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_pid}|#{@trails_session}|#{@trails_program}|#{@trails_said_depth}|#{@trails_state}|#{@trails_id}' 2>/dev/null) || exit 0
  st_root=${st_pane%%|*} st_pane=${st_pane#*|}
  st_trail=${st_pane%%|*} st_pane=${st_pane#*|}
  st_prog=${st_pane%%|*} st_pane=${st_pane#*|}
  st_known=${st_pane%%|*} st_pane=${st_pane#*|}
  st_before=${st_pane%%|*} st_carried=${st_pane#*|}
  [ -z "$st_agent" ] || [ -z "$st_prog" ] || [ "$st_agent" = "$st_prog" ] || exit 0
  set -- set-option -pq -t "$TMUX_PANE" @trails_state "$st_word"
  if [ "$st_word" = working ] || [ -n "$st_before" ]; then
    set -- "$@" \; set-option -pq -t "$TMUX_PANE" @trails_worked 1
  fi
  [ -n "$st_trail" ] || st_id=
  if [ -n "$st_id" ]; then
    st_p=$PPID st_d=0
    while [ -n "$st_p" ] && [ "$st_p" != "$st_root" ] && [ "$st_p" -gt 1 ] 2>/dev/null && [ "$st_d" -lt 16 ]; do
      st_p=$(ps -o ppid= -p "$st_p" 2>/dev/null | tr -d ' ')
      st_d=$((st_d + 1))
    done
    if [ "$st_p" != "$st_root" ] || { [ -n "$st_known" ] && [ "$st_d" -gt "$st_known" ]; }; then
      st_id=
    else
      set -- "$@" \; set-option -pq -t "$TMUX_PANE" @trails_said_depth "$st_d" \
        \; set-option -pq -t "$TMUX_PANE" @trails_said_id "$st_id"
    fi
  fi
  tmux "$@" >/dev/null 2>&1
  if [ -n "$st_id" ] && [ "$st_id" != "$st_carried" ]; then
    "$0" --said </dev/null >/dev/null 2>&1 &
  fi
  exit 0
fi

# TRAILS_NAME is the name of the trail being started, set by `trails new` and the picker's
# ctrl-n, never read from outside: one inherited from an agent's shell would name every trail
# started there the same.
TRAILS_NAME=

# ─── Agents ──────────────────────────────────────────────────────────────────
# Which agents trails can start, and how, come from a JSON file you edit — never from this
# script. The shape follows claude-squad's, so an agent is a name and the command it runs:
#
#   ~/.config/trails/config.json
#   {
#     "mode": "default",
#     "default_agent": "claude",
#     "agents": [
#       { "name": "claude", "program": "claude",
#         "yolo": "--dangerously-skip-permissions",
#         "session": { "start": "--session-id {id}", "resume": "--resume {id}", "id": "uuid" } },
#       { "name": "aider", "program": "aider --model ollama_chat/gemma3:1b", "yolo": "--yes-always" }
#     ]
#   }
#
#   name      what the picker calls it. Letters, digits, . _ - only: it is part of a picker
#             target and a tmux option value.
#   program   the command line, split on spaces. No shell quoting: anything that needs it
#             belongs in a wrapper script.
#   yolo      the flag that runs everything unconfirmed. Opt-in per launch with Tab, so a
#             stray Enter is always the safe mode. Omit it for an agent that has none.
#   session   what makes a session survive tmux (see "Surviving tmux"): `resume` picks a
#             conversation back up, {id} is where the ID goes, and how trails learns the ID
#             in the first place —
#               start   begin the conversation under an ID trails chooses; `id` is its shape,
#                       "uuid" or "ses_hex" (ses_ + 32 hex, what opencode insists on)
#               create  a command that prints a fresh ID (cursor-agent create-chat)
#             or neither, for an agent that picks its own: its hooks say it (trails state
#             WORD --id ID), and say it again when the agent moves to another conversation.
#             Without a way to the ID the agent still runs, it just isn't brought back after
#             a reboot. trails reads none of an agent's own files (ADR 19).
#             session.name is the flag that gives the agent a name of its own, {name} where it
#             goes: claude's --name. Only a trail you name (trails new NAME, or ctrl-n in the
#             picker) passes it.
#   default_agent  listed first in the picker.
#   mode           "default" (the agent's own, prompting mode) or "yolo": which a "+ new" row
#                  starts in. Tab flips a row from it, so with "yolo" Tab is how you start one
#                  in default mode. Closed sessions come back in the mode they last ran in
#                  either way, and an agent with no yolo flag always runs in default mode.
#   data           a folder of yours for each codebase's checklist (see "Checklist"), at
#                  <data>/trails/<path>/checklist.md; ".trails/checklist.md" in the codebase
#                  without it. "notes", the checklist's path before 1.7, is read too.
#   diff           what `trails diff` shows the changes with (see "The diff"): a command
#                  the diff is piped to; { "command": ..., "pipe": false } for one that
#                  finds them itself, run in the popup; or { "command": ..., "gui": true }
#                  for a program with a window of its own. delta, side by side, when
#                  installed.
#
# Without a file, the built-in agents below apply; `trails config` writes them out as a
# starting point. Only agents whose command is on PATH are offered, so listing an agent you
# have not installed costs nothing.
#
# Choosing the conversation ID up front is the point of `session` — `--continue` means "the
# latest in this directory", so trails-foo and trails-foo-2 would both resume the same one.
#
# Ended trails (closed rows) come from trails' own history, not the agents' (see "History").
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/trails/config.json

DEFAULT_CONFIG='{
  "mode": "default",
  "default_agent": "claude",
  "agents": [
    {
      "name": "claude",
      "program": "claude",
      "yolo": "--dangerously-skip-permissions",
      "session": { "start": "--session-id {id}", "resume": "--resume {id}", "id": "uuid",
                   "name": "--name {name}" }
    },
    {
      "name": "codex",
      "program": "codex",
      "yolo": "--dangerously-bypass-approvals-and-sandbox",
      "session": { "resume": "resume {id}" }
    },
    {
      "name": "gemini",
      "program": "gemini",
      "yolo": "--approval-mode yolo",
      "session": { "start": "--session-id {id}", "resume": "--resume {id}", "id": "uuid" }
    },
    {
      "name": "copilot",
      "program": "copilot",
      "yolo": "--allow-all",
      "session": { "start": "--session-id={id}", "resume": "--resume={id}", "id": "uuid" }
    },
    {
      "name": "cursor",
      "program": "cursor-agent",
      "yolo": "--force",
      "session": { "create": "cursor-agent create-chat", "resume": "--resume {id}" }
    },
    {
      "name": "opencode",
      "program": "opencode",
      "yolo": "--auto",
      "session": { "start": "--session {id}", "resume": "--session {id}", "id": "ses_hex" }
    }
  ]
}'

# The agents as one line each, name|command|args|yolo|start|resume|idform|create|naming,
# default first.
# A bar, not a tab: tab is whitespace to `read`, which would merge the empty fields most
# agents have. jq does the JSON, because sed on hand-edited JSON is how a stray space in
# someone's config becomes a silent wrong answer. An agent with no usable name or program
# is skipped with a warning rather than failing the lot.
load_agents() {
  command -v jq >/dev/null 2>&1 || {
    echo "trails: needs jq to read its agents — brew install jq (or apt install jq)" >&2
    return 1
  }
  if [ -f "$CONFIG" ]; then
    json=$(cat "$CONFIG") || return 1
    src=$CONFIG
  else
    json=$DEFAULT_CONFIG
    src="the built-in agents"
  fi
  printf '%s' "$json" | jq -e '.agents | type == "array"' >/dev/null 2>&1 || {
    echo "trails: $src has no \"agents\": [ ... ] list — see trails help, or move it aside to use the built-ins" >&2
    return 1
  }
  out=$(printf '%s' "$json" | jq -r '
    def words: split(" ") | map(select(. != ""));
    (.default_agent // "") as $d
    | [.agents[]? | if type == "object" then . else { bad: tostring } end]
    | (map(select(.name == $d)) + map(select(.name != $d)))[]
    | if has("bad") or (.name | type) != "string" or (.name | test("^[A-Za-z0-9._-]+$") | not)
         or (.program | type) != "string" or ((.program | words | length) == 0)
      then "!" + (.name // .bad // "(no name)" | tostring)
      else (.session | if type == "object" then . else {} end) as $s
      | [.name, (.program | words | .[0]), (.program | words | .[1:] | join(" ")),
            (.yolo | if type == "string" then . else "" end), ($s.start // ""), ($s.resume // ""),
            ($s.id // ""), ($s.create // ""), ($s.name // "")]
           | map(tostring | gsub("\\|"; "")) | join("|")
      end' 2>&1) || {
    echo "trails: can't read $src: $out" >&2
    return 1
  }
  # The first agent by a name is the one that runs, so a second by that name is skipped and
  # said so, not shown as a row that starts the first.
  printf '%s\n' "$out" | awk -F'|' -v src="$src" '
    /^!/ { printf "trails: skipping agent \047%s\047 in %s — it needs a name (letters, digits, . _ -) and a program\n", substr($0, 2), src > "/dev/stderr"; next }
    $1 in seen { printf "trails: skipping a second agent named \047%s\047 in %s\n", $1, src > "/dev/stderr"; next }
    NF { seen[$1] = 1; print }'
}

agent_row() {
  printf '%s\n' "$AGENTS" | awk -F'|' -v n="$1" '$1 == n { print; exit }'
}

# The config's mode, as "default" or "yolo". Anything else is a typo, and a typo must not
# decide to run every agent unconfirmed, so it reads as default with a warning.
load_mode() {
  if [ -f "$CONFIG" ]; then
    m=$(jq -r '.mode // "default"' "$CONFIG" 2>/dev/null) || m=default
  else
    m=$(printf '%s' "$DEFAULT_CONFIG" | jq -r '.mode // "default"')
  fi
  case $m in
    default | yolo) printf '%s' "$m" ;;
    *)
      echo "trails: mode is \"$m\" in $CONFIG — it takes \"default\" or \"yolo\"; using default" >&2
      printf default
      ;;
  esac
}

# Can agent $1 pick a conversation back up? It has a session.resume.
resumable() { [ -n "$1" ] && [ -n "$(agent_row "$1" | awk -F'|' '{ print $6 }')" ]; }

# A session template with its ID filled in. A template written as a bare flag ("--resume")
# gets the ID appended, which is what that spelling can only mean.
with_id() {
  case $1 in
    *"{id}"*) printf '%s' "$1" | sed "s/{id}/$2/g" ;;
    *) printf '%s %s' "$1" "$2" ;;
  esac
}

# `trails config` — the agents file, created from the built-ins the first time so there is
# something to edit, then opened in $EDITOR when there is a terminal to open it in.
edit_config() {
  if [ ! -f "$CONFIG" ]; then
    command -v jq >/dev/null 2>&1 || {
      echo "trails: needs jq — brew install jq (or apt install jq)" >&2
      exit 1
    }
    mkdir -p "$(dirname "$CONFIG")" || exit 1
    printf '%s\n' "$DEFAULT_CONFIG" | jq . >"$CONFIG" || exit 1
    echo "trails: wrote the built-in agents to $CONFIG" >&2
  fi
  if [ -t 0 ] && [ -t 1 ] && [ -n "${VISUAL:-${EDITOR:-}}" ]; then
    exec ${VISUAL:-$EDITOR} "$CONFIG"
  fi
  printf '%s\n' "$CONFIG"
}

# ─── Workspaces ──────────────────────────────────────────────────────────────
# A workspace is a set of codebases you declare, related or not — one per company, say —
# that trails will keep together (docs/design/trails-1.0.md). Which codebases: paths or
# globs under "workspaces" in the config, with an optional root:
#
#   "workspaces": {
#     "lattiq":   { "root": "~/workspace/lattiq", "codebases": ["~/workspace/lattiq/*"] },
#     "personal": { "codebases": ["~/workspace/gunasekar/*", "~/.dotfiles"] }
#   }
#
# No "workspaces" key means one workspace, "default", holding everything. The config
# decides what is listed, never where a trail may run: a directory no entry claims has no
# workspace until `trails ws add` gives it one. trails never infers a workspace from how
# the directories are laid out — the globs are the user's to write.

# The workspaces as one line per codebase entry, name|root|pattern, ~ expanded. A workspace
# with no codebases gets one line with an empty pattern, so it still lists. Empty with no
# "workspaces" key. A bare list is taken as the codebases. A name is letters, digits, - and
# _: it becomes a tmux session name, and "/" is kept for the sessions; anything else is
# skipped with a warning rather than failing the lot.
load_workspaces() {
  [ -f "$CONFIG" ] || return 0
  jq -r --arg home "$HOME" '
    def tilde: if type != "string" then empty
      elif startswith("~/") then $home + .[1:] elif . == "~" then $home else . end;
    (.workspaces // {}) | if type != "object" then {} else . end | to_entries[]
    | .key as $n
    | (if (.value | type) == "array" then { codebases: .value } elif (.value | type) == "string" then { codebases: [.value] }
       elif (.value | type) == "object" then .value else {} end) as $w
    | if ($n | test("^[A-Za-z0-9_-]+$") | not) then "!" + $n
      else (($w.root // "") | if type == "string" then tilde else "" end) as $r
        | ([$w.codebases[]? | tilde | rtrimstr("/")] | if length == 0 then [""] else . end)[]
        | [$n, $r, .] | join("|")
      end' "$CONFIG" 2>/dev/null | while IFS= read -r line; do
    case $line in
      "!"*) echo "trails: skipping workspace \"${line#!}\" — a name is letters, digits, - and _" >&2 ;;
      *) printf '%s\n' "$line" ;;
    esac
  done
}

# The directories a workspace entry may claim $1 by, one per line: itself, the repository
# it is inside, and that repository's main checkout when it is a worktree. So a directory
# inside a listed repo, or a worktree of one wherever it lives (../augur-retry-budget,
# .claude/worktrees/), goes where the repo goes without being listed. Physical paths
# throughout: the config's globs are matched against what `pwd -P` would say.
workspace_candidates() {
  d=$(cd "$1" 2>/dev/null && pwd -P) || return 1
  # The path as reached first, when a link makes it differ: a link inside a workspace
  # directory is that workspace's, wherever it points.
  l=$(cd "$1" 2>/dev/null && pwd -L)
  [ "$l" = "$d" ] || printf '%s\n' "$l"
  printf '%s\n' "$d"
  command -v git >/dev/null 2>&1 || return 0
  top=$(git -C "$d" rev-parse --show-toplevel 2>/dev/null) || return 0
  [ "$top" = "$d" ] || printf '%s\n' "$top"
  common=$(git -C "$d" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
  main=${common%/.git}
  [ "$main" = "$common" ] || [ "$main" = "$top" ] || printf '%s\n' "$main"
}

# The workspace directory $1 belongs to, by the config. The most specific entry wins: an
# exact path over a glob, and a longer glob over a shorter one — so "~/work/lattiq/*" and
# "~/work/lattiq/special" both claiming special give it to the second. A glob's * crosses
# "/", as case's does, so a listed repo's subdirectories match it too, and a plain path claims
# the folders inside it the same way (D6 in docs/design/picker-consolidation.md). The candidates are
# tried in order, nearest first, and the first that any entry claims decides.
#
# "default" with no workspaces configured. Nothing, and status 1, when some are and none
# claims the directory: the caller's cue to ask which it should join.
workspace_of() {
  [ -n "$WORKSPACES" ] || {
    printf 'default\n'
    return 0
  }
  workspace_candidates "$1" | while IFS= read -r d; do
    best=; score=-1
    while IFS='|' read -r n _ p; do
      [ -n "$p" ] || continue
      # shellcheck disable=SC2254 # a case pattern is the point
      case $d in
        $p) ;;
        "$p"/*) ;;
        *) continue ;;
      esac
      # An exact path is the most specific; a folder inside a listed path ranks like a glob,
      # by length, so the nearest entry claims it, and the listed path wins a tie with a glob
      # as long, being the narrower of the two.
      case $p in
        *[\*\?\[]*) s=$((2 * ${#p})) ;;
        "$d") s=$((200000 + ${#p})) ;;
        *) s=$((2 * ${#p} + 1)) ;;
      esac
      [ "$s" -gt "$score" ] && best=$n score=$s
    done <<EOF
$WORKSPACES
EOF
    [ -n "$best" ] || continue
    printf '%s\n' "$best"
    break
  done | head -n 1 | grep .
}

# A workspace name a session and a config key can both carry.
check_ws_name() {
  case $1 in
    '' | *[!A-Za-z0-9_-]*)
      echo "trails: a workspace name is letters, digits, - and _ (got '$1')" >&2
      return 1
      ;;
    # `trails ws` commands, which `trails ws NAME` could never reach.
    list | of | add | next | prev)
      echo "trails: '$1' can't name a workspace: it is trails ws $1" >&2
      return 1
      ;;
    *) ;;
  esac
}

# $1 as the config would list it: ~-relative under $HOME, so the file reads the same on
# another machine with the same layout.
tilde_path() {
  case $1 in
    "$HOME") printf '~' ;;
    "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# trails ws list — the workspaces. Piped, TSV: name, root (- for none), and the codebase
# entries joined by ", ", the config's own spelling. On a terminal, a table with one entry
# per line under its workspace, what each glob matches today (a listed path that is not
# there says so), and the root as a dim note where one is set:
#
#   lattiq    ~/workspace/lattiq/*     53 codebases   root ~/workspace/lattiq
#   personal  ~/workspace/gunasekar/*  10 codebases
#             ~/.dotfiles
ws_list() {
  [ -n "$WORKSPACES" ] || {
    echo "trails: no workspaces in $CONFIG — everything is in \"default\" (trails ws add NAME puts this directory in one)" >&2
    return 0
  }
  [ -t 1 ] || {
    printf '%s\n' "$WORKSPACES" | awk -F'|' -v home="$HOME" '
      function tilde(p) { if (p == home) return "~"; if (index(p, home "/") == 1) return "~" substr(p, length(home) + 1); return p }
      {
        if (!($1 in seen)) { seen[$1] = 1; order[++n] = $1; root[$1] = $2 == "" ? "-" : tilde($2) }
        # Two statements: mawk makes pats[$1] exist before it evaluates the right-hand side
        # of an assignment to it, so an `in` test there is always true.
        if ($3 != "" && ($1 in pats)) pats[$1] = pats[$1] ", " tilde($3)
        else if ($3 != "") pats[$1] = tilde($3)
      }
      END { for (i = 1; i <= n; i++) { w = order[i]; printf "%s\t%s\t%s\n", w, root[w], pats[w] } }'
    return 0
  }
  last=
  printf '%s\n' "$WORKSPACES" | while IFS='|' read -r n r p; do
    name='' note=''
    if [ "$n" != "$last" ]; then
      name=$n
      [ -z "$r" ] || note="root $(tilde_path "$r")"
      last=$n
    fi
    entry='' count=''
    if [ -n "$p" ]; then
      entry=$(tilde_path "$p")
      case $p in
        *[\*\?\[]*)
          # Expanded, never split: a path with a space is one path.
          wl_ifs=$IFS
          IFS='
'
          # shellcheck disable=SC2086 # the glob is the point
          set -- $p
          IFS=$wl_ifs
          c=0
          for d; do [ -d "$d" ] && c=$((c + 1)); done
          count="$c codebase$([ "$c" -eq 1 ] || echo s)"
          ;;
        *) [ -d "$p" ] || count="not there" ;;
      esac
    fi
    printf '%s\t%s\t%s\t%s\n' "$name" "$entry" "$count" "$note"
  done | awk -F"$TAB" -v dim="$DIM" -v rst="$RST" '
    { n++; a[n] = $1; b[n] = $2; c[n] = $3; d[n] = $4
      if (length($1) > wa) wa = length($1); if (length($2) > wb) wb = length($2); if (length($3) > wc) wc = length($3) }
    END {
      for (i = 1; i <= n; i++) {
        line = sprintf("%-*s  %-*s", wa, a[i], wb, b[i])
        if (wc) line = line "  " (c[i] != "" ? dim sprintf("%-*s", wc, c[i]) rst : sprintf("%-*s", wc, ""))
        if (d[i] != "") line = line "   " dim d[i] rst
        sub(/ +$/, "", line)
        print line
      }
    }'
}

# trails ws of [DIR] — the workspace DIR (here) belongs to, or why none does.
ws_of() {
  d=${1:-$PWD}
  [ -d "$d" ] || {
    echo "trails: no such directory: $d" >&2
    return 1
  }
  workspace_of "$d" && return 0
  echo "trails: no workspace claims $(tilde_path "$(cd "$d" && pwd -P)") — trails ws add NAME to put it in one" >&2
  return 1
}

# trails ws add NAME [DIR] — put DIR (here) in workspace NAME, in the config, creating the
# workspace if it is new and the config from the built-ins if there is none. Written through
# jq and a temp file: the file is the user's, and a half-written one is worse than none.
ws_add() {
  check_ws_name "${1:-}" || return 1
  d=${2:-$PWD}
  d=$(cd "$d" 2>/dev/null && pwd -P) || {
    echo "trails: no such directory: ${2:-$PWD}" >&2
    return 1
  }
  [ "$d" != / ] || {
    echo "trails: / can't be a codebase" >&2
    return 1
  }
  # As the config lists it: ~-relative, its glob characters escaped, since an entry is a
  # pattern and a folder named a[1] should claim itself, not a1.
  entry=$(tilde_path "$d" | sed 's/[][*?\\]/\\&/g')
  if [ ! -f "$CONFIG" ]; then
    mkdir -p "$(dirname "$CONFIG")" || return 1
    printf '%s\n' "$DEFAULT_CONFIG" | jq . >"$CONFIG" || return 1
    echo "trails: wrote the built-in agents to $CONFIG" >&2
  fi
  if jq -e --arg n "$1" --arg e "$entry" '
      (.workspaces // {})[$n] | (if type == "array" then . elif type == "string" then [.] else (.codebases // []) end) | index($e) != null
    ' "$CONFIG" >/dev/null 2>&1; then
    echo "trails: $entry is already in $1" >&2
    return 0
  fi
  jq --arg n "$1" --arg e "$entry" '
      .workspaces = (.workspaces // {})
      | .workspaces[$n] = (.workspaces[$n] | if type == "array" then { codebases: . } elif type == "string" then { codebases: [.] } elif type == "object" then . else {} end)
      | .workspaces[$n].codebases = ((.workspaces[$n].codebases // []) + [$e])
    ' "$CONFIG" >"$CONFIG.tmp" && [ -s "$CONFIG.tmp" ] && cat "$CONFIG.tmp" >"$CONFIG" && rm -f "$CONFIG.tmp" || {
    # Copied over, not moved into place: a config that is a link into dotfiles stays one, and
    # keeps its mode.
    rm -f "$CONFIG.tmp"
    echo "trails: could not write $CONFIG" >&2
    return 1
  }
  echo "added $entry to $1"
}

ws_cmd() {
  case ${1:-} in
    '') ws_list ;;
    of) ws_of "${2:-}" ;;
    add) ws_add "${2:-}" "${3:-}" ;;
    *)
      echo "trails: ws takes nothing, 'of [DIR]' or 'add NAME [DIR]' (try: trails help)" >&2
      return 1
      ;;
  esac
}

# The flag that turns on an agent's YOLO (run-everything-unconfirmed) mode, empty for an agent
# that has none. toggle_yolo and launch both ask through here, so "which agents can be armed"
# has a single answer and a session name (an attach row) simply misses.
yolo_flag() {
  agent_row "$1" | awk -F'|' '{ print $4 }'
}

# Only offer an agent whose command actually exists here.
available_agents() {
  printf '%s\n' "$AGENTS" | while IFS='|' read -r name cmd _; do
    command -v "$cmd" >/dev/null 2>&1 && printf '%s\n' "$name"
  done
}

# ─── Trails ──────────────────────────────────────────────────────────────────
# A trail is one agent in one codebase. It is a session of its own, named
# <workspace>/<codebase>[-N] or <workspace>/<name>, holding one window with the agent in it
# and nothing else: what an editor attaches to. Its workspace — a session named after the
# workspace, marked @trails_workspace — shows it through a window of its own: the trail's
# window, named like the agent's, whose first pane is a nested tmux client attached to the
# trail's session, the way a map pane shows an agent (ensure_window). The editor and a shell
# go beside the agent as panes of that window (tool), which the trail's session, and so an
# editor's panel, never sees. docs/design/trails-1.0.md has the model and the reasons; ADR 16
# the move of the agent from the workspace's window into its own session.
#
# Two windows, then: the agent's, in the trail's session (agent_wid), and the trail's, in the
# workspace (window_of). The agent's carries what trails knows about the trail, as window
# options, so nothing has to be parsed back out of a name:
#   @agent         the agent picked, with " (YOLO)" when it was armed
#   @trails_id     its conversation, the one its record holds
#   @trails_dir    the directory it runs in, verbatim from $PWD at launch
#   @trails_ws     its workspace: the session it was made in
#   @trails_session  its session's name, which is also its record's key
#   @trails_label  the codebase label its windows and session are named from
#   @trails_name   the name you gave it, if any
#   @trails_program  its agent's command, by name: which hooks speak for it (trails state)
#   @trails_since  when it started, Unix time
#
# The trail's window carries @trails_window (the trail's key) with @trails_dir, @trails_ws and
# @trails_label, and each of its panes @trails_pane: agent, editor or shell (window_layout says
# where each goes).

# tmux forbids '.' and ':' in names (both are target separators), and spaces make `tmux a -t
# <name>` a quoting chore. A codebase's label is its directory's basename with those swapped
# out; a git worktree is labelled <repo>@<branch>, so two checkouts of one repo read apart.
label_of() { basename "$1" | tr ':. /' '____'; }
codebase_label() {
  cl_dir=$(cd "$1" 2>/dev/null && pwd -P) || cl_dir=$1
  if command -v git >/dev/null 2>&1 &&
    [ "$(git -C "$cl_dir" rev-parse --show-toplevel 2>/dev/null)" = "$cl_dir" ]; then
    common=$(git -C "$cl_dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
    main=${common%/.git}
    if [ -n "$common" ] && [ "$main" != "$common" ] && [ "$main" != "$cl_dir" ]; then
      br=$(git -C "$cl_dir" branch --show-current 2>/dev/null)
      printf '%s@%s' "$(label_of "$main")" "$(printf '%s' "${br:-detached}" | tr ':. /' '____')"
      return 0
    fi
  fi
  label_of "$1"
}

# A trail's badge in the picker and `trails ls`: #<name> for one you named, #N for the Nth
# unnamed trail of its codebase, - for the first. $1 is its key, its session's name, $2 its
# codebase label, $3 its name if any. A trail you named is the one case where
# the badge is the name to call it by — `tmux a -t lattiq/payments`.
trail_badge() {
  [ -n "$3" ] && {
    printf '#%s' "$3"
    return 0
  }
  tb=${1#*/}
  rest=${tb#"$2"-}
  if [ "$tb" = "$2" ]; then
    printf -- -
  elif [ "$rest" != "$tb" ] && [ -n "$rest" ] && [ "$rest" = "${rest%%[!0-9]*}" ]; then
    printf '#%s' "$rest"
  else
    printf '#%s' "$tb"
  fi
}

# Three things read off a trail's window, by id.
trail_dir() { tmux display-message -pt "$1" '#{@trails_dir}' 2>/dev/null; }
trail_key() { tmux display-message -pt "$1" '#{@trails_session}' 2>/dev/null; }
trail_ws() { tmux display-message -pt "$1" '#{?@trails_ws,#{@trails_ws},-}' 2>/dev/null; }

# The window a key names: the one marked with it as its session.
agent_wid() {
  case $1 in
    */*) tmux list-windows -a -F "#{@trails_session}$TAB#{window_id}" 2>/dev/null |
      awk -F"$TAB" -v k="$1" '$1 == k { print $2; exit }' ;;
    *) ;;
  esac
}

# A trail's key as a command takes it: <workspace>/<name>, and nothing that could step out
# of the records' directory (.., a leading or trailing /).
key_ok() {
  case $1 in
    '' | /* | */ | *..* | *//*) ;;
    */*) return 0 ;;
    *) ;;
  esac
  echo "trails: no trail $1 — a trail's key is WORKSPACE/NAME, as trails ls prints it" >&2
  return 1
}

# The agent runs in tmux wherever there is one, inside tmux too: it gets a window in its
# workspace like anywhere else, and the client you are in is switched to it.
# Without tmux the agent runs bare, and nothing in this file applies.
# A bare environment, a terminal tab another app opened or a launchd job, can have the
# system's PATH alone, without the tmux, fzf and jq trails runs on, and then a running trail
# read as gone. They are where trails was installed from (Homebrew's bin), or in a Homebrew
# prefix: those go on the end of PATH, after anything the caller chose.
if ! command -v tmux >/dev/null 2>&1; then
  for p in "$(cd "$(dirname "$0")" 2>/dev/null && pwd)" /opt/homebrew/bin /usr/local/bin /home/linuxbrew/.linuxbrew/bin; do
    [ -d "$p" ] || continue
    case ":$PATH:" in
      *":$p:"*) ;;
      *) PATH=$PATH:$p ;;
    esac
  done
  export PATH
fi
USE_TMUX=
command -v tmux >/dev/null 2>&1 && USE_TMUX=1

# The client this run acts for, read before anything else is made. A switch-client with no
# -c acts on tmux's idea of the current client, which is the most recently active one — and
# by the time trails switches, that can be a nested client it has just started (a trail's
# window, a map pane), which then gets switched instead of you; with two terminals on one
# workspace it can be the other terminal. So, in order: TRAILS_CLIENT, which the run-shell
# bindings `trails keys` prints pass as #{client_name}, the client that pressed the key;
# from a shell in a pane, the client showing that pane (TMUX_PANE), the most recently
# active when several do; else tmux's guess, which from inside a popup is the client that
# opened it, display-popup expanding no formats to say so.
#
# And never a nested client. The one in a trail's window, or a map pane, is a client of this
# same server whose terminal is a pane of it; a key pressed there (the double prefix reaches
# it) names it as the client that asked, and switching *it* to the workspace would put the
# workspace inside its own window, showing itself. The terminal that shows that pane is the
# one you are at, so the client is followed outward (client_outer) until it is a real one.
client_outer() {
  co=$1 co_n=0
  while [ -n "$co" ] && [ "$co_n" -lt 4 ]; do
    co_win=$(tmux list-panes -a -F '#{pane_tty} #{window_id} #{session_name}' 2>/dev/null | awk -v t="$co" '$1 == t { print $2 " " $3; exit }')
    [ -n "$co_win" ] || break
    co_next=$(tmux list-clients -F '#{client_activity} #{client_name} #{window_id} #{session_name}' 2>/dev/null |
      awk -v w="${co_win% *}" -v s="${co_win#* }" '$3 == w { print "1 " $0; next } $4 == s { print "0 " $0 }' |
      sort -k1,1rn -k2,2rn | head -n 1 | cut -d' ' -f3)
    [ -n "$co_next" ] || break
    co=$co_next co_n=$((co_n + 1))
  done
  printf '%s' "$co"
}
# A TMUX_PANE without TMUX is another server's pane, left behind by an `unset TMUX` to get out
# of it. Kept, it would go into the environment of any server trails starts from here, and
# every run-shell binding and popup there would read it as the pane it was run in.
[ -n "${TMUX:-}" ] || unset TMUX_PANE
# And a key's run-shell job (TRAILS_CLIENT, which trails keys' bindings pass) runs in no
# pane: a TMUX_PANE it has came with the server's environment, from wherever the server
# was started, and taken for a pane it would show a popup's content in the job's output,
# which nobody sees.
[ -z "${TRAILS_CLIENT:-}" ] || unset TMUX_PANE
# Not for what runs in no terminal and shows nothing: the status line's checklist count, on
# every redraw, the list's own reloads and item pane, the hooks' --said, the wrapper's --forget.
CLIENT=${TRAILS_CLIENT:-}
case "${1:-} ${2:-}" in
  "checklist --count" | "checklist --rows" | "checklist --toggle" | "checklist --text" | "--said "* | "--forget "*) LIGHT=1 ;;
  *) LIGHT= ;;
esac
if [ -z "$CLIENT" ] && [ -n "$TMUX" ] && [ -z "$LIGHT" ]; then
  [ -z "${TMUX_PANE:-}" ] || CLIENT=$(tmux list-clients -F '#{client_activity} #{client_name} #{pane_id}' 2>/dev/null |
    awk -v p="$TMUX_PANE" '$3 == p' | sort -rn | head -n 1 | cut -d' ' -f2)
  [ -n "$CLIENT" ] || CLIENT=$(tmux display-message -p '#{client_name}' 2>/dev/null)
fi
[ -z "$CLIENT" ] || CLIENT=$(client_outer "$CLIENT")
# A client on a session grouped with the target's (`tmux new-session -t personal`, a second
# terminal on one workspace) stays on its own session: a group shares its windows, so the same
# window is selected there, and the client keeps a current window of its own rather than
# joining the one the target's clients share. Any other client, or a failed lookup, switches
# to the target as asked.
switch_to() {
  st=$1
  if [ -n "$CLIENT" ]; then
    st_ws=${st#=}
    st_ws=${st_ws%%:*}
    st_own=$(tmux display-message -p -t "$CLIENT" "#{session_name}${US}#{session_group}" 2>/dev/null)
    st_grp=$(tmux display-message -p -t "=$st_ws:" '#{session_group}' 2>/dev/null)
    if [ -n "$st_own" ] && [ "${st_own%%"$US"*}" != "$st_ws" ] && [ -n "$st_grp" ] && [ "${st_own#*"$US"}" = "$st_grp" ]; then
      case $st in
        *:*) st="=${st_own%%"$US"*}:${st#*:}" ;;
        *) st="=${st_own%%"$US"*}" ;;
      esac
    fi
  fi
  exec tmux switch-client ${CLIENT:+-c "$CLIENT"} -t "$st"
}

# The workspace the client's session is: its @trails_workspace, or, on a session grouped with
# one, the group's. tmux copies no session options into a grouped session, and a group is
# named after the session it was made from, so the mark is read from that one. Empty when
# neither has it.
client_ws() {
  cw=$(tmux display-message -p ${CLIENT:+-t "$CLIENT"} "#{@trails_workspace}${US}#{session_group}" 2>/dev/null) || return 1
  cw_ws=${cw%%"$US"*}
  cw_grp=${cw#*"$US"}
  [ -n "$cw_ws" ] || [ -z "$cw_grp" ] ||
    cw_ws=$(tmux display-message -p -t "=$cw_grp:" '#{@trails_workspace}' 2>/dev/null)
  printf '%s' "$cw_ws"
}

# Where a picked trail is shown: its workspace, with its window selected, or its editor
# session alone. An editor's terminal — nvim's panel, Zed's, VS Code's — should see one trail
# and nothing to wander off to; a terminal of your own should see the workspace. nvim sets
# NVIM in its terminals, Zed sets ZED_TERM, and both Zed and VS Code set TERM_PROGRAM,
# which tmux overwrites with its own inside a pane, so there only the editors' own variables
# tell. TRAILS_ATTACH=session (or view, its old name) or =workspace settles it by hand.
from_editor() {
  case ${TRAILS_ATTACH:-} in
    view | session) return 0 ;;
    workspace) return 1 ;;
    *) ;;
  esac
  if [ -n "${NVIM:-}" ] || [ -n "${ZED_TERM:-}" ]; then
    return 0
  fi
  case ${TERM_PROGRAM:-} in
    vscode | zed) return 0 ;;
    *) return 1 ;;
  esac
}

TAB=$(printf '\t')
# Between the fields of what tmux is asked for: a path or a session name can hold a | or a
# tab, and the shell reads a tab as whitespace, dropping empty fields. The unit separator is
# meant for this, and appears in no name.
US=$(printf '\037')

# tmux 3.4 and 3.5 print a control character in a format's output escaped, the unit separator
# as the four characters \037; 3.3 and 3.8 print the byte. So every tmux command whose
# arguments carry $US has its output put back to the byte, and keeps tmux's exit status. tmux
# escapes no backslash, so a \037 in that output can only be the separator. The x keeps a
# trailing newline that $(...) would strip.
tmux() {
  case $* in
    *"$US"*)
      tx_out=$(command tmux "$@" && printf x) || return
      printf '%s' "${tx_out%x}" | sed "s/\\\\037/$US/g"
      ;;
    *) command tmux "$@" ;;
  esac
}

# A locale, when the caller has none: launchd jobs (a cron, a tmux started at login) start
# with no LANG or LC_*, and a tmux client in the C locale rewrites every byte it cannot
# print as `_` on the way out: the separator between two fields of a format, the `·` in a
# window's name. The fields then never match, and a trail that `ls` lists is one restore
# cannot find, so it starts it again. Any UTF-8 locale the system has will do; nothing here
# depends on the language. Taken as `locale -a` spells it: glibc says C.utf8 where macOS
# says C.UTF-8.
if [ -z "${LANG:-}${LC_ALL:-}${LC_CTYPE:-}" ]; then
  for l in 'C\.UTF-?8' 'en_US\.UTF-?8' 'UTF-8'; do
    LC_CTYPE=$(locale -a 2>/dev/null | grep -ixE "$l" | head -n 1)
    [ -z "$LC_CTYPE" ] || {
      export LC_CTYPE
      break
    }
  done
fi

# Agents running here. ("Zed reconnected" and "give me a second agent" are
# indistinguishable from here, so show what's running and let you choose.)
#
# Three labels answering three questions:
#   @agent      what is running (claude, cursor, opencode). launch() wrote it down;
#               falls back to the process name for a session we did not start.
#   $TASK_FMT   what it's working on — the agent's own session name, published as the
#               terminal title (OSC 2) and exposed by tmux as pane_title. Claude Code
#               puts its /resume summary there.
#   status      whether it's working or wants you back — see classify below.
#
# TASK_FMT defends against two things: tmux seeds pane_title with the *hostname*, so
# "has a title" is not "is non-empty" (an unset pane reads back `airbochs`) — compared
# against #{host} and not #{host_short}, because that seed is gethostname() verbatim and
# the two differ wherever the box answers with an FQDN; and Claude Code prefixes an
# animated spinner glyph, so a leading glyph is stripped.
#
# "Glyph" has to be spelled out rather than taken as "whatever comes first". `^[^ ]+ `
# ate the first word of any title that had one — "Fixing the flaky test" displayed as
# "the flaky test", and a quoted opener lost the quote and the word inside it. Barring
# alphanumerics from the run confines it to decoration: every Claude title (✳, ⠂) still
# loses its glyph, and a title that opens with a plain word now survives whole, as one
# with no glyph and no space (opencode's "OpenCode") always did.
TASK_FMT='#{=45:#{?#{==:#{pane_title},#{host}},,#{s|^[^A-Za-z0-9 ]+ ||:pane_title}}}'

# The titles trails' sessions give the terminal they are shown in, set on each session as
# trails makes it (set-titles and set-titles-string are session options), so they hold on
# any tmux.conf and leave every other session's title to it.
#
# A trail's session: "claude · <task>", the agent and what it says it is working on, or its
# directory before it says anything (tmux seeds pane_title with the host name). The trail
# is shown in its workspace and in the map through a tmux client of this session, so this
# is that pane's title too: the map's borders are made from it (map).
TRAIL_TITLE='#{@agent} · #{?#{==:#{pane_title},#{host}},#{b:pane_current_path},#{s|^[^A-Za-z0-9 ]+ ||:pane_title}}'
# A workspace and the map: "trails · <host>". Which codebase is the status line's to say;
# which machine is what tells two terminals on trails apart.
WS_TITLE='trails · #{host_short}'

# ─── Is this agent working, or does it want you? ─────────────────────────────
# The question the picker exists to answer, and "wants you" is the only reason you
# opened it. tmux's session_attached is a fact about your terminal, not the agent —
# every session here reads "attached" whether mid-edit or sat on a finished turn.
#
# The agent says, through its hooks (ADR 18). Every agent worth running now runs a command
# when a turn starts, when it ends, and most when it wants permission; `trails state` is that
# command, and it marks the agent's pane with the word. The README has each agent's hooks.
# Setting them up is yours, as it is the agent's to call them: a hook knows the state, where
# anything trails could look at, the screen or the agent's own files, only suggests it
# (ADR 19). An agent nothing speaks for is unknown.
#
# classify()'s words:
#
#   working   busy
#   blocked   asking you something
#   idle      finished its turn, your move
#   unknown   nothing says
RED=$(printf '\033[31m')
YEL=$(printf '\033[33m')
DIM=$(printf '\033[2m')
RST=$(printf '\033[0m')

# Every trail on the box, TSV: window id, key, workspace, agent label, directory, codebase,
# badge, task. Unclassified and unfiltered — the picker keeps this directory's or this
# workspace's, `trails ls -a` the lot.
#
#   wid       the trail's window, in its session: what every tmux call below targets
#   key       its record's key and the name to attach to: its session
#   ws        its workspace
#   label     @agent — "claude", or "claude (YOLO)"
#   codebase  the codebase label its window is named from (augur, augur@retry)
#   badge     #name, #N, or -
#
# One list-windows for the lot. A trail's window is the one in its session, the session named
# by its key; its window in the workspace shows it but is not it, and has no @agent.
#
# Also the one place a trail's record learns what it is working on (rec_note_task): the task
# is only ever on screen, and a trail that dies takes its screen with it. This runs every
# time anything asks — the picker, `trails ls`, a script polling `trails ls -a` — so the
# record is as fresh as the last look, and a lost row can say what it was doing.
#
# The fields rec_note_id needs ride along, so the work per trail per poll is no tmux clients
# of its own. $US and not TAB between them: TAB is IFS whitespace, so `read` would merge an
# empty option into the next field. The task stays last, since it is free text.
sessions() {
  tmux list-windows -a -F \
    "#{window_id}${US}#{session_name}${US}#{@trails_ws}${US}#{@trails_session}${US}#{@agent}${US}#{@trails_id}${US}#{@trails_said_id}${US}#{@trails_dir}${US}#{@trails_label}${US}#{@trails_name}${US}$TASK_FMT" 2>/dev/null |
    while IFS="$US" read -r wid sname ws key label s_id said_id dir clabel cname task; do
      # A window of your own, or a trail's window in its workspace: not a trail.
      [ -n "$ws" ] && [ "$sname" = "$key" ] && [ -n "$label" ] || continue
      rec_note_task "$key" "$task"
      rec_note_id "$key" "$wid" "$label" "$s_id" "$said_id" "$dir"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$wid" "$key" "$ws" "$label" "$dir" "$clabel" \
        "$(trail_badge "$key" "$clabel" "$cname")" "$task"
    done
}

# stdin: sessions()' rows. stdout: the same with a state in front: its hooks' word, which
# `trails state` set as @trails_state on its pane, or unknown. One list-windows for the pass:
# a script polling `trails ls -a` runs this every few seconds.
classify() {
  rows=$(cat)
  [ -n "$rows" ] || return 0
  said=$(tmux list-windows -a -F "#{window_id}$TAB#{@trails_state}" 2>/dev/null)
  printf '%s\n' "$rows" | while IFS="$TAB" read -r wid key ws label dir cb badge task; do
    state=$(printf '%s\n' "$said" | awk -F"$TAB" -v n="$wid" '$1 == n { print $2; exit }')
    case $state in
      waiting) state=blocked ;;
      working | idle) ;;
      *) state=unknown ;;
    esac
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$state" "$wid" "$key" "$ws" "$label" "$dir" "$cb" "$badge" "$task"
  done
}

# ─── Session states ───────────────────────────────────────────────────────────
# Two questions, two signals. Is the tmux session there? The glyph says: ● running, ○ not.
# If it is, what is the agent doing; if it isn't, why not, and can it come back? The word
# says, in its colour. Every view — the picker, `trails ls`, their legends, the map — draws
# a state from this one table, so a state is named and drawn one way everywhere.
#
#   id|glyph|colour|word|legend, most-wants-you first (the order is the sort order)
#
# running:  needs you  the agent is asking you something (a permission prompt, a question)
#           your turn  it finished its turn and is waiting on you
#           unknown    nothing says: its hooks aren't set up
#           working    it is getting on with it
# stopped:  lost       tmux died under it (a reboot, a crash); `trails restore` brings it back
#           closed     it ended, and its conversation can be resumed
#
#   start/resume/restore ──▶ working ⇄ your turn ⇄ needs you ──(you quit)──▶ closed
#                                         └──────────(tmux dies)──────────▶ lost
STATES='needs-you|●|red|needs you|running, asking you something
your-turn|●|yellow|your turn|running, finished its turn
unknown|●|dim|unknown|running, no status: set up its hooks (https://github.com/gunasekar/trails#hooks-for-each-agent)
working|●|dim|working|running, busy
lost|○|plain|lost|not running: tmux died · trails restore brings it back
closed|○|dim|closed|not running: it ended · resume it from its directory'

# STATES on one line, `;` between states, for awk: macOS's awk refuses a -v value with a
# newline in it. No state's text has a `;`.
STATES_FLAT=$(printf '%s' "$STATES" | tr '\n' ';')

# classify()'s verdict (blocked, idle, unknown, working) → the state it is shown as.
state_of() {
  case $1 in
    blocked) echo needs-you ;;
    idle) echo your-turn ;;
    unknown) echo unknown ;;
    *) echo working ;;
  esac
}

# The awk that turns STATES into lookups: rank[], glyph[], word[], legend[] and paint[], the
# colour escape. Shared text rather than a function, because every caller is already in awk
# when it needs it, and a shell callout per row would be absurd.
STATES_AWK='
  BEGIN {
    ns = split(states, L, ";")
    for (i = 1; i <= ns; i++) {
      split(L[i], f, "|"); id = f[1]; order[i] = id; rank[id] = i
      glyph[id] = f[2]; word[id] = f[4]; legend[id] = f[5]
      paint[id] = f[3] == "red" ? red : (f[3] == "yellow" ? yel : (f[3] == "dim" ? dim : ""))
    }
  }
  function show(id) { return paint[id] glyph[id] " " sprintf("%-9s", word[id]) rst }
  function key(id) { return paint[id] glyph[id] " " sprintf("%-9s", word[id]) rst "  " legend[id] }
'

# rank and colour for the map, which draws in shell: sets $rank, $dot and $word. classify()
# state in, so the map need not translate first.
rank_dot() {
  case $1 in
    blocked) rank=0 dot=$RED word="needs you" ;;
    idle) rank=1 dot=$YEL word="your turn" ;;
    unknown) rank=2 dot=$DIM word=unknown ;;
    *) rank=3 dot=$DIM word=working ;;
  esac
}

# `trails ls` — this directory's trails: running, lost with tmux, or ended recently. The
# same rows the picker shows, as text: `ls` reads as "here", as plain ls does, and the picker
# already taught that trails means this directory. `trails ls -a` is every directory on the
# machine — "what did I leave where", and the TSV a script reads it as. See
# docs/decisions/0010.
#
# `trails ls DIR` is DIR's, the same list as if you had cd'd there and run `trails ls`.
#
# ls_rows DIR is the one list, TSV, in display order — DIR's trails, or with DIR empty every
# directory's. "Here" is the exact directory, as the picker has it, so `trails` and
# `trails ls` never disagree about what is here:
#
#   life  state  session  agent  yolo  dir  id  when  workspace  title
#
#   life       running (the trail is there) or stopped (it isn't)
#   state      a STATES id: needs-you, your-turn, unknown, working · lost, closed
#   session    what to attach to: the trail's session (lattiq/augur-2); - for a
#              trail that ended
#   yolo       yolo or -
#   when       when an ended trail ended (Unix time), - otherwise
#   workspace  the trail's workspace; for an ended one, the one its directory belongs to
#              now. Before title, so a reader that splits on tabs must name it to keep
#              title whole.
#
# Never an empty field mid-row, for recent_rows' reason, and the title last since it is free
# text. In STATES order, each state keeping its own: running trails most-wants-you first,
# ended ones newest first.
#
# One field more in front, the badge, for the table below, which list_sessions cuts off the
# piped TSV: a badge is drawn from the label and name, and the TSV carries neither.
#
# Each running row's conversation comes from one list-windows for the lot, not a tmux client
# per trail: a script may poll this every few seconds. Read after sessions() has run, because
# that pass is what moves @trails_id when the agent has changed conversations.
ls_rows() {
  live=$(sessions | classify)
  {
    meta=$(tmux list-windows -a -F "#{window_id}$TAB#{@trails_id}" 2>/dev/null)
    [ -n "$live" ] && printf '%s\n' "$live" | while IFS="$TAB" read -r state wid key ws label dir _cb badge task; do
      agent=${label%% *}
      yolo=-
      case $label in *"(YOLO)"*) yolo=yolo ;; *) ;; esac
      id=$(printf '%s\n' "$meta" | awk -F"$TAB" -v n="$wid" '$1 == n { print $2; exit }')
      printf '%s\trunning\t%s\t%s\t%s\t%s\t%s\t%s\t-\t%s\t%s\n' "$badge" \
        "$(state_of "$state")" "$key" "$agent" "$yolo" "${dir:--}" "${id:--}" "$ws" "${task:--}"
    done | awk -F"$TAB" -v states="$STATES_FLAT" "$STATES_AWK"'
      { n++; row[n] = $0; st[n] = $3 }
      END { for (r = 1; r <= ns; r++) for (i = 1; i <= n; i++) if (rank[st[i]] == r) print row[i] }'
    rec_dead | while read -r key; do
      yolo=$(rec_get "$key" yolo)
      ws=$(rec_get "$key" workspace)
      printf '%s\tstopped\tlost\t%s\t%s\t%s\t%s\t%s\t-\t%s\t%s\n' "$(rec_badge "$key")" "$key" \
        "$(rec_get "$key" agent)" "${yolo:--}" "$(rec_get "$key" dir)" "$(rec_get "$key" id)" \
        "${ws:--}" "$(t=$(rec_get "$key" task); printf '%s' "${t:--}")"
    done
  } | d=$1 awk -F"$TAB" 'ENVIRON["d"] == "" || $7 == ENVIRON["d"]'
  recent_rows "$1" | while IFS="$TAB" read -r m agent dir id yolo title; do
    ws=$(workspace_of "$dir") || ws=-
    printf -- '-\tstopped\tclosed\t-\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$agent" "$yolo" "$dir" "$id" "$m" "$ws" "${title:--}"
  done
}

# Two audiences, so two views: the TSV above for a notifier, and for a person one row per
# trail in columns — a tab jumps to the next 8-stop, so a TSV on screen is a ragged grid.
# `[ -t 1 ]` tells them apart with no flag: a caller's `$(...)` is a pipe.
#
#   #2       ● needs you  claude · yolo  lattiq    ~/code/api             Rework the retry budget
#            ● your turn  claude         personal  ~/.dotfiles            Fix the flaky test
#            ○ lost       claude · yolo  lattiq    ~/code/foundry         Improve observability
#            ○ closed     claude         lattiq    ~/notes      2h ago    Weekly review
#
# The badge column leads, the workspace column follows the agent, and either is left out when
# no row has one.
list_sessions() {
  [ $# -le 1 ] || {
    echo "trails: ls takes one directory, or -a for every one" >&2
    exit 1
  }
  case ${1:-} in
    '') scope=$PWD ;;
    -a | --all) scope= ;;
    -*)
      echo "trails: ls takes -a (every directory), a directory, or nothing (this one), not '$1'" >&2
      exit 1
      ;;
    # Spelled the way trails record it: launch() keeps $PWD, the logical path you cd'd by, so
    # `cd && pwd` and not pwd -P, which would resolve a symlink the record kept. A directory
    # that is gone can still have lost or ended trails, so it is made absolute by hand
    # rather than refused.
    *)
      if [ -d "$1" ]; then
        scope=$(cd "$1" && pwd) || exit 1
      else
        case $1 in
          /*) scope=$1 ;;
          *) scope=$PWD/$1 ;;
        esac
        while :; do
          case $scope in
            ?*/) scope=${scope%/} ;;
            *) break ;;
          esac
        done
      fi
      ;;
  esac
  rows=$(ls_rows "$scope")
  [ -t 1 ] || {
    [ -z "$rows" ] || printf '%s\n' "$rows" | cut -f2-
    return 0
  }
  [ -n "$rows" ] || {
    if [ -n "$scope" ]; then
      where=here
      [ "$scope" = "$PWD" ] || where="in $scope"
      echo "trails: no trails $where, and none ended in the last $RECENT_DAYS days — trails ls -a for every directory"
    else
      echo "trails: no trails, and none ended in the last $RECENT_DAYS days"
    fi
    return 0
  }

  # Widths off the widest window, the agent column measured on an ASCII stand-in: awk counts
  # bytes, and the · in "claude · yolo" is two of them. A dim legend follows for the states
  # this listing used, in table order — reference, not news.
  printf '%s\n' "$rows" | awk -F"$TAB" -v now="$(date +%s)" -v home="$HOME" \
    -v states="$STATES_FLAT" -v red="$RED" -v yel="$YEL" -v dim="$DIM" -v rst="$RST" "$STATES_AWK"'
    function ago(t,   d) {
      d = now - t
      if (d < 3600) return int(d / 60) "m ago"
      if (d < 86400) return int(d / 3600) "h ago"
      return int(d / 86400) "d ago"
    }
    {
      n++; badge = $1; st[n] = $3; dir = $7; ws = $10; ti[n] = $11
      if (ti[n] == "-") ti[n] = ""
      ag[n] = $5 ($6 == "yolo" ? " · yolo" : ""); aw[n] = length($5 ($6 == "yolo" ? " - yolo" : ""))
      if (badge == "-") badge = ""
      # A named trail shows its name as its title, which the badge already says.
      if (badge != "" && ti[n] == substr(badge, 2)) ti[n] = ""
      if (index(dir, home) == 1) dir = "~" substr(dir, length(home) + 1)
      c3[n] = dir; cb[n] = badge; cw[n] = ws == "-" ? "" : ws
      c4[n] = $9 != "-" ? ago($9) : ""
      if (aw[n] > w2) w2 = aw[n]
      if (length(c3[n]) > w3) w3 = length(c3[n])
      if (length(cb[n]) > wb) wb = length(cb[n])
      if (length(cw[n]) > ww) ww = length(cw[n])
      if (length(c4[n]) > w4) w4 = length(c4[n])
      seen[$3] = 1
    }
    END {
      for (i = 1; i <= n; i++) {
        line = wb ? sprintf("%-*s", wb, cb[i]) "  " : ""
        line = line show(st[i]) "  " ag[i] sprintf("%*s", w2 - aw[i], "")
        if (ww) line = line "  " sprintf("%-*s", ww, cw[i])
        line = line "  " sprintf("%-*s", w3, c3[i])
        if (w4) line = line "  " sprintf("%-*s", w4, c4[i])
        line = line "  " ti[i]
        sub(/ +$/, "", line)
        print line
      }
      first = 1
      for (k = 1; k <= ns; k++) {
        if (!(order[k] in seen)) continue
        if (first) { print ""; first = 0 }
        print dim glyph[order[k]] " " sprintf("%-9s", word[order[k]]) "  " legend[order[k]] rst
      }
    }'
}

# The running trails as the picker's raw rows (see print_menu for the shape): this
# directory's, with an argument that workspace's, or with --all every one, its codebase
# column then workspace/codebase. The key is worth hiding — on one
# codebase's screen `lattiq/augur` would repeat on every row — and what differs survives
# as a `#2` or `#name` badge; the window id is the target, what ctrl-x and the preview act on.
live_trails() {
  sessions | while IFS="$TAB" read -r wid key ws label dir cb badge task; do
    case ${1:-} in
      --all) cb=$ws/$cb ;;
      '') [ "$dir" = "$PWD" ] || continue ;;
      *) [ "$ws" = "$1" ] || continue ;;
    esac
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$wid" "$key" "$ws" "$label" "$dir" "$cb" "$badge" "$task"
  done | classify | while IFS="$TAB" read -r state wid _key _ws label dir cb badge task; do
    # launch() writes @agent as "claude (YOLO)" for an armed launch: the first word is the
    # agent, and the YOLO it ran with goes in its own field.
    agent=${label%% *}
    yolo=-
    case $label in *"(YOLO)"*) yolo=yolo ;; *) ;; esac
    # A named agent may show its name as its title, which the badge already says.
    [ "$task" != "${badge#\#}" ] || task=
    printf '%s\tattach\t%s\t%s\t%s\t%s\t%s\t%s\t-\t%s\n' \
      "$(state_of "$state")" "$wid" "$dir" "$cb" "$agent" "$yolo" "$badge" "$task"
  done
}

# The trail in workspace $1 that most wants you: its window id, from the picker's cache when
# there is one, else classified now. What attaching to a workspace lands on.
top_trail() {
  if [ -n "${TRAILS_MENU_CACHE:-}" ] && [ -s "$TRAILS_MENU_CACHE" ] && [ "${TRAILS_PICKER:-}" = ws ]; then
    rows=$(awk -F"$TAB" -v w="$1" '$4 == w' "$TRAILS_MENU_CACHE")
  else
    rows=$(sessions | awk -F"$TAB" -v w="$1" '$3 == w' | classify)
  fi
  printf '%s\n' "$rows" | most_wants 2
}

# stdin: classify()'s rows. Field $1 of the one that most wants you: the first asking you
# something, else the first whose turn it is, else the first.
most_wants() {
  awk -F"$TAB" -v c="$1" '
    $1 == "blocked" && !b { b = $c }
    $1 == "idle" && !i { i = $c }
    NR == 1 { f = $c }
    END { print b ? b : (i ? i : f) }'
}

# A record's workspace and codebase, for the picker's lost rows: what the record kept, else
# its key's workspace and its directory's label.
rec_ws() {
  rw=$(rec_get "$1" workspace)
  printf '%s' "${rw:-${1%%/*}}"
}
rec_codebase() {
  rc=$(rec_get "$1" label)
  [ -n "$rc" ] || rc=$(label_of "$(rec_get "$1" dir)")
  printf '%s' "$rc"
}

# Taken means running, or recorded: a trail that died with tmux keeps its session's name
# reserved until it is restored or forgotten. Otherwise a fresh agent started in that
# codebase after a reboot would land on the dead one's name and its new record would
# overwrite the old — the one pointer to the conversation you meant to come back to. $2 is a
# record key to disregard: a restore may keep its own old name.
session_taken() {
  tmux has-session -t "=$1" 2>/dev/null && return 0
  tmux list-windows -a -F '#{@trails_session}' 2>/dev/null | grep -qxF "$1" && return 0
  [ "$1" != "${2:-}" ] && [ -f "$(rec_path "$1")" ]
}

# The first free session name for an unnamed trail of codebase $2 in workspace $1: ws/label,
# then ws/label-2 and on.
next_session() {
  session_taken "$1/$2" "${3:-}" || {
    printf '%s/%s' "$1" "$2"
    return 0
  }
  n=2
  while session_taken "$1/$2-$n" "${3:-}"; do
    n=$((n + 1))
  done
  printf '%s/%s-%s' "$1" "$2" "$n"
}

# Is NAME, as a trail's name, in use: on a running trail's window, or a record (other than
# $2's). Names are checked box-wide, not per workspace, because an agent given the name
# (session.name) may take it as an address: two called payments would be one.
trail_name_taken() {
  tmux list-windows -a -F '#{@trails_name}' 2>/dev/null | grep -qxF -e "$1" && return 0
  [ -d "$STATE_DIR" ] || return 1
  grep -rlxF -e "name=$1" "$STATE_DIR" 2>/dev/null | grep -qv "^$(rec_path "${2:-//}")\$"
}

# ─── Picker internals (invoked by fzf, one process each) ─────────────────────
# These are subcommands rather than shell inline in the fzf flags: fzf single-quotes
# every placeholder and runs the result through $SHELL, where zsh expands a bare leading
# `=` to a command path — both traps silently ate the kill. As subcommands they're plain
# shell and directly testable: `trails --kill <name>`.

# ctrl-x: end the highlighted trail. Trails outlive the terminal that started them, so
# nothing else ever reaps them. The target is a running row's window id, and the trail's
# directory guards it: a "new  default" row would otherwise hand us the agent name.
#
# On a lost row it forgets the trail instead, for good: there is no process to kill, only the
# record that would bring one back, and only a lost row of this directory or workspace, as the
# directory guards a running one. (Its conversation stays in the agent's own history.) On a
# closed row it forgets the trail from trails' history.
#
# A kill is on purpose, so it closes the record too, into the history. The agent's wrapper
# would do that anyway were it allowed to finish, but killing the window hangs up on the
# wrapper along with the agent — which is exactly what keeps a record alive when tmux dies —
# so it never gets to. A trail's window goes alone, and its session, holding nothing else,
# goes with it.
kill_session() {
  ks_ws=
  case ${TRAILS_PICKER:-} in
    workspace*) ks_ws=$TRAILS_WS ;;
    all) ks_ws=--all ;;
    *) ;;
  esac
  if rec_is_dead "$1"; then
    if [ -n "$ks_ws" ]; then
      [ "$(rec_ws "$1")" = "$ks_ws" ] || return 0
    else
      [ "$(rec_get "$1" dir)" = "$PWD" ] || return 0
    fi
    rec_forget "$1"
    [ -z "${TRAILS_RECENT_CACHE:-}" ] || recent_cache >"$TRAILS_RECENT_CACHE"
    return 0
  fi
  case $1 in
    @*) ;;
    # A closed row: agent:id:dir. Its cache is rewritten, so the reload drops it.
    *:*:/*)
      ks_id=${1#*:}
      hist_forget "${ks_id%%:*}"
      [ -z "${TRAILS_RECENT_CACHE:-}" ] || recent_cache >"$TRAILS_RECENT_CACHE"
      return 0
      ;;
    *) return 0 ;;
  esac
  case $ks_ws in
    --all) ;; # every trail is on the all-trails screen
    '') [ "$(trail_dir "$1")" = "$PWD" ] || return 0 ;;
    *) [ "$(trail_ws "$1")" = "$ks_ws" ] || return 0 ;;
  esac
  # An editor or shell window goes as a window, and has no record.
  if [ -n "$(tmux display-message -pt "$1" '#{@trails_tool}' 2>/dev/null)" ]; then
    tmux kill-window -t "$1" 2>/dev/null
    return 0
  fi
  # The agent's window, then its session: the window takes the session with it when it is
  # the only one, and the session call ends anything else that was made in it.
  # Closed into the history first, while its pane can still say whether it was ever worked in.
  key=$(trail_key "$1")
  rec_close "$key" "$1"
  window_release "$key"
  tmux kill-window -t "$1" 2>/dev/null
  tmux kill-session -t "=$key" 2>/dev/null
  # Recompute the cached running block so the reload that follows drops the killed row (and
  # re-reads the survivors' state). Guarded on the cache path so a bare `trails --kill x` (no
  # picker, path unset) skips it. This is the one reload that classifies again, and it should:
  # a kill is rare and wants fresh state — unlike a Tab, which only relabels.
  [ -n "$TRAILS_MENU_CACHE" ] && live_trails $ks_ws >"$TRAILS_MENU_CACHE"
  # And the closed ones, which the ended trail just joined ("↩ resume old trails (N ended)").
  [ -z "${TRAILS_RECENT_CACHE:-}" ] || recent_cache >"$TRAILS_RECENT_CACHE"
}

# tab: flip the highlighted row from the config's mode — arm it for YOLO, or under "mode":
# "yolo" take a "+ new" row back to default mode — and flip it back on a second Tab. Exactly one
# agent can be armed at a time — arming a second replaces the first — so the state is a single
# name in a file, not a set. Only an agent with a YOLO flag can be armed; Tab on an attach row
# (a session name) or a flagless agent (pi, antigravity) finds no flag and is a no-op. A closed row
# arms too: its target is agent:id, and the flag is its agent's. The
# file is $TRAILS_YOLO_STATE, exported by the dispatch below and so inherited by this
# subprocess fzf spawns. print_menu reads the same file to relabel the row and set its verb.
toggle_yolo() {
  [ -n "$TRAILS_YOLO_STATE" ] || return 0
  [ -n "$(yolo_flag "${1%%:*}")" ] || return 0
  cur=
  [ -s "$TRAILS_YOLO_STATE" ] && cur=$(cat "$TRAILS_YOLO_STATE")
  if [ "$cur" = "$1" ]; then
    : >"$TRAILS_YOLO_STATE"
  else
    printf '%s' "$1" >"$TRAILS_YOLO_STATE"
  fi
}

# One "<agent> · new trail" row per agent in $agents, for print_menu. A row is YOLO when the
# config's mode says so or Tab flipped it ($armed), not both — and only if the agent has a
# flag at all. Then its verb is "yolo" and it says so in yellow.
agent_rows() {
  for a in $agents; do
    y=
    if [ "$MODE" = yolo ]; then
      [ "$a" = "$armed" ] || y=1
    else
      [ "$a" = "$armed" ] && y=1
    fi
    if [ -n "$y" ] && [ -n "$(yolo_flag "$a")" ]; then
      printf 'yolo\t%s\t%s · new trail  %s(YOLO)%s\n' "$a" "$a" "$YEL" "$RST"
    else
      printf 'new\t%s\t%s %s· new trail%s\n' "$a" "$a" "$DIM" "$RST"
    fi
  done
}

# The picker: one subcommand, six screens (ADR 17), chosen by TRAILS_PICKER (which the reload
# subprocesses inherit) and, for the workspace ones, TRAILS_WS:
#
#   ''             this codebase: "＋ new trail…", which leads to its agents; then its running
#                  and lost trails, then "↩ resume old trails" when there are ended
#                  conversations to resume
#   old            those ended trails (closed), reached from that last row
#   workspace      a workspace: "＋ new trail…", which picks a codebase and leads to its
#                  agents; then its trails across its codebases, with a codebase column;
#                  then "↩ resume old trails"
#   workspace-old  its ended conversations
#   agents         one "<agent> · new trail" row per agent, for the codebase picked
#   ws             the workspaces, with what runs in each (ws_menu)
#   all            every running trail, in every workspace, with a workspace/codebase column
#                  (prefix A, or ctrl-a from the screens above)
#
# Re-run by fzf after every Tab and ctrl-x, hence a subcommand.
#
# Every row is three tab-separated fields: verb, target, what's drawn. fzf draws only the
# third (--with-nth); the verb is what the dispatch matches on Enter, the target what Tab,
# ctrl-x and the preview act on. Trails are gathered first as raw rows —
#
#   state  verb  target  dir  codebase  agent  yolo  badge  when  title
#
# — then drawn together, so their columns line up across running and stopped alike.
print_menu() {
  [ "${TRAILS_PICKER:-}" = ws ] && {
    ws_menu
    return 0
  }
  agents=$(available_agents)
  [ -n "$agents" ] || {
    echo "trails: no agent CLIs found on PATH" >&2
    exit 1
  }
  in_ws='' all=''
  case ${TRAILS_PICKER:-} in
    workspace*) in_ws=$TRAILS_WS ;;
    all) all=1 ;;
    *) ;;
  esac

  # Running trails, from the cache the dispatch classified once. classify() reads every
  # trail's state, a few processes each, and this runs on every Tab and ctrl-x; the
  # snapshot is fixed for the picker's life anyway (fzf never live-refreshes it). Empty with
  # no tmux.
  running=
  [ -n "$TRAILS_MENU_CACHE" ] && [ -s "$TRAILS_MENU_CACHE" ] && running=$(cat "$TRAILS_MENU_CACHE")

  # The one row Tab flipped (toggle_yolo wrote it); empty if none.
  armed=
  [ -n "$TRAILS_YOLO_STATE" ] && [ -s "$TRAILS_YOLO_STATE" ] && armed=$(cat "$TRAILS_YOLO_STATE")

  [ "${TRAILS_PICKER:-}" = agents ] && {
    agent_rows
    return 0
  }

  # Lost: trails here — this codebase's, or this workspace's — that died with tmux. Read
  # fresh on every reload: a few small files, and ctrl-x on one has to see it gone.
  # TRAILS_RESTORE_OK is the dispatch's verdict, exported because this also runs as fzf's
  # reload subprocess.
  lost=
  if [ -n "$TRAILS_RESTORE_OK" ] && [ -z "$all" ]; then
    lost=$(rec_dead | while read -r key; do
      d=$(rec_get "$key" dir)
      if [ -n "$in_ws" ]; then
        [ "$(rec_ws "$key")" = "$in_ws" ] || continue
      else
        [ "$d" = "$PWD" ] || continue
      fi
      yolo=$(rec_get "$key" yolo)
      printf 'lost\trestore\t%s\t%s\t%s\t%s\t%s\t%s\t-\t%s\n' "$key" "$d" "$(rec_codebase "$key")" \
        "$(rec_get "$key" agent)" "${yolo:--}" "$(rec_badge "$key")" "$(rec_get "$key" task)"
    done)
  fi

  # Closed: trails that ended, from the history, through the dispatch's cache (read once,
  # not on every Tab). The target is agent:id:dir. One that last ran YOLO resumes YOLO, the way
  # a lost one comes back in its recorded mode, unless Tab flips it back to prompting; Tab arms
  # one that didn't ("armed" draws its yolo in yellow).
  recent=
  if [ -n "$TRAILS_RECENT_CACHE" ] && [ -s "$TRAILS_RECENT_CACHE" ]; then
    now=$(date +%s)
    recent=$(while IFS="$TAB" read -r m agent dir id yolo title; do
      cb=$(label_of "$dir")
      [ "$title" != - ] || title=
      verb=resume
      if [ "$agent:$id:$dir" = "$armed" ]; then
        # Tab flips the row from its last mode, both ways: a yolo one back to prompting,
        # anything else up to yolo.
        if [ "$yolo" = yolo ]; then
          yolo=-
        else
          verb=resume-yolo yolo=armed
        fi
      elif [ "$yolo" = yolo ]; then
        verb='resume-yolo'
      fi
      printf 'closed\t%s\t%s:%s:%s\t%s\t%s\t%s\t%s\t-\t%s\t%s\n' \
        "$verb" "$agent" "$id" "$dir" "$dir" "$cb" "$agent" "$yolo" "$(ago "$m" "$now")" "$title"
    done <"$TRAILS_RECENT_CACHE")
  fi

  # Editor and shell windows here, or in the workspace: read fresh, one list-windows, and ctrl-x on one
  # has to see it gone. Not in an editor's terminal, which wants trails and nothing else
  # (R9): picking an editor window there would put the whole workspace into the panel.
  comp=
  from_editor || [ -n "$all" ] || comp=$(tools $in_ws)

  # `$(...)` eats trailing newlines, so each block gets its own back or the last row of one
  # welds onto the first of the next.
  rows=$(
    [ -n "$running" ] && printf '%s\n' "$running"
    [ -n "$lost" ] && printf '%s\n' "$lost"
    [ -n "$comp" ] && printf '%s\n' "$comp"
    [ -n "$recent" ] && printf '%s\n' "$recent"
  )

  # Drawn in state order (the STATES table's), keeping each state's own order — closed ones
  # newest first — and all at once, so the columns line up across both groups below. Widths
  # off the widest window, the agent column measured on an ASCII stand-in: awk counts bytes, and
  # the · in "claude · yolo" is two of them. Each line comes out tagged M (main list: running
  # and lost, then the editor and shell windows, drawn with their kind where the state goes) or
  # O (old list: closed).
  drawn=
  [ -n "$rows" ] && drawn=$(printf '%s\n' "$rows" | awk -F"$TAB" -v OFS="$TAB" -v states="$STATES_FLAT" \
    -v red="$RED" -v yel="$YEL" -v dim="$DIM" -v rst="$RST" -v inws="$in_ws$all" "$STATES_AWK"'
    NF >= 10 {
      n++; st[n] = $1; vb[n] = $2; tg[n] = $3; cb[n] = $5; ag[n] = $6; yo[n] = $7; ti[n] = $10
      if ($1 == "tool") { comp[++nc] = n; if (length(cb[n]) > wc) wc = length(cb[n]); next }
      aw[n] = length($6 ($7 == "-" ? "" : " - yolo")); if (aw[n] > w2) w2 = aw[n]
      if (length(cb[n]) > wc) wc = length(cb[n])
      c3[n] = ($8 != "-" ? $8 : "") ($9 != "-" ? $9 : ""); if (length(c3[n]) > w3) w3 = length(c3[n])
    }
    END {
      for (r = 1; r <= ns; r++) for (i = 1; i <= n; i++) {
        if (rank[st[i]] != r) continue
        y = yo[i] == "yolo" ? " · yolo" : (yo[i] == "armed" ? " · " yel "yolo" rst : "")
        line = show(st[i])
        if (inws != "") line = line "  " sprintf("%-*s", wc, cb[i])
        line = line "  " ag[i] y sprintf("%*s", w2 - aw[i], "")
        if (w3) line = line "  " sprintf("%-*s", w3, c3[i])
        line = line "  " ti[i]
        sub(/ +$/, "", line)
        # By state name, never by glyph: macOS awk compares strings by locale collation,
        # which ranks ● and ○ equal.
        print (st[i] ~ /^(needs-you|your-turn|unknown|working|lost)$/ ? "M" : "O"), vb[i], tg[i], line
      }
      for (c = 1; c <= nc; c++) {
        i = comp[c]
        line = dim sprintf("%-11s", ag[i]) rst
        if (inws != "") line = line "  " sprintf("%-*s", wc, cb[i])
        line = line "  " dim ti[i] rst
        print "M", vb[i], tg[i], line
      }
    }')

  case ${TRAILS_PICKER:-} in
    old | workspace-old)
      printf '%s\n' "$drawn" | awk -F"$TAB" -v OFS="$TAB" '$1 == "O" { print $2, $3, $4 }'
      return 0
      ;;
    all)
      printf '%s\n' "$drawn" | awk -F"$TAB" -v OFS="$TAB" '$1 == "M" { print $2, $3, $4 }'
      return 0
      ;;
    *) ;;
  esac

  # The way to a new trail, first on both screens (D2 in docs/design/picker-consolidation.md):
  # a workspace's goes through its codebase tree (codebase_tree), a codebase's straight to
  # the agents screen.
  if [ -n "$in_ws" ]; then
    more=$(ws_codebase_count "$in_ws")
    printf 'browse\t-\t＋ new trail…  %s(%s)%s\n' "$DIM" \
      "$([ "$more" -eq 1 ] && echo "1 codebase" || echo "$more codebases")" "$RST"
  else
    printf 'agents\t-\t＋ new trail…\n'
  fi
  printf '%s\n' "$drawn" | awk -F"$TAB" -v OFS="$TAB" '$1 == "M" { print $2, $3, $4 }'
  # The way into the old list, with what's in it.
  old=$(printf '%s\n' "$drawn" | awk -F"$TAB" '$1 == "O" { n++ } END { print n + 0 }')
  [ "$old" -gt 0 ] && printf 'more\t-\t↩ resume old trails  %s(%s)%s\n' "$DIM" \
    "$([ "$old" -eq 1 ] && echo "1 ended" || echo "$old ended")" "$RST"
  return 0
}

# The workspace picker's rows: every workspace the config names, plus "default" when it has
# anything, plus any marked session the config no longer names — with what runs in each,
# counted off the dispatch's cache of every trail classified (sessions | classify). Sorted
# by what wants you, then by how much runs, then by name; the one you were in last (the
# workspace session most recently attached) is marked, and the dispatch lands the cursor
# on it.
#
#   workspace  NAME  <drawn>
ws_menu() {
  counts=
  [ -n "$TRAILS_MENU_CACHE" ] && [ -s "$TRAILS_MENU_CACHE" ] &&
    counts=$(awk -F"$TAB" '$4 != "-" { run[$4]++; if ($1 == "blocked") need[$4]++; if ($1 == "idle") turn[$4]++ }
      END { for (w in run) print w "\t" run[w] "\t" need[w] + 0 "\t" turn[w] + 0 }' "$TRAILS_MENU_CACHE")
  # A session grouped with a workspace's (a second terminal on it) counts as that workspace.
  last=$(tmux list-sessions -F "#{session_last_attached}$TAB#{@trails_workspace}$TAB#{session_group}" 2>/dev/null |
    awk -F"$TAB" '{ t[NR] = $1; w[NR] = $2; g[NR] = $3; if ($2 != "") isws[$2] = 1 }
      END {
        for (i = 1; i <= NR; i++) {
          n = w[i] != "" ? w[i] : (g[i] in isws ? g[i] : "")
          if (n != "" && t[i] + 0 > m + 0) { m = t[i]; best = n }
        }
        print best
      }')
  {
    printf '%s\n' "$WORKSPACES" | cut -d'|' -f1
    [ -n "$WORKSPACES" ] || echo default
    printf '%s\n' "$counts" | cut -f1
    rec_keys | while read -r k; do
      rec_ws "$k"
      echo
    done
    tmux list-sessions -F '#{@trails_workspace}' 2>/dev/null
  } | awk 'NF && $0 != "-" && !seen[$0]++' | while read -r w; do
    c=$(printf '%s\n' "$counts" | awk -F"$TAB" -v w="$w" '$1 == w { print $2 "\t" $3 "\t" $4; exit }')
    run=${c%%"$TAB"*} rest=${c#*"$TAB"} need=${rest%%"$TAB"*} turn=${rest#*"$TAB"}
    [ -n "$c" ] || run=0 need=0 turn=0
    if [ "$run" -gt 0 ]; then
      text="● $run trail$([ "$run" -eq 1 ] || echo s)"
      [ "$need" -gt 0 ] && text="$text · ${RED}$need need$([ "$need" -eq 1 ] && echo s) you$RST"
      [ "$turn" -gt 0 ] && text="$text · ${YEL}$turn your turn$RST"
    else
      text="${DIM}nothing running$RST"
    fi
    [ "$w" = "$last" ] && text="$text  ${DIM}· last$RST"
    printf '%s\t%s\t%s\tworkspace\t%s\t%-12s %s\n' "$need" "$run" "$w" "$w" "$w" "$text"
  done | sort -t "$TAB" -k1,1nr -k2,2nr -k3,3 | cut -f4-
}

# A workspace's root as the config has it, else $HOME: where "browse…" in its codebase tree
# starts walking.
ws_root() {
  r=$(printf '%s\n' "$WORKSPACES" | awk -F'|' -v n="$1" '$1 == n { print $2; exit }')
  printf '%s' "${r:-$HOME}"
}

# The codebases workspace $1 holds, as "kind|dir|parent" lines in config order (D5 in
# docs/design/picker-consolidation.md). An entry ending in "/*" is a workspace directory
# (wsdir), whose child folders are its codebases (child, with the workspace directory as
# parent); a plain path that is also a workspace directory makes that directory a codebase
# too (self); any other entry is single codebases, a glob expanded. Each directory once,
# the first entry that names it deciding how.
ws_codebases() {
  printf '%s\n' "$WORKSPACES" | awk -F'|' -v n="$1" '$1 == n && $3 != "" { print $3 }' | {
    pats=$(cat)
    wsdirs=$(printf '%s\n' "$pats" | sed -n 's|/\*$||p' | grep -v '[][*?]')
    # A glob is expanded, never split: a path with a space is one path.
    IFS='
'
    printf '%s\n' "$pats" | while IFS= read -r pat; do
      [ -n "$pat" ] || continue
      wd=
      case $pat in
        */\*) wd=${pat%/\*} ;;
        *) ;;
      esac
      case $wd in
        *[\*\?\[]*) wd= ;;
        *) ;;
      esac
      if [ -n "$wd" ]; then
        [ -d "$wd" ] || continue
        printf 'wsdir|%s|\n' "$wd"
        for c in "$wd"/*/; do
          c=${c%/}
          [ -d "$c" ] && printf 'child|%s|%s\n' "$c" "$wd"
        done
        continue
      fi
      if printf '%s\n' "$wsdirs" | grep -qxF "$pat"; then
        printf 'self|%s|\n' "$pat"
        continue
      fi
      # shellcheck disable=SC2086 # the glob is the point
      for d in $pat; do
        [ -d "$d" ] && printf 'single|%s|\n' "$d"
      done
    done
  } | awk -F'|' '$1 == "wsdir" || $1 == "self" { print; next } !seen[$2]++'
}

# What has happened in workspace $1's directories, as "dir<TAB>r" for each running trail and
# "dir<TAB>e" for each lost one or recent conversation: how the codebase tree ranks and
# labels them. No classifying, so no settle sleep: the tree only counts.
ws_activity() {
  [ -z "$USE_TMUX" ] || {
    tmux list-windows -a -F "#{session_name}$TAB#{@trails_dir}" 2>/dev/null |
      awk -F"$TAB" -v OFS="$TAB" -v w="$1/" 'index($1, w) == 1 && $2 != "" { print $2, "r" }'
    rec_dead | while read -r key; do
      [ "$(rec_ws "$key")" = "$1" ] && printf '%s\te\n' "$(rec_get "$key" dir)"
    done
  }
  recent_rows '' | cut -f3 | while IFS= read -r d; do
    [ -n "$d" ] && printf '%s\te\n' "$d"
  done
}

# The "New trail in:" rows for workspace $1, as "target<TAB>drawn": each workspace directory
# with its child folders under it, those with trails or recent history first, then the
# single codebases, then "browse…". A deeper folder with trails or history is listed under
# its workspace directory too (D6), so it needs browsing once. A workspace directory that is
# not a codebase itself, and "browse…", target "browse:DIR": walk from there.
codebase_tree() {
  ct_act=$(ws_activity "$1")
  ws_codebases "$1" | TRAILS_ACT=$ct_act awk -F'|' -v OFS="$TAB" -v home="$HOME" \
    -v root="$(ws_root "$1")" -v dim="$DIM" -v rst="$RST" '
    function tl(p) { return p == home ? "~" : (index(p, home "/") == 1 ? "~" substr(p, length(home) + 1) : p) }
    function note(d) {
      if (run[d]) return "● " run[d] (run[d] == 1 ? " trail" : " trails")
      if (gone[d]) return dim "○ " gone[d] " ended" rst
      return ""
    }
    function rank(d) { return run[d] ? 1 : (gone[d] ? 2 : 3) }
    function row(g, r, key, target, name, d) { n++; G[n] = g; R[n] = r; K[n] = key; T[n] = target; N[n] = name; D[n] = d; if (length(name) > w) w = length(name) }
    BEGIN {
      m = split(ENVIRON["TRAILS_ACT"], A, "\n")
      for (i = 1; i <= m; i++) {
        if (split(A[i], f, "\t") < 2) continue
        if (f[2] == "r") run[f[1]]++; else gone[f[1]]++
        seen_act[f[1]] = 1
      }
    }
    { kind[NR] = $1; dir[NR] = $2; par[NR] = $3; listed[$2] = 1; if ($1 == "self") self[$2] = 1; if ($1 == "wsdir" && !(($2) in gi)) gi[$2] = NR }
    END {
      for (i = 1; i <= NR; i++) {
        d = dir[i]
        if (kind[i] == "wsdir") row(i, 0, "", d in self ? d : "browse:" d, tl(d) "/", d)
        else if (kind[i] == "child") { sub(".*/", "", d); row(gi[par[i]], rank(dir[i]), d, dir[i], "    " d, dir[i]) }
        else if (kind[i] == "single") row(i, 0, "", d, tl(d), d)
      }
      # Deeper folders with something going on, under the workspace directory holding them.
      for (a in seen_act) {
        if (a in listed) continue
        for (wd in gi) if (index(a, wd "/") == 1) { rel = substr(a, length(wd) + 2); row(gi[wd], rank(a), rel, a, "    " rel, a); break }
      }
      for (i = 1; i <= n; i++) {
        t = note(D[i])
        if (t == "" && T[i] ~ /^browse:/) t = dim "browse inside" rst
        else if (t == "" && R[i] == 0 && (D[i] in self)) t = dim "codebase itself" rst
        line = sprintf("%-*s  %s", w, N[i], t); sub(/ +$/, "", line)
        print G[i], R[i], K[i], T[i], line
      }
      # Padded by hand: awks that count bytes and awks that count characters disagree on "…".
      pad = sprintf("%*s", (w > 7 ? w - 7 : 0) + 2, "")
      print 99999, 0, "", "browse:" root, "browse…" pad dim "from " tl(root) rst
    }' | sort -t "$TAB" -k1,1n -k2,2n -k3,3 | cut -f4-
}

# The codebases of workspace $1, counted for its "＋ new trail…" row.
ws_codebase_count() {
  ws_codebases "$1" | grep -c '^\(child\|self\|single\)|'
}

# "New trail in:" over codebase_tree (workspace $1): prints the directory picked, walking
# from a workspace directory or the root when the row says to. Nothing, and status 1, on Esc;
# status 2 on ctrl-c, which quits.
pick_codebase() {
  while :; do
    choice=$(codebase_tree "$1" | fzf --reverse --ansi --delimiter="$TAB" --with-nth=2 --height=~80% \
      --info='inline:   ' --color='info:dim' "$(hint_opt "# enter: pick · esc: back")" \
      --expect=esc --prompt="$1 ▸ New trail in: ") || return 2
    [ "$(printf '%s\n' "$choice" | head -n 1)" != esc ] || return 1
    t=$(printf '%s\n' "$choice" | sed -n 2p | cut -f1)
    case $t in
      browse:*)
        d=$(walk_dir "${t#browse:}")
        case $? in
          0) ;;
          1) continue ;;
          *) return 2 ;;
        esac
        ;;
      *) d=$t ;;
    esac
    printf '%s\n' "$d"
    return 0
  done
}

# Walk the file system from $1, a folder at a time: Enter opens a folder, ".." goes up, and
# the first row starts the trail in the folder you are in. Prints it. Nothing, and status 1, on
# Esc; status 2 on ctrl-c.
walk_dir() {
  wd=$1
  while :; do
    pick=$({
      printf 'use\t%s\t✓ start a trail here  %s%s%s\n' "$wd" "$DIM" "$(tilde_path "$wd")" "$RST"
      [ "$wd" = / ] || printf 'up\t%s\t..\n' "$(dirname "$wd")"
      for c in "$wd"/*/ "$wd"/.[!.]*/; do
        c=${c%/}
        [ -d "$c" ] && printf 'in\t%s\t%s/\n' "$c" "${c##*/}"
      done
    } | fzf --reverse --ansi --delimiter="$TAB" --with-nth=3 --height=~80% \
      --info='inline:   ' --color='info:dim' "$(hint_opt "# enter: open · esc: back")" \
      --expect=esc --prompt="$(tilde_path "$wd") ▸ ") || return 2
    [ "$(printf '%s\n' "$pick" | head -n 1)" != esc ] || return 1
    pick=$(printf '%s\n' "$pick" | sed -n 2p)
    case $pick in
      use*)
        printf '%s\n' "$wd"
        return 0
        ;;
      *) wd=$(printf '%s' "$pick" | cut -f2) ;;
    esac
  done
}

# A fzf over the directories under $1, for ctrl-n's first codebase of a new workspace: prints
# the one picked, nothing on Esc.
pick_dir() {
  list=$(for d in "$1"/*/; do
    d=${d%/}
    [ -d "$d" ] && printf '%s\n' "$d"
  done)
  [ -n "$list" ] || {
    echo "trails: no directories to pick from under $(tilde_path "$1")" >&2
    return 2
  }
  pd_out=$(printf '%s\n' "$list" | while IFS= read -r d; do
    printf '%s\t%s\n' "$d" "$(tilde_path "$d")"
  done | fzf --reverse --no-info --delimiter='\t' --with-nth=2 --height=~80% \
    --expect=esc --prompt="${2:-Pick a codebase: }") || return 2
  [ "$(printf '%s\n' "$pd_out" | head -n 1)" != esc ] || return 1
  printf '%s\n' "$pd_out" | sed -n 2p | cut -f1
}

# This directory belongs to no workspace, and some are configured: which workspace its trail
# goes in (D7). Every row is a workspace: "default" first, which adds the directory nowhere,
# so Enter keeps it there; then the workspace browsed from (TRAILS_BACK), then the rest, each
# adding the directory to it as a codebase, as `trails ws add` would. Sets TRAILS_WS, so the
# screens that follow stop asking. Esc goes back to the workspace browsed from, or quits, and
# ctrl-c quits.
ask_workspace() {
  here=$(tilde_path "$PWD")
  names=$({
    [ -z "${TRAILS_BACK:-}" ] || printf '%s\n' "$TRAILS_BACK"
    printf '%s\n' "$WORKSPACES" | cut -d'|' -f1
  } | awk '$0 != "default" && !seen[$0]++')
  wid=$(printf 'default\n%s\n' "$names" | awk '{ if (length($0) > w) w = length($0) } END { print w }')
  choice=$({
    printf 'default\t%-*s  %snot added to a workspace%s\n' "$wid" default "$DIM" "$RST"
    printf '%s\n' "$names" | while read -r w; do
      printf '%s\t%-*s  %sadd it here%s\n' "$w" "$wid" "$w" "$DIM" "$RST"
    done
  } | fzf --reverse --no-info --ansi --delimiter='\t' --with-nth=2 --height=~80% \
    --expect=esc --prompt="$here is in no workspace: ") || exit 0
  if [ "$(printf '%s\n' "$choice" | head -n 1)" = esc ]; then
    [ -z "${TRAILS_BACK:-}" ] || TRAILS_PICKER=workspace TRAILS_WS=$TRAILS_BACK exec "$SELF"
    exit 0
  fi
  w=$(printf '%s\n' "$choice" | sed -n 2p | cut -f1)
  if [ "$w" != default ]; then
    ws_add "$w" "$PWD" >&2 || exit 1
    WORKSPACES=$(load_workspaces)
  fi
  TRAILS_WS=$w
  export TRAILS_WS
}

# `trails ws next` / `prev`: the terminal to the workspace after, or before, the one it is on,
# in the order the status line lists them (by name, as tmux's #{S/n:} sorts), round the end.
# Running workspaces only: one with nothing running has no session to go to. Bound to
# prefix ( and ) by `trails keys`, in place of tmux's cycling through every session, each
# trail's own among them.
ws_step() {
  [ -n "$TMUX" ] || {
    echo "trails: ws $1 moves a terminal that is in tmux — run it from one, or bind it (trails keys)" >&2
    exit 1
  }
  wst_all=$(tmux list-sessions -F "#{session_name}$TAB#{@trails_workspace}" 2>/dev/null |
    awk -F"$TAB" '$1 == $2' | cut -f1 | LC_ALL=C sort)
  [ -n "$wst_all" ] || {
    echo "trails: no workspace is running" >&2
    exit 1
  }
  wst_cur=$(client_ws)
  wst_to=$(printf '%s\n' "$wst_all" | awk -v c="$wst_cur" -v d="$1" '
    { n++; w[n] = $0; if ($0 == c) at = n }
    END {
      if (!at) i = (d == "next") ? 1 : n
      else if (d == "next") i = at % n + 1
      else i = (at + n - 2) % n + 1
      print w[i]
    }')
  [ "$wst_to" != "$wst_cur" ] || return 0
  switch_to "=$wst_to"
}

# Go to workspace $1: switch the client you are in, or attach, to its session, landing on
# the trail that most wants you — or, when nothing runs there, show its screen, since no
# session is made for an empty workspace. A session of its name that is not a workspace is
# refused (D1).
ws_switch() {
  check_ws_name "$1" || exit 1
  if tmux has-session -t "=$1" 2>/dev/null; then
    [ "$(tmux display-message -pt "$1" '#{@trails_workspace}' 2>/dev/null)" = "$1" ] || {
      echo "trails: a tmux session named \"$1\" exists and isn't a trails workspace." >&2
      echo "        Rename it (tmux rename-session -t $1 NEW) or the workspace in $CONFIG." >&2
      exit 1
    }
    top=$(top_trail "$1")
    [ -z "$top" ] || top=$(ensure_window "$top" "$(trail_key "$top")" "$1") || exit 1
    [ -z "$TMUX" ] || switch_to "=$1${top:+:$top}"
    exec tmux attach-session -t "=$1${top:+:$top}"
  fi
  known=$(printf '%s\n' "$WORKSPACES" | cut -d'|' -f1)
  case "
$known
default
" in
    *"
$1
"*) ;;
    *)
      echo "trails: no workspace named \"$1\" — trails ws add $1 DIR makes one" >&2
      exit 1
      ;;
  esac
  TRAILS_PICKER=workspace TRAILS_WS=$1 exec "$SELF"
}

# ─── Launch ──────────────────────────────────────────────────────────────────
# How long to give an agent to fall over before assuming it came up, and the whole cost of
# the dead-on-arrival guard in launch() — every launch that works waits this long before
# attaching.
#
# It buys margin over a real measurement: cursor-agent with no keychain took 350ms and
# 650ms to die on two runs, and a bare `echo; exit 1` took 350-450ms, most of it process
# startup rather than the failure itself. So a value near the measurement is not safe —
# 0.5 sat inside the range and let the very failure this exists for through. 1.5 is ~2.3x
# the slowest seen.
#
# Guessing low is not a cheap mistake, which is what pushed this up rather than down: the
# check turns remain-on-exit back off, so an agent dying just after the deadline has its
# session torn down with the error inside it — the exact silence this guard removes. A
# death later than this reads as a normal exit and you are back to today's behaviour, so
# the guard only ever adds.
BOOT=1.5

# A trail is made in three tmux calls: its window in the workspace session (created with it
# when the workspace has none yet), its options, and its session. Then the agent is given
# BOOT seconds to fall over before the terminal is attached — not a single new-session, which
# would exec away before any of that could happen.
#
#   launch AGENT [yolo] [RESUME_ID] [KEY]
#
# The last two are restore's: RESUME_ID picks up that conversation instead of starting one,
# and KEY is the record the trail comes back from, whose name it keeps if it still can. With
# LAUNCH_DETACHED set, it prints the new key and returns instead of attaching — restore needs
# the key back, and `trails restore` brings back several without sitting in any of them.

# tmux with trails' own variables and the editors' markers out of its environment: the one
# door for any call that may start the server (see launch, where the reason is spelled out).
tmux_door() {
  env -u TRAILS_PICKER -u TRAILS_YOLO_STATE -u TRAILS_MENU_CACHE -u TRAILS_RECENT_CACHE \
    -u TRAILS_RESTORE_OK -u USE_TMUX -u LAUNCH_DETACHED -u TRAILS_NAME -u TRAILS_ATTACH -u TRAILS_BACK \
    -u TRAILS_FROM -u TRAILS_WS -u TRAILS_CLIENT -u NVIM -u ZED_TERM tmux "$@"
}

# One launch at a time through the part that names a trail: choosing its session, writing
# its record, making the session and marking its window. Two at once could pick one name,
# and the one tmux turned away would leave its record over the running one's; two restores
# could each bring the same trail back. A directory, because mkdir makes it or fails in one
# step. A lock older than five seconds is a launch that was killed in it, and is broken.
launch_lock() {
  mkdir -p "$STATE_DIR" 2>/dev/null
  ll_n=0
  until mkdir "$STATE_DIR/.launching" 2>/dev/null; do
    ll_n=$((ll_n + 1))
    if [ "$ll_n" -ge 50 ]; then
      rmdir "$STATE_DIR/.launching" 2>/dev/null
      ll_n=0
    fi
    sleep 0.1
  done
  trap 'launch_unlock' EXIT
}
launch_unlock() {
  rmdir "$STATE_DIR/.launching" 2>/dev/null
  trap - EXIT
}

launch() {
  refuse_bad_cwd
  row=$(agent_row "$1")
  [ -n "$row" ] || {
    echo "trails: unknown agent '$1'" >&2
    exit 1
  }
  # args is normally empty; the yolo flag is appended only when this launch was armed (see
  # mode below), and the session templates only matter to agents that can be restored.
  IFS='|' read -r _ cmd args yolo start resume idform create naming <<EOF
$row
EOF

  # $2 is "yolo" when the picker row was Tab-armed, empty otherwise. A row can only be armed
  # if it has a flag (toggle_yolo enforces it), so the empty-flag branch is belt-and-braces
  # rather than a path the picker can reach.
  if [ "$2" = yolo ]; then
    [ -n "$yolo" ] || {
      echo "trails: $1 has no YOLO mode" >&2
      exit 1
    }
    args="${args:+$args }$yolo"
  fi

  # Skip-permissions mode runs any command unconfirmed, so refuse the one place left where
  # that is catastrophic rather than merely unwise. Only the yolo launch is refused: plain,
  # prompting mode is merely ordinary as root.
  #
  # Keyed on the flag, not the agent, so any agent using one of these is covered however
  # it is named: --dangerously-skip-permissions (claude, and agy, which reused the name) also
  # auto-approves the sandbox-bypass prompt, and codex's --dangerously-bypass-approvals-and-sandbox
  # drops the sandbox outright. That is what makes them, and not --force or --auto, the ones
  # worth refusing as root.
  if [ "$2" = yolo ] && [ "$(id -u)" -eq 0 ]; then
    case $yolo in
      *--dangerously-skip-permissions* | *--dangerously-bypass-approvals-and-sandbox*)
        echo "trails: refusing $1 $yolo as root" >&2
        exit 1
        ;;
    esac
  fi

  # A trail you named (TRAILS_NAME, set by `trails new` and the picker's ctrl-n) tells the
  # agent its name, for an agent that takes one. Only on a fresh start: claude keeps the name
  # in the conversation, so a resume or a restore brings it back by itself, and passing the
  # old one again would undo a /rename made inside the session.
  [ -n "$TRAILS_NAME" ] && [ -z "$3" ] && [ -n "$naming" ] &&
    args="${args:+$args }$(printf '%s' "$naming" | sed "s/{name}/$TRAILS_NAME/g")"

  # $args is a controlled, space-separated field from the table above; splitting it into
  # separate arguments is the point. A closed row resumes here too, with nothing to record: there
  # is no tmux window for a record to bring back.
  # shellcheck disable=SC2086
  [ -n "$USE_TMUX" ] || exec "$cmd" $args ${3:+$(with_id "$resume" "$3")}

  # The conversation ID: the one being resumed, or one this trail starts under so it can be
  # resumed later — chosen here (session.start), or asked of the agent (session.create, a
  # command that prints a fresh ID, then started on with session.resume). An agent that can
  # only make its own IDs starts with none: its hooks say the ID (trails state WORD --id ID),
  # and rec_note_id writes the record then. No session block, no record.
  id=
  if [ -n "$3" ]; then
    id=$3
    args="${args:+$args }$(with_id "$resume" "$id")"
  elif [ -n "$start" ] && [ -n "$resume" ]; then
    id=$(new_id "$idform")
    args="${args:+$args }$(with_id "$start" "$id")"
  elif [ -n "$create" ] && [ -n "$resume" ]; then
    id=$(sh -c "$create" 2>/dev/null | awk 'NF { print $1; exit }')
    case $id in
      '' | *[!A-Za-z0-9._-]*)
        echo "trails: \`$create\` gave no usable ID — starting $1 without restore" >&2
        id=
        ;;
      *) args="${args:+$args }$(with_id "$resume" "$id")" ;;
    esac
  fi

  # Where it goes: the workspace the config gives this directory. A restore of a trail whose
  # directory no entry claims any more keeps the workspace its record names; the picker may
  # have asked and settled it (TRAILS_WS); anything else unclaimed runs in "default", and
  # says so, since the config is the user's to change.
  ws=$(workspace_of "$PWD") || ws=
  if [ -z "$ws" ]; then
    [ -n "$4" ] && ws=$(rec_get "$4" workspace)
    [ -n "$ws" ] || ws=${TRAILS_WS:-}
    [ -n "$ws" ] || {
      ws=default
      echo "trails: no workspace claims $(tilde_path "$PWD") — running in \"default\" (trails ws add NAME files it)" >&2
    }
  fi
  # The workspace's session is the user's to look at, not to be surprised by: a session of
  # that name that trails did not make is refused rather than added to (D1 in the design).
  if tmux has-session -t "=$ws" 2>/dev/null &&
    [ "$(tmux display-message -pt "$ws" '#{@trails_workspace}' 2>/dev/null)" != "$ws" ]; then
    echo "trails: a tmux session named \"$ws\" exists and isn't a trails workspace." >&2
    echo "        Rename it (tmux rename-session -t $ws NEW) or the workspace in $CONFIG." >&2
    exit 1
  fi

  # Its name, if it has one: the one you gave, the one its record kept, or for a closed
  # trail resumed the one its history kept. Kept only if free — a lost #payments comes back as
  # lattiq/payments, not lattiq/augur-2 — and a restore counts its own record as free.
  label=$(codebase_label "$PWD")
  name=
  if [ -z "$3" ] && [ -n "$TRAILS_NAME" ]; then
    name=$TRAILS_NAME
  elif [ -n "$4" ]; then
    name=$(rec_get "$4" name)
    [ -z "$name" ] || ! trail_name_taken "$name" "$4" || name=
  elif [ -n "$3" ]; then
    # A closed trail's name, if nothing has it now: not a trail's name, nor its session, which
    # an unnamed trail in a codebase of that name holds. Taken, it comes back unnamed.
    name=$(hist_get "$3" name)
    [ -z "$name" ] || { ! trail_name_taken "$name" && ! session_taken "$ws/$name"; } || name=
  fi

  launch_lock
  # Brought back already, on this conversation, by another restore while this one waited.
  if [ -n "$4" ] && [ -n "$3" ] && [ "$(tmux display-message -pt "=$4:" '#{@trails_id}' 2>/dev/null)" = "$3" ]; then
    launch_unlock
    echo "trails: $4 is back already" >&2
    exit 3
  fi

  # Its session, and so its key: ws/name for a named trail, else ws/label, or ws/label-N for the
  # Nth unnamed one here. A restore asks for its old name back, and gets it unless something
  # has since taken it — a fresh agent you started in that codebase after the reboot, say —
  # or its workspace has changed under it; then it lands on the next free -N like any second
  # trail would, and the old record goes with it below.
  if [ -n "$name" ]; then
    sess=$ws/$name
    if session_taken "$sess" "$4"; then
      # A new trail by a name that was free when it was checked, and was taken while this one
      # waited: refused, as it would have been a moment later. Only a restore takes a -N.
      [ -n "$4" ] || {
        launch_unlock
        echo "trails: '$name' is taken — trails ls -a shows what by" >&2
        exit 1
      }
      sess=$(next_session "$ws" "$name" "$4")
    fi
  elif [ -n "$4" ] && [ "${4%%/*}" = "$ws" ] && ! session_taken "$4" "$4"; then
    sess=$4
  else
    sess=$(next_session "$ws" "$label" "$4")
  fi
  # The window's name, for the status line and choose-tree: augur, augur-2 for the second,
  # augur·payments for one you named. Not the agent: which one runs is the trail's business,
  # and the picker says it. The -N is the session's, so the two agree.
  win=$label${name:+·$name}
  case $sess in
    "$ws/$label"-[0-9]*) win=$win-${sess##*-} ;;
    *) ;;
  esac

  # Written before the agent starts, not after it survives BOOT: the wrapper's --forget is
  # what clears it, and that only works if the record is already there when the agent exits.
  # An agent that dies at 1.6s would otherwise outrun its own record and leave a lost row for a
  # trail that never was.
  # What the key's record said before, put back if the session can't be made: two trails
  # started at once can pick one name, and the one tmux turns away must not leave its record
  # over the one that runs.
  rec_prev=
  if [ -n "$id" ]; then
    rec_prev=$(cat "$(rec_path "$sess")" 2>/dev/null)
    rec_write "$sess" "$1" "$PWD" "$id" "$2" "$ws" "$label" "$name"
  fi

  # The agent's window is made as its session: a session of its own named after the trail,
  # holding that one window (see "Trails" above). The workspace shows it through a trail's window,
  # made next by ensure_window.
  #
  # remain-on-exit keeps the pane after the agent exits, so the guard below can read why.
  # Chained into the creating command's own list rather than set by a second tmux call: an
  # agent that dies in milliseconds is reaped before a follow-up call can land, which is the
  # exact case worth catching. The new window is addressed by its exact name (=session:=name),
  # since a chained command after new-session -d does not inherit it as its target.
  # remain-on-exit-format '' drops tmux's own "Pane is dead" banner, leaving the capture to be
  # the agent's words and nothing else. -q on that one: the option is tmux 3.3's, and on an
  # older tmux (Ubuntu 22.04, RHEL 9) it failed the whole chain after the window and its
  # record already existed. Without the option, tmux's banner just joins the capture.
  #
  # status off on the session: it is only ever looked at through something else — a trail's window, an
  # editor's panel, a map pane — each of which has its own frame, and the session's status line
  # inside that frame read as a second tmux. A session option on a session trails made for
  # itself, not on anything of yours (principle 3 of the design).
  #
  # The agent runs under $WRAP (see "Surviving tmux"), which forgets the record when the
  # agent exits by itself and is killed alongside it when tmux goes.
  #
  # Through env -u, because this is the call that starts the tmux server when none is up, and
  # a starting server copies its client's whole environment into its global one — every
  # later pane, agent and trails run inherits it. trails' own variables must not ride along:
  # a TRAILS_PICKER=old from "resume old trails" opened every later picker on old
  # conversations only, and LAUNCH_DETACHED (before 0.4.2) made every later trails print the
  # session name instead of attaching. Nor may the editors' markers (from_editor): a server
  # started from nvim's terminal would have every later pane believe it was in nvim.
  # Stripped by tmux_door, the one door, rather than by watching how each caller sets them.
  #
  # -P -F hands back the new window's id, which is what every later call targets: exact, and
  # untouched by anything the user renames or re-numbers.
  # shellcheck disable=SC2086
  wid=$(tmux_door new-session -d -s "$sess" -n "$win" -c "$PWD" -P -F '#{window_id}' \
    sh -c "$WRAP" trails-wrap "$SELF" "$sess" "${3:+resume}" "$cmd" $args \
    \; set-option -w -t "=$sess:=$win" remain-on-exit on \
    \; set-option -qw -t "=$sess:=$win" remain-on-exit-format '' \
    \; set-option -t "=$sess:" status off \
    \; set-option -t "=$sess:" set-titles on \
    \; set-option -t "=$sess:" set-titles-string "$TRAIL_TITLE") || {
    if [ -n "$rec_prev" ]; then
      printf '%s\n' "$rec_prev" >"$(rec_path "$sess")"
    else
      rec_forget "$sess"
    fi
    exit 3
  }
  case $wid in
    @*) ;;
    *)
      echo "trails: tmux gave no window back for $1" >&2
      rec_forget "$sess"
      exit 1
      ;;
  esac
  # What the trail is, on its window (see "Trails" above). @agent is the picked entry,
  # tagged (YOLO) when armed, so the picker and `trails ls` can label the trail without
  # inspecting the process; @trails_id is which conversation this is, so rec_is_dead can
  # tell this trail from a stranger that happens to share its name.
  tmux set-option -w -t "$wid" @agent "$1${2:+ (YOLO)}" \
    \; set-option -w -t "$wid" @trails_dir "$PWD" \
    \; set-option -w -t "$wid" @trails_ws "$ws" \
    \; set-option -w -t "$wid" @trails_session "$sess" \
    \; set-option -w -t "$wid" @trails_label "$label" \
    \; set-option -w -t "$wid" @trails_name "$name" \
    \; set-option -w -t "$wid" @trails_program "$(basename "$cmd")" \
    \; set-option -w -t "$wid" @trails_since "$(date +%s)"
  [ -n "$id" ] && tmux set-option -w -t "$wid" @trails_id "$id"
  # A conversation resumed has been worked in, so it goes back into the history when it ends,
  # even if nothing is typed this time (see hist_add).
  [ -z "$3" ] || tmux set-option -p -t "$wid" @trails_worked 1
  launch_unlock
  ensure_window "$wid" "$sess" "$ws" >/dev/null || {
    tmux kill-session -t "=$sess" 2>/dev/null
    rec_forget "$sess"
    exit 1
  }

  # Dead on arrival. tmux drops a window the moment its command exits and the error goes
  # with it, so an agent that can't start (bad token, no keychain) made trails look like it
  # simply did nothing — the failure and a successful launch were both silence. Print what
  # the agent said rather than attaching to a corpse.
  #
  # -S- to read history, not just the visible screen: a dying pane scrolls its output up out of the
  # visible screen, so the last thing it said is only in the scrollback. The session goes as a
  # session, and its window's client exits with it, taking the trail's window.
  sleep "$BOOT"
  if [ "$(tmux display-message -pt "$wid" '#{pane_dead}' 2>/dev/null)" = 1 ]; then
    echo "trails: $1 exited immediately (status $(tmux display-message -pt "$wid" '#{pane_dead_status}' 2>/dev/null))" >&2
    tmux capture-pane -pS- -t "$wid" 2>/dev/null | awk 'NF' | tail -n 15 >&2
    tmux kill-session -t "=$sess" 2>/dev/null
    rec_forget "$sess"
    # The wrapper put it in the history as it went; a fresh one that never ran has nothing
    # to resume. A resume keeps its entry, to try again.
    [ -n "$3" ] || [ -z "$id" ] || hist_forget "$id"
    exit 1
  fi
  # Survived, so back to the default: quitting the agent should close the window, not
  # leave a dead pane the picker would keep listing. And the old record, if the trail came
  # back under a new key, has done its job: forgotten only now, so a restore that died on
  # arrival still has it to try again from.
  tmux set-option -w -t "$wid" remain-on-exit off
  [ -n "$4" ] && [ "$4" != "$sess" ] && rec_forget "$4"
  # A closed trail resumed is a running one again: out of the history, which holds only the
  # ended ones. Only now, so a resume that died on arrival is still there to try again.
  [ -z "$3" ] || hist_forget "$3"

  if [ -n "$LAUNCH_DETACHED" ]; then
    printf '%s\n' "$sess"
    return 0
  fi
  attach_to "$wid" "$sess" "$ws"
}

# A trail's window: the window in its workspace's session that shows it, a pane attached to
# its session (attach_cmd, the way a map pane shows an agent), named like the agent's window
# and marked @trails_window with the trail's key. Made at launch, and again here if you killed
# it: the trail lives in its session, so its window is rebuilt for free. The workspace session
# is made around it when there is none (D1's refusal applies). Prints the window id.
#
# The agent pane is stamped @ag and @dir as a map pane is (the agent, the codebase label),
# and the window's pane-border-format reads @ag, so with borders shown the agent's pane is
# labelled `claude`, not `tmux`, its own command, which says nothing; the editor and shell
# beside it, by their commands. Whether borders show is tmux.conf's to say (off by default).
#
#   ensure_window WID KEY WS     WID is the agent's window, in the trail's session
ensure_window() {
  ec_wid=$1 ec_key=$2 ec_ws=$3
  ec_win=$(window_of "$ec_key" "$ec_ws")
  [ -z "$ec_win" ] || {
    # Still marked, but without its agent pane: the nested client was detached (prefix
    # prefix d), or its pane killed, while the trail lives on. Given back and laid out again,
    # since every route in lands on this window and would otherwise find no agent in it.
    if ! tmux list-panes -t "$ec_win" -F '#{@trails_pane}' 2>/dev/null | grep -qxE 'view|agent'; then
      ec_agent=$(tmux display-message -pt "$ec_wid" '#{@agent}' 2>/dev/null)
      IFS="$US" read -r ec_dir ec_label <<EOF
$(tmux display-message -pt "$ec_win" "#{@trails_dir}${US}#{@trails_label}" 2>/dev/null)
EOF
      ec_pane=$(tmux split-window -d -t "$ec_win" -c "${ec_dir:-$PWD}" -P -F '#{pane_id}' "$(attach_cmd "$ec_key")") || return 1
      tmux set-option -p -t "$ec_pane" @trails_pane agent \
        \; set-option -p -t "$ec_pane" @ag "$ec_agent" \
        \; set-option -p -t "$ec_pane" @dir "$ec_label"
      window_layout "$ec_win"
    fi
    printf '%s\n' "$ec_win"
    return 0
  }
  IFS="$US" read -r ec_win ec_dir ec_label ec_agent <<EOF
$(tmux display-message -pt "$ec_wid" "#{window_name}${US}#{@trails_dir}${US}#{@trails_label}${US}#{@agent}" 2>/dev/null)
EOF
  [ -n "$ec_win" ] || return 1
  if tmux has-session -t "=$ec_ws" 2>/dev/null; then
    [ "$(tmux display-message -pt "$ec_ws" '#{@trails_workspace}' 2>/dev/null)" = "$ec_ws" ] || {
      echo "trails: a tmux session named \"$ec_ws\" exists and isn't a trails workspace." >&2
      echo "        Rename it (tmux rename-session -t $ec_ws NEW) or the workspace in $CONFIG." >&2
      return 1
    }
    set -- new-window -d -t "=$ec_ws:" -n "$ec_win" -c "${ec_dir:-$PWD}" -P -F '#{window_id}' "$(attach_cmd "$ec_key")"
  else
    set -- new-session -d -s "$ec_ws" -n "$ec_win" -c "${ec_dir:-$PWD}" -P -F '#{window_id}' "$(attach_cmd "$ec_key")"
  fi
  # Two trails started at once into a workspace with no session both see none: the second
  # new-session is turned away, and its window goes into the session the first just made.
  ec_win=$(tmux "$@" 2>/dev/null) || {
    [ "$1" = new-session ] && tmux has-session -t "=$ec_ws" 2>/dev/null &&
      ec_win=$(tmux new-window -d -t "=$ec_ws:" -n "$ec_win" -c "${ec_dir:-$PWD}" -P -F '#{window_id}' "$(attach_cmd "$ec_key")")
  } || return 1
  [ -n "$ec_win" ] || return 1
  tmux set-option -t "$ec_win" @trails_workspace "$ec_ws" \
    \; set-option -t "$ec_win" set-titles on \
    \; set-option -t "$ec_win" set-titles-string "$WS_TITLE" \
    \; set-option -w -t "$ec_win" @trails_window "$ec_key" \
    \; set-option -w -t "$ec_win" @trails_dir "$ec_dir" \
    \; set-option -w -t "$ec_win" @trails_ws "$ec_ws" \
    \; set-option -w -t "$ec_win" @trails_label "$ec_label" \
    \; set-option -p -t "$ec_win" @trails_pane agent \
    \; set-option -p -t "$ec_win" @ag "$ec_agent" \
    \; set-option -p -t "$ec_win" @dir "$ec_label" \
    \; set-option -w -t "$ec_win" pane-border-format ' #{?@ag,#{@ag},#{pane_current_command}} '
  printf '%s\n' "$ec_win"
}

# The trail's window showing trail KEY in workspace WS, if any (its window id).
window_of() {
  tmux list-windows -t "=$2" -F "#{@trails_window}$TAB#{window_id}" 2>/dev/null |
    awk -F"$TAB" -v k="$1" '$1 == k { print $2; exit }'
}

# Trail KEY is ending (the agent exited, or you ended it): what becomes of its window. The
# agent pane goes by itself when the session does, its client exits. A window that was only
# that pane goes with it. One that holds the editor or a shell you opened beside the agent
# (tool) keeps them, as a plain tool window of the codebase: named for the editor when there
# is one, else <codebase>·shell, marked @trails_tool, the trail's mark dropped. Run before the
# session is killed, while the window can still be found by the trail's key.
window_release() {
  # The workspace is the key's first part, always: a trail may have no record (an agent
  # without a session block, or one whose hooks have not said its ID yet), and the record's
  # workspace is this anyway.
  cr_win=$(window_of "$1" "${1%%/*}")
  [ -n "$cr_win" ] || return 0
  tmux list-panes -t "$cr_win" -F '#{@trails_pane}' 2>/dev/null | grep -qvx agent || return 0
  tmux set-option -wqu -t "$cr_win" @trails_window \
    \; set-option -w -t "$cr_win" @trails_tool shell
  tool_remark "$cr_win"
}

# A tool window is named and marked for what it holds, and that changes: the editor exits
# and leaves the shell; an editor is opened in a window that was only a shell. Re-read after
# every change to its panes (tool, --layout, window_release), so tool_find and the picker's
# row say what is there. Nothing to do for a trail's window, which is named for the trail.
tool_remark() {
  [ -n "$(tmux display-message -pt "$1" '#{@trails_tool}' 2>/dev/null)" ] || return 0
  tr_label=$(tmux display-message -pt "$1" '#{@trails_label}' 2>/dev/null)
  tr_ed=${EDITOR:-nvim}
  tr_panes=$(tmux list-panes -t "$1" -F '#{@trails_pane}' 2>/dev/null)
  if printf '%s\n' "$tr_panes" | grep -qxE 'edit|editor'; then
    tr_kind=editor tr_name="${tr_label}·$(basename "${tr_ed%% *}")"
  elif printf '%s\n' "$tr_panes" | grep -qx shell; then
    tr_kind=shell tr_name="${tr_label}·shell"
  else
    return 0
  fi
  tmux set-option -w -t "$1" @trails_tool "$tr_kind" \
    \; rename-window -t "$1" "$tr_name" 2>/dev/null
}

# Where the panes of window $1 go, from which of them it has (by @trails_pane). The agent
# alone fills it. With an editor pane, the editor takes the left 60% and the agent the right
# 40%, and a shell sits under the editor only, a quarter of the window high. With no editor
# pane, the shell runs along the bottom, full width, a quarter high. A window the agent has
# left (window_release) keeps the same rules without it: the shell under the editor.
#
# move-pane (tmux 3.2) puts a pane where it belongs whether it was there already or not, so
# this runs after every pane is made and after the editor pane exits, and never needs to know
# what the layout was. Sizes are set after, with resize-pane: a size given to move-pane is
# taken from the pane it splits, which may be too small to give it.
window_layout() {
  cl_v='' cl_e='' cl_s=''
  for cl_row in $(tmux list-panes -t "$1" -F '#{pane_id}=#{@trails_pane}' 2>/dev/null); do
    case $cl_row in
      *=view | *=agent) cl_v=${cl_row%%=*} ;;
      *=edit | *=editor) cl_e=${cl_row%%=*} ;;
      *=shell) cl_s=${cl_row%%=*} ;;
      *) ;;
    esac
  done
  cl_w=$(tmux display-message -pt "$1" '#{window_width}' 2>/dev/null)
  cl_h=$(tmux display-message -pt "$1" '#{window_height}' 2>/dev/null)
  [ -n "$cl_w" ] && [ -n "$cl_h" ] || return 0
  if [ -n "$cl_e" ]; then
    [ -z "$cl_v" ] || tmux move-pane -d -bh -s "$cl_e" -t "$cl_v" 2>/dev/null
    [ -z "$cl_s" ] || tmux move-pane -d -v -s "$cl_s" -t "$cl_e" 2>/dev/null
    [ -z "$cl_v" ] || tmux resize-pane -t "$cl_e" -x $((cl_w * 60 / 100)) 2>/dev/null
    [ -z "$cl_s" ] || tmux resize-pane -t "$cl_s" -y $((cl_h / 4)) 2>/dev/null
  elif [ -n "$cl_s" ] && [ -n "$cl_v" ]; then
    tmux move-pane -d -v -f -s "$cl_s" -t "$cl_v" 2>/dev/null
    tmux resize-pane -t "$cl_s" -y $((cl_h / 4)) 2>/dev/null
  fi
}

# The last step of every route into a trail, launched or picked: show it in the terminal
# you are standing in.
#
#   attach_to WID KEY WS
#
# From an editor's terminal (from_editor) it is the trail's session, one trail and nothing else;
# from a terminal of your own it is the workspace, on the trail's window. Inside tmux the
# client you are in is switched there rather than nesting a second tmux — except in an
# editor inside tmux, or a map pane, where the pane *is* the editor's panel or the trail's window: that
# pane becomes a nested client of the session, the way map() builds its windows, stamped with
# @dir/@ag in the map so its border reads like its neighbours'.
attach_to() {
  at_wid=$1 at_key=$2 at_ws=$3
  at_target="=$at_ws:$(ensure_window "$at_wid" "$at_key" "$at_ws")" || exit 1
  if [ -n "$TMUX" ]; then
    if [ -n "$IN_MAP" ] || from_editor; then
      if [ -n "$IN_MAP" ]; then
        tmux set-option -pt "$TMUX_PANE" @dir "$(map_dir "$at_key")"
        tmux set-option -pt "$TMUX_PANE" @ag "$(map_agent "$at_key")"
      fi
      exec env -u TMUX tmux attach-session -t "=$at_key"
    fi
    switch_to "$at_target"
  fi
  if from_editor; then
    exec tmux attach-session -t "=$at_key"
  fi
  exec tmux attach-session -t "$at_target"
}

# attach_to by key, for a caller holding a record key or a session name rather than a
# window.
attach_key() {
  key_ok "$1" || exit 1
  ak_wid=${2:-$(agent_wid "$1")}
  [ -n "$ak_wid" ] || {
    echo "trails: $1 is gone" >&2
    exit 1
  }
  attach_to "$ak_wid" "$1" "$(trail_ws "$ak_wid")"
}

# ─── Surviving tmux ──────────────────────────────────────────────────────────
# Every agent lives inside the tmux server, so when the server goes — a reboot, a crash,
# kill-server — every agent goes with it. The conversations survive (each CLI keeps its
# transcripts on disk); what dies is the knowledge of which conversation was which session,
# because that lived only in tmux. So write it down outside tmux, one small file per trail,
# keyed by its session's name:
#
#   ~/.local/state/trails/sessions/lattiq/augur-2   agent= dir= id= yolo= task= workspace= label= name=
#
# and bring trails back from it: lost rows in the picker, or `trails restore` for the lot.
# The workspace in the record is a fallback: a restore puts the trail where the config says
# its directory belongs now, and only an unclaimed directory falls back to where it was.
#
# The hard part is not writing records but knowing when to delete one. A session you quit
# is over; a session tmux took down is the whole point. Both look identical from outside —
# the session is gone — so the deletion has to happen at a moment only one of them reaches.
#
# tmux's own hooks cannot tell them apart, and both were measured. session-closed fires for
# kill-server as well, and only for whichever sessions it tears down before the server
# exits, so it deletes some records in exactly the case they exist for. pane-exited reports
# the wrong session name and does not fire at all when the last session quits.
#
# So the agent runs under a small sh wrapper, and the moment is "the agent exited and the
# wrapper is still alive to notice". An agent that quits — /exit, ctrl-c, a crash — returns
# to the wrapper, which forgets the record and exits with the agent's status. When tmux
# dies it hangs up on the pane's whole process group, and sh's default for SIGHUP is to die
# where it stands, so the wrapper goes down with the agent and the forget never runs. A
# reboot runs nothing at all. Measured on an isolated server: own exit and ctrl-c forget,
# kill-server keeps every record.
#
# What the wrapper costs: it is now the pane's process, so #{pane_pid} is sh's, and
# #{pane_current_command} reads sh — which matters only as sessions()' fallback label,
# and every session launch() makes has @agent. The exit status is passed through, so the
# dead-on-arrival guard still reads the agent's own.
#
# trap : INT QUIT keeps the wrapper alive through a ctrl-c meant for the agent. It is a
# no-op *handler*, not an ignore, so the agent execs with default dispositions and handles
# ctrl-c itself as usual; an inherited ignore would not be reset. HUP is left alone, since
# dying to it is the entire mechanism.
#
# One exit is not a quit: a resume the agent refuses. It can take longer than launch()'s BOOT
# to come up and say "No conversation found" (claude starting several MCP servers, say), so by
# then restore has called it a success and the guard is off, and forgetting the record would
# lose the only pointer to the conversation — the thing restore_one promises not to do. So a
# resume ($3 non-empty) that exits non-zero inside its first RESUME_GRACE seconds keeps its
# record: the row comes back as lost, to retry or ctrl-x. A fresh start has no such case, and
# a resume that ran for a while and then crashed is a session that was used, so both forget.
#
# Records begin with this version: a session started before it has none, and so cannot be
# brought back.
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/trails/sessions

# The wrapper calls back into this script by absolute path, because it runs long after
# whatever relative path or PATH lookup started us.
case $0 in
  /*) SELF=$0 ;;
  *) SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0") ;;
esac

RESUME_GRACE=20
# shellcheck disable=SC2016 # expanded by the wrapper's sh, not here
WRAP='self=$1 name=$2 resume=$3; shift 3; trap : INT QUIT; t0=$(date +%s); "$@"; s=$?
  [ -n "$resume" ] && [ "$s" -ne 0 ] && [ $(($(date +%s) - t0)) -lt '$RESUME_GRACE' ] ||
    "$self" --forget "$name"
  exit $s'

# A conversation ID in the shape the agent's session.id asks for.
new_id() {
  if command -v uuidgen >/dev/null 2>&1; then
    u=$(uuidgen | tr '[:upper:]' '[:lower:]')
  else
    u=$(cat /proc/sys/kernel/random/uuid)
  fi
  case $1 in
    ses_hex) printf 'ses_%s' "$(printf '%s' "$u" | tr -d -)" ;;
    *) printf '%s' "$u" ;;
  esac
}

# Never outside the records' directory, whatever the key: one with .. or a leading / names no
# record.
rec_path() {
  case $1 in
    /* | *..*) printf '%s/.no-such-record' "$STATE_DIR" ;;
    *) printf '%s/%s' "$STATE_DIR" "$1" ;;
  esac
}
rec_get() { sed -n "s/^$2=//p" "$(rec_path "$1")" 2>/dev/null | head -n 1; }
rec_forget() { [ -n "$1" ] && rm -f "$(rec_path "$1")"; }

# ─── History ─────────────────────────────────────────────────────────────────
# The trails that ended, to resume: "resume old" lists them (recent_rows). A trail's record
# moves here when its agent exits or you end it, named by its conversation ID, with when it
# ended; one with no ID has nothing to resume, and is forgotten. trails' own account of what it
# ran, not the agent's: it reads no agent's files (ADR 19), so a conversation started outside
# trails is the agent's own resume's to find. The newest HIST_MAX are kept.
HIST_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/trails/history
HIST_MAX=100

# Is $1 a conversation ID trails takes: a letter or digit first (no ".", "..", or a "-x" an
# agent would read as a flag), then letters, digits, _ . - only. It names a file in the
# history and goes on an agent's command line.
id_ok() {
  case $1 in
    [A-Za-z0-9]*) ;;
    *) return 1 ;;
  esac
  case $1 in
    *[!A-Za-z0-9_.-]*) return 1 ;;
    *) return 0 ;;
  esac
}
hist_path() { printf '%s/%s' "$HIST_DIR" "$1"; }
hist_get() { id_ok "$1" && sed -n "s/^$2=//p" "$(hist_path "$1")" 2>/dev/null | head -n 1; }
hist_forget() { id_ok "$1" && rm -f "$(hist_path "$1")"; }

# A copy of record $1 into the history, as ended now. Through a temp file and mv, as
# rec_write. Nothing to resume adds nothing: a record with no conversation ID, or a
# conversation that never got a turn — the agent's hooks spoke (@trails_state) but never said
# working (@trails_worked), on pane or window $2 — which an agent refuses to resume. Without
# $2, or with no hooks to tell, it is added.
hist_add() {
  ha_id=$(rec_get "$1" id)
  id_ok "$ha_id" || return 0
  if [ -n "${2:-}" ]; then
    ha_said=$(tmux display-message -pt "$2" "#{@trails_state}${US}#{@trails_worked}" 2>/dev/null)
    case $ha_said in
      ?*"$US") return 0 ;;
      *) ;;
    esac
  fi
  mkdir -p "$HIST_DIR" || return 0
  { grep -v '^ended=' "$(rec_path "$1")" && echo "ended=$(date +%s)"; } >"$(hist_path "$ha_id").tmp.$$" 2>/dev/null &&
    mv -f "$(hist_path "$ha_id").tmp.$$" "$(hist_path "$ha_id")"
  rm -f "$(hist_path "$ha_id").tmp.$$"
  # Past HIST_MAX, the oldest go: by ended=, the time the file says, not its mtime. A tab
  # between them, which no path in the state directory holds.
  [ "$(find "$HIST_DIR" -type f ! -name '*.tmp.*' | wc -l)" -le "$HIST_MAX" ] ||
    find "$HIST_DIR" -type f ! -name '*.tmp.*' -exec awk -v OFS="$TAB" '/^ended=/ { print substr($0, 7), FILENAME }' {} + |
    sort -t "$TAB" -k1,1nr | sed -n "$((HIST_MAX + 1)),\$p" | cut -f2- |
      while IFS= read -r f; do rm -f "$f"; done
}

# Record $1 into the history, then gone: a trail that ended. $2 its pane, for hist_add.
rec_close() {
  hist_add "$1" "${2:-}"
  rec_forget "$1"
}

# Every record's key, one per line: WORKSPACE/NAME, a file one directory down.
rec_keys() {
  [ -d "$STATE_DIR" ] || return 0
  find "$STATE_DIR" -mindepth 2 -maxdepth 2 -type f ! -name '*.tmp' ! -name '*.tmp.*' 2>/dev/null |
    sed "s|^$STATE_DIR/||"
}

# key agent dir id yolo [workspace label name]. Through a temp file and mv, so a reader never
# sees half a record. It keeps the tmux server the trail runs on too (tmux_server).
rec_write() {
  mkdir -p "$(dirname "$(rec_path "$1")")" || return 0
  printf 'agent=%s\ndir=%s\nid=%s\nyolo=%s\ntask=\nworkspace=%s\nlabel=%s\nname=%s\nserver=%s\n' \
    "$2" "$3" "$4" "$5" "${6:-}" "${7:-}" "${8:-}" "$(tmux_server)" >"$(rec_path "$1").tmp.$$" &&
    mv -f "$(rec_path "$1").tmp.$$" "$(rec_path "$1")"
  rm -f "$(rec_path "$1").tmp.$$"
}

# The badge a record's trail would wear (trail_badge), from what the record kept.
rec_badge() { trail_badge "$1" "$(rec_codebase "$1")" "$(rec_get "$1" name)"; }

# Called for every live session on every sessions() pass, so it touches the disk only when a
# record exists and its task actually changed.
#
# The task reaches awk through ENVIRON, not -v: -v reads backslash escapes, so a title like
# `Match \d+ in C:\temp\new` was stored as `Match d+ in C:<tab>emp` and a stray line, then
# never compared equal to the live title and was rewritten on every poll.
rec_note_task() {
  [ -n "$2" ] && [ -f "$(rec_path "$1")" ] || return 0
  [ "$(rec_get "$1" task)" = "$2" ] && return 0
  rec_rewrite "$1" '/^task=/ { print "task=" ENVIRON["RR_V"]; next } 1' "$2"
}

# Record $1 put through awk program $2, with $3 as ENVIRON["RR_V"], only while the record is
# there: `trails ls` rewrites records on every pass, and a trail whose
# wrapper forgot its record in the meantime must not come back as lost. Each writer has a
# temp file of its own, so two never trade halves.
rec_rewrite() {
  rr=$(rec_path "$1")
  [ -f "$rr" ] || return 0
  RR_V=$3 awk "$2" "$rr" >"$rr.tmp.$$" 2>/dev/null && [ -f "$rr" ] && mv -f "$rr.tmp.$$" "$rr"
  rm -f "$rr.tmp.$$"
}

# Follow a trail to the conversation its agent says it is in (`trails state WORD --id ID`,
# which sets @trails_said_id on its pane). Two jobs, one mechanism:
#
#   the agent moves on: /resume or /clear inside claude switches the conversation, and a
#   record left on the first would restore the wrong one after tmux dies. The one it left
#   goes into the history, to resume like any ended trail.
#
#   an agent that picks its own ID (codex, gemini) has no record until it says the ID: launch()
#   has nothing to write. This writes it, once the agent can be resumed at all.
#
# Only while the record still holds the ID the trail carries, so a record is never rewritten
# from a session that isn't its own; and a record is made only for a trail that carries no ID
# yet, so a pass that read the window just before its agent quit can't bring back the record
# the quit just closed.
#
# id_label and id_agent and not label and agent: sh has no locals, and sessions() calls this
# from inside its own read loop, then prints the label it read.
#
#   rec_note_id KEY WID @agent @trails_id @trails_said_id dir
#
# All but the key come from sessions()' one list-windows, rather than a tmux client each per
# trail per pass — and a script polling `trails ls -a` makes a pass every few seconds.
rec_note_id() {
  now=$5 carried=$4
  [ -n "$now" ] && [ "$now" != "$carried" ] || return 0
  id_label=$3
  id_agent=${id_label%% *}
  resumable "$id_agent" || return 0
  if [ -f "$(rec_path "$1")" ]; then
    [ "$(rec_get "$1" id)" = "$carried" ] || return 0
    # The conversation left, into the history if it was ever worked in. The mark is not
    # cleared for the new one: a /resume moves to a conversation that has had turns.
    hist_add "$1" "$2"
    rec_rewrite "$1" '/^id=/ { print "id=" ENVIRON["RR_V"]; next } 1' "$now" || return 0
  else
    [ -z "$carried" ] || return 0
    mode=
    case $id_label in *"(YOLO)"*) mode=yolo ;; *) ;; esac
    # A trail's first record, written once its agent has a conversation: the rest of what a
    # record keeps is on the window.
    w=$(tmux display-message -pt "$2" "#{@trails_ws}${US}#{@trails_label}${US}#{@trails_name}" 2>/dev/null)
    IFS="$US" read -r w_ws w_label w_name <<EOF
$w
EOF
    rec_write "$1" "$id_agent" "$6" "$now" "$mode" "$w_ws" "$w_label" "$w_name"
  fi
  tmux set-option -w -t "$2" @trails_id "$now"
}

# Is this record's trail gone? Not "is a window of that name running": a name can be taken
# by something else (a `tmux new -s lattiq/augur` of your own), and that would hide the dead
# record from every lost row and from restore. launch() stamps each trail with its
# conversation ID as @trails_id, and a record is alive only while a window carrying its key
# carries its ID too. The key is on the window for a trail (@trails_session).
#
# Only a record of this tmux server: on another (`tmux -L other`, a test's), every trail of
# the first would look dead, and restoring them there would run each conversation twice.
#
# ALIVE is the one list-windows for a whole rec_dead pass; a lone question asks itself.
rec_is_dead() {
  [ -f "$(rec_path "$1")" ] || return 1
  rid_srv=$(rec_get "$1" server)
  [ "${rid_srv:-default}" = "$(tmux_server)" ] || return 1
  rid_alive=${ALIVE:-$(tmux list-windows -a -F "#{@trails_session}${US}#{@trails_id}" 2>/dev/null)}
  ! printf '%s\n' "$rid_alive" | grep -qxF "$1$US$(rec_get "$1" id)"
}

# The tmux server this run talks to, by its socket's name: the one in $TMUX inside tmux (a
# run-shell job has it too), else tmux's default.
tmux_server() {
  if [ -n "${TMUX:-}" ]; then
    ts=${TMUX%%,*}
    printf '%s' "${ts##*/}"
  else
    printf default
  fi
}

# Every record whose trail is not running: what died with tmux. Keys only.
rec_dead() {
  ALIVE=$(tmux list-windows -a -F "#{@trails_session}${US}#{@trails_id}" 2>/dev/null)
  rec_keys | while read -r key; do
    rec_is_dead "$key" && printf '%s\n' "$key"
  done
  ALIVE=
}

# Bring one dead trail back, detached, from its record; prints the key it came back under.
# Run from the trail's own directory.
#
# Resuming can fail where starting would not: claude refuses an ID that never got a message
# ("No conversation found with session ID"), which is what an agent you opened and never
# typed into leaves behind. There is nothing to resume then, so start fresh in its place.
# If that fails too the agent itself is broken (a bad token, no keychain), and the record is
# put back — it is the only pointer to the conversation, and a failed restore must not cost it.
restore_one() {
  agent=$(rec_get "$1" agent)
  id=$(rec_get "$1" id)
  mode=$(rec_get "$1" yolo)
  saved=$(cat "$(rec_path "$1")")

  # Subshells because launch() exits on failure, which would take the fallback with it.
  #
  # LAUNCH_DETACHED is set as its own statement, never as a `VAR=1 launch` prefix: a prefix
  # on a function exports the variable to everything the function runs, tmux included, so
  # the restored agent inherited it — and a tmux server started by the restore copied it into
  # its global environment, where every later pane had it and any trails run there printed
  # the session name instead of attaching.
  (
    LAUNCH_DETACHED=1
    launch "$agent" "$mode" "$id" "$1"
  )
  ro_rc=$?
  [ "$ro_rc" -eq 0 ] && return 0
  # Turned away by tmux (status 3) with the trail running under its key: another restore
  # brought it back a moment ago. Starting it fresh would be a second agent in its place.
  if [ "$ro_rc" -eq 3 ] && [ -n "$(agent_wid "$1")" ]; then
    echo "trails: $1 is back already" >&2
    return 0
  fi
  # A trail that comes back under its old key overwrites its record on the way in, and a
  # launch that dies on arrival forgets what it wrote — so the record is put back between
  # the attempts, since the second reads its name and workspace from it.
  mkdir -p "$(dirname "$(rec_path "$1")")" && printf '%s\n' "$saved" >"$(rec_path "$1")"
  echo "trails: nothing to resume for $1 — starting $agent fresh in its place" >&2
  (
    LAUNCH_DETACHED=1
    launch "$agent" "$mode" "" "$1"
  ) && return 0
  mkdir -p "$(dirname "$(rec_path "$1")")" && printf '%s\n' "$saved" >"$(rec_path "$1")"
  echo "trails: could not bring $1 back — its record is kept, try again once $agent starts" >&2
  return 1
}

# `trails restore` — every dead trail on the box, each in its own directory and, since 1.0,
# in the workspace the config gives that directory. Detached, because there may be several
# and you can only sit in one: attach afterwards with the picker or the map, which already
# know how to find them. `trails ls -a` lists them first, as its lost rows.
restore_all() {
  [ -z "${1:-}" ] || {
    echo "trails: restore takes no arguments — trails ls -a shows what it would bring back (lost)" >&2
    exit 1
  }
  command -v tmux >/dev/null 2>&1 || {
    echo "trails: restore needs tmux" >&2
    exit 1
  }
  keys=$(rec_dead)
  [ -n "$keys" ] || {
    echo "trails: nothing to restore"
    return 0
  }

  # Each in a subshell: restore_one cds, and launch exits on failure — neither may leak into
  # the next one.
  for key in $keys; do
    dir=$(rec_get "$key" dir) ra_agent=$(rec_get "$key" agent) ra_id=$(rec_get "$key" id)
    # One that can never come back is forgotten, and said so: ctrl-x on a lost row only works
    # from its own directory, which may be the one that's gone. The conversation stays in the
    # agent's own history; only the pointer to it goes.
    if [ -z "$dir" ] || [ -z "$ra_agent" ]; then
      rec_forget "$key"
      echo "trails: forgot $key — its record was unreadable" >&2
      continue
    fi
    if [ ! -d "$dir" ]; then
      rec_forget "$key"
      echo "trails: forgot $key — $dir is gone${ra_id:+ (conversation $ra_id stays in the history of $ra_agent)}" >&2
      continue
    fi
    new=$(cd "$dir" && restore_one "$key") || continue
    if [ "$new" = "$key" ]; then
      echo "restored $key"
    else
      echo "restored $key as $new"
    fi
  done
}

# ─── Recent trails ───────────────────────────────────────────────────────────
# "Resume old": the trails that ended, from the history (see "History"), newest first. Only
# those of an agent that is installed and can resume, ended in the last RECENT_DAYS days,
# RECENT_MAX of them; in directory $1, or every one when it is empty. A conversation a record
# holds is left out, being a live or lost row already.
#
#   ended  agent  dir  id  yolo  title
#
# Never an empty field: TAB is IFS whitespace, and read would shift the rest left into it.
# The title last, since it is free text.
RECENT_DAYS=${TRAILS_RECENT_DAYS:-10}
RECENT_MAX=${TRAILS_RECENT_MAX:-5}

# Every conversation ID a record holds, space-separated and padded for a match.
held_ids() {
  printf ' %s ' "$(rec_keys | while read -r key; do rec_get "$key" id; done | tr '\n' ' ')"
}

# TRAILS_RECENT_MAX=0 turns it off, for a caller that only wants what is running.
recent_rows() {
  [ "$RECENT_MAX" -gt 0 ] 2>/dev/null || return 0
  [ -d "$HIST_DIR" ] || return 0
  rr_ok=" $(available_agents | while read -r a; do resumable "$a" && printf '%s ' "$a"; done)"
  find "$HIST_DIR" -type f ! -name '*.tmp.*' -exec awk -v OFS="$TAB" -v d="$1" \
    -v since="$(($(date +%s) - RECENT_DAYS * 86400))" -v ok="$rr_ok" -v held="$(held_ids)" '
    function row() {
      if (f == "" || v["ended"] + 0 < since || v["id"] == "") return
      if (d != "" && v["dir"] != d) return
      if (index(ok, " " v["agent"] " ") == 0 || index(held, " " v["id"] " ") != 0) return
      t = v["task"]; gsub(/\t/, " ", t)
      print v["ended"], v["agent"], v["dir"], v["id"], (v["yolo"] == "yolo" ? "yolo" : "-"), (t == "" ? "-" : t)
    }
    FNR == 1 { row(); f = FILENAME; delete v }
    { k = substr($0, 1, index($0, "=") - 1); v[k] = substr($0, index($0, "=") + 1) }
    END { row() }' {} + 2>/dev/null | sort -t "$TAB" -k1,1nr | head -n "$RECENT_MAX"
}

# The closed rows for the picker's screen (TRAILS_PICKER): none on the workspaces, agents and
# every-trail screens; on a workspace's, those whose directory it claims; else this directory's.
# Read once into the picker's cache, and again after ctrl-x forgets one.
recent_cache() {
  case ${TRAILS_PICKER:-} in
    ws | agents | all) ;;
    workspace*) recent_rows '' | while IFS="$TAB" read -r m agent dir rest; do
      [ "$(workspace_of "$dir" 2>/dev/null)" = "$TRAILS_WS" ] &&
        printf '%s\t%s\t%s\t%s\n' "$m" "$agent" "$dir" "$rest"
    done ;;
    *) recent_rows "$PWD" ;;
  esac
}

# mtime, now → "5m ago", "3h ago", "2d ago".
ago() {
  s=$(($2 - $1))
  if [ "$s" -lt 3600 ]; then
    printf '%sm ago' $((s / 60))
  elif [ "$s" -lt 86400 ]; then
    printf '%sh ago' $((s / 3600))
  else
    printf '%sd ago' $((s / 86400))
  fi
}

# ─── Editor and shell ────────────────────────────────────────────────────────
# The editor or a shell for one codebase, beside its agent: panes in the trail's window, each
# marked @trails_pane (editor, shell) so it is found again and never mistaken for the agent
# pane. The trail's session is the agent alone, so an editor's panel or a map pane attached to
# it sees none of this; only the workspace does. window_layout says where each goes. With no
# trail in the codebase the editor gets a window of its own in the workspace, <codebase>·nvim,
# marked @trails_tool editor with the codebase on it, and the shell goes along its bottom: a
# tool window. A trail's window whose trail ended keeps its panes as one (window_release).
# Never a shell at the workspace level: every window runs in some codebase.
#
#   trails edit    $EDITOR (nvim if unset), as `nvim .`, in the window of the trail you are on,
#                  else of the codebase's trail that most wants you; alone when none runs
#   trails shell   a shell in the codebase, tmux's default command, a quarter high along the
#                  bottom of that same window
#
# The window you are on decides the codebase, since a workspace holds unrelated repos: run
# from a trail's window or a tool window, the command acts on that window; from a plain window in
# the workspace, on the pane's directory; outside tmux, on $PWD, or DIR after the command.
# Run again it selects the pane that is there, and run from that pane it goes back to the
# one you came from. Nothing here is restored: an editor or a shell is reopened with one
# command.
tool() {
  ck=$1
  case $ck in
    edit) mark=editor ;;
    *) mark=shell ;;
  esac
  # An editor that isn't there would die with its pane, and say so where no one can read it.
  if [ "$ck" = edit ]; then
    tl_ed=${EDITOR:-nvim}
    command -v "${tl_ed%% *}" >/dev/null 2>&1 || {
      echo "trails: \$EDITOR is ${tl_ed%% *}, which isn't installed" >&2
      exit 1
    }
  fi
  here=${2:-$PWD}
  ws='' cur_wid='' cur_kind='' cur_win='' cur_pane=''
  if [ -n "$TMUX" ] && [ -z "${2:-}" ]; then
    # The pane it was run in, from a shell; else the terminal that pressed the key (run-shell
    # bindings pass it): -t, since -c answers for whichever client was last active.
    tl_at=${TMUX_PANE:-$CLIENT}
    # shellcheck disable=SC2086 # the -t and its target are two words on purpose
    # Asked first, read after: the read's IFS would otherwise split -t from its target.
    tl_out=$(tmux display-message -p ${tl_at:+-t "$tl_at"} "#{window_id}${US}#{@trails_dir}${US}#{@trails_ws}${US}#{@trails_tool}${US}#{@trails_window}${US}#{pane_id}${US}#{pane_current_path}" 2>/dev/null)
    IFS="$US" read -r cur_wid w_dir w_ws cur_kind cur_win cur_pane p_path <<EOF
$tl_out
EOF
    here=${w_dir:-${p_path:-$PWD}}
    ws=$w_ws
    [ -n "$ws" ] || ws=$(client_ws)
  fi
  [ -d "$here" ] || {
    echo "trails: no such directory: $here" >&2
    exit 1
  }
  [ -n "$ws" ] || ws=$(workspace_of "$here") || ws=${TRAILS_WS:-default}

  # The window: the trail's or tool window you are on; else the window of the codebase's trail that
  # most wants you, in that trail's workspace; else the codebase's editor window, made if
  # need be.
  if [ -n "$cur_win" ] || [ -n "$cur_kind" ]; then
    wid=$cur_wid
  else
    key=$(trail_in "$here")
    if [ -n "$key" ]; then
      twid=$(agent_wid "$key")
      ws=$(trail_ws "$twid")
      wid=$(ensure_window "$twid" "$key" "$ws") || exit 1
    else
      wid=$(tool_find editor "$ws" "$here")
      [ -n "$wid" ] || [ "$ck" != shell ] || wid=$(tool_find shell "$ws" "$here")
      [ -n "$wid" ] || wid=$(tool_make "$here" "$ws" "$(codebase_label "$here")") || exit 1
    fi
  fi

  # The pane: on it already, back to the pane (or window) you came from; there, selected;
  # else made, and the trail's window laid out (window_layout) either way. The editor pane's command ends
  # by asking for the layout again, from outside the pane (run-shell -b, after the pane has
  # gone): a shell that sat under the editor would otherwise keep its column, tall and narrow.
  pane=$(tmux list-panes -t "$wid" -F '#{pane_id} #{@trails_pane}' 2>/dev/null | awk -v k="$mark" '$2 == k { print $1; exit }')
  if [ -n "$pane" ] && [ "$pane" = "$cur_pane" ]; then
    [ "$(tmux list-panes -t "$wid" 2>/dev/null | wc -l)" -gt 1 ] && exec tmux select-pane -l
    exec tmux last-window
  fi
  if [ -z "$pane" ]; then
    if [ "$ck" = edit ]; then
      pane=$(tmux split-window -d -bh -t "$wid" -c "$here" -P -F '#{pane_id}' "$(editor_cmd "$wid")") || exit 1
    else
      pane=$(tmux split-window -d -v -t "$wid" -c "$here" -P -F '#{pane_id}') || exit 1
    fi
    tmux set-option -p -t "$pane" @trails_pane "$mark"
    tool_remark "$wid"
  fi
  window_layout "$wid"
  tmux select-pane -t "$pane"
  [ -z "$TMUX" ] || switch_to "=$ws:$wid"
  exec tmux attach-session -t "=$ws:$wid"
}

# The editor pane's command: the editor on the codebase, as `nvim .`, the way you would open
# it by hand (nvim, vim, helix, emacs and the desktop editors all take a directory, and
# without one nvim sits on an empty buffer in the right place). Then, as the editor exits
# and while its pane is still there to ask, the window is relaid and re-marked from outside
# the pane (run-shell -b, after the pane has gone): a shell that sat under the editor would
# otherwise keep its column, tall and narrow, and a tool window its editor's name. $1 is the
# window id when the caller has it; a window made around this pane reads its own as it ends.
editor_cmd() {
  ed_id=${1:-"\$(tmux display-message -p '#{window_id}')"}
  printf '%s .; tmux run-shell -b "sleep 0.3; '"'"'%s'"'"' --layout %s"' "${EDITOR:-nvim}" "$SELF" "$ed_id"
}

# The window of tool kind $1 for directory $3 in workspace $2, if any.
tool_find() {
  tmux list-windows -t "=$2" -F "#{window_id}${US}#{@trails_tool}${US}#{@trails_dir}" 2>/dev/null |
    while IFS="$US" read -r w k d; do
      [ "$k" = "$1" ] && same_dir "$d" "$3" && printf '%s\n' "$w" && break
    done
}

# The key of the trail in directory $1 that most wants you, or nothing when none runs there.
trail_in() {
  sessions | while IFS="$TAB" read -r row; do
    same_dir "$(printf '%s\n' "$row" | cut -f5)" "$1" && printf '%s\n' "$row"
  done | classify | most_wants 3
}

# The editor alone, for a codebase with no trail running: a window in the workspace, dir,
# workspace, label. Prints its window id. The workspace session is made around it when
# there is none (D1's refusal applies), as a trail's window would be.
tool_make() {
  cm_dir=$1 cm_ws=$2 cm_label=$3
  ed=${EDITOR:-nvim}
  cm_name="${cm_label}·$(basename "${ed%% *}")"
  if tmux has-session -t "=$cm_ws" 2>/dev/null; then
    [ "$(tmux display-message -pt "$cm_ws" '#{@trails_workspace}' 2>/dev/null)" = "$cm_ws" ] || {
      echo "trails: a tmux session named \"$cm_ws\" exists and isn't a trails workspace." >&2
      echo "        Rename it (tmux rename-session -t $cm_ws NEW) or the workspace in $CONFIG." >&2
      return 1
    }
    set -- new-window -d -t "=$cm_ws:" -n "$cm_name" -c "$cm_dir" -P -F '#{window_id}'
  else
    set -- new-session -d -s "$cm_ws" -n "$cm_name" -c "$cm_dir" -P -F '#{window_id}'
  fi
  # Through the door: the editor alone may be what starts the server.
  w=$(tmux_door "$@" "$(editor_cmd)")
  [ -n "$w" ] || return 1
  tmux set-option -t "$cm_ws" @trails_workspace "$cm_ws" \
    \; set-option -t "$cm_ws" set-titles on \
    \; set-option -t "$cm_ws" set-titles-string "$WS_TITLE" \
    \; set-option -w -t "$w" @trails_tool editor \
    \; set-option -w -t "$w" @trails_dir "$cm_dir" \
    \; set-option -w -t "$w" @trails_ws "$cm_ws" \
    \; set-option -w -t "$w" @trails_label "$cm_label" \
    \; set-option -p -t "$w" @trails_pane editor
  printf '%s\n' "$w"
}

# The same directory, however spelled: a trail keeps the path you cd'd by, tmux reports a
# pane's path resolved, and the two differ through a symlink.
same_dir() {
  [ "$1" = "$2" ] && return 0
  [ "$(cd "$1" 2>/dev/null && pwd -P)" = "$(cd "$2" 2>/dev/null && pwd -P)" ]
}

# The tool windows in workspace $1, or with none this directory's, as the picker's raw
# rows (print_menu): the state is "tool", the agent column what it is (editor, shell),
# and the title what the window was named for. Panes beside an agent are the trail's, and
# have no row of their own.
tools() {
  tmux list-windows -a -F "#{window_id}${US}#{session_name}${US}#{@trails_tool}${US}#{@trails_dir}${US}#{@trails_ws}${US}#{@trails_label}${US}#{window_name}" 2>/dev/null |
    while IFS="$US" read -r wid sname kind dir ws label wname; do
      [ -n "$kind" ] && [ "$sname" = "$ws" ] || continue
      if [ -n "${1:-}" ]; then
        [ "$ws" = "$1" ] || continue
      else
        same_dir "$dir" "$PWD" || continue
      fi
      case $kind in
        shell) word=shell ;;
        *) word=editor ;;
      esac
      printf 'tool\ttool\t%s\t%s\t%s\t%s\t-\t-\t-\t%s\n' "$wid" "$dir" "$label" "$word" "${wname#*·}"
    done
}

# ─── Checklist ───────────────────────────────────────────────────────────────
# A codebase's checklist: what to do there next, and the prompts to give its agent, parked
# while the agent is busy, so the thought outlives the trail you had it in. A Markdown
# checklist in a file of its own, one per codebase, that any editor opens:
#
#   - [ ] Esc on the agents list should remember the cursor
#   - [x] Fix prefix P inside a trail
#
# Where it lives:
#
#   "data" in the config   <data>/trails/<path>/checklist.md: a folder of yours, a synced one
#                          (iCloud Drive) to have the same checklists on every machine. <path>
#                          names the codebase as Claude names a project, its root (a worktree's
#                          main checkout) from $HOME with every non-alphanumeric as -, so
#                          ~/code/api is code-api; one outside $HOME keeps its leading -.
#   neither                .trails/checklist.md in the codebase. trails writes the file
#                          and nothing else: whether it is committed or ignored is the repo's.
#   "notes" (before 1.7)   the path it gave, as it did: from the codebase's root, or ~ or
#                          absolute, with {codebase} for the codebase's label.
#
# A checklist left in the codebase is moved to where it lives now the first time it is opened
# or added to: one from before 1.7 (.scratch/trails/notes.md, or .scratch/trails/checklist.md
# from 1.7's first builds), or one from before "data" was set.
#
#   trails note TEXT    add TEXT as an item
#   trails checklist    the checklist (prefix N, from `trails keys`): a line to type a new
#                       item on, and the items under it, open ones first. Enter adds what
#                       was typed, or with nothing typed copies the item under the cursor;
#                       space ticks it done, or back (checklist_ui)
#   trails checklist --count   "☑ open/total " for the status line, nothing without items
CHECKLIST_DEFAULT=.trails/checklist.md
CHECKLIST_OLD=".scratch/trails/checklist.md .scratch/trails/notes.md"

# The config's "data" folder, ~ expanded, or nothing. Anything but a non-empty string is a typo,
# and reads as unset with a warning, as a bad mode does.
load_data_dir() {
  [ -f "$CONFIG" ] || return 0
  dd=$(jq -r 'if (.data | type) == "string" then .data elif .data == null then "" else "!" end' "$CONFIG" 2>/dev/null)
  # shellcheck disable=SC2088 # a literal ~ from the config, expanded here
  case $dd in
    '') ;;
    '!') echo "trails: data in $CONFIG is not a path; keeping each checklist in its codebase" >&2 ;;
    '~') printf '%s' "$HOME" ;;
    '~/'*) printf '%s' "$HOME/${dd#\~/}" ;;
    *) printf '%s' "$dd" ;;
  esac
}

# The pre-1.7 "notes" path, or nothing.
load_notes_path() {
  [ -f "$CONFIG" ] && jq -r 'if (.notes | type) == "string" then .notes else empty end' "$CONFIG" 2>/dev/null
}

# Codebase root $1 as a name, as Claude names a project's folder: from $HOME (so the same code
# has the same name on every machine), every non-alphanumeric as -, and a worktree by its main
# checkout's path, so a branch's items stay with its repository.
path_key() {
  pk_root=$1
  pk_common=$(git -C "$pk_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) &&
    case $pk_common in */.git) pk_root=${pk_common%/.git} ;; *) ;; esac
  case $pk_root in
    "$HOME") pk_rel= ;;
    "$HOME"/*) pk_rel=${pk_root#"$HOME"/} ;;
    *) pk_rel=$pk_root ;;
  esac
  pk=$(printf '%s' "$pk_rel" | sed 's/[^A-Za-z0-9]/-/g')
  printf '%s' "${pk:--}"
}

# The directory a note is about: in a shell, here; from a popup, the window of the terminal
# that opened it — a trail's window says its codebase, any other the directory of its pane;
# outside tmux, here.
note_where() {
  if [ -n "$TMUX" ] && [ -z "${TMUX_PANE:-}" ] && [ -n "$CLIENT" ]; then
    nw=$(tmux display-message -p -t "$CLIENT" "#{@trails_dir}${US}#{pane_current_path}" 2>/dev/null)
    nw_dir=${nw%%"$US"*} nw_path=${nw#*"$US"}
    printf '%s' "${nw_dir:-${nw_path:-$PWD}}"
    return 0
  fi
  printf '%s' "$PWD"
}

# An error, on stderr as ever, and in a popup also on tmux's message line for the terminal that
# opened it: a popup closes as its command exits, and prefix N's is one row high, so what it
# printed would go unread.
say_err() {
  echo "$1" >&2
  [ -n "$TMUX" ] && [ -z "${TMUX_PANE:-}" ] && tmux display-message ${CLIENT:+-c "$CLIENT"} "$1" 2>/dev/null
  return 0
}

# The codebase directory $1 is in: the repository's top, or the directory itself outside git.
codebase_root() {
  cr_dir=$1
  # Inside .git there is no work tree to find the top of: the repository is its parent.
  case $cr_dir in
    */.git) cr_dir=${cr_dir%/.git} ;;
    */.git/*) cr_dir=${cr_dir%%/.git/*} ;;
    *) ;;
  esac
  git -C "$cr_dir" rev-parse --show-toplevel 2>/dev/null || (cd "$cr_dir" 2>/dev/null && pwd -P) || printf '%s\n' "$cr_dir"
}

# The checklist file for directory $1 (see "Checklist" for where). One still in the codebase
# where the config now says otherwise, or under its pre-1.7 name, is moved the first time it is
# opened or added to; with $2 "look", only looked at (the status line's count), which reads it
# where it is.
checklist_file() {
  nf_root=$(codebase_root "$1")
  nf_data=$(load_data_dir)
  while :; do
    case $nf_data in
      ?*/) nf_data=${nf_data%/} ;;
      *) break ;;
    esac
  done
  if [ -n "$nf_data" ]; then
    nf_path=$nf_data/trails/$(path_key "$nf_root")/checklist.md
  else
    nf_path=$(load_notes_path)
    case $nf_path in
      '') nf_path=$CHECKLIST_DEFAULT ;;
      *'{codebase}'*)
        # As text: through ENVIRON and index, since -v eats a backslash and gsub reads & as the
        # match, and a codebase may be named R&D.
        nf_path=$(printf '%s' "$nf_path" | NF_LABEL=$(codebase_label "$nf_root") awk '
          { s = $0; out = ""; t = "{codebase}"
            while ((i = index(s, t)) > 0) { out = out substr(s, 1, i - 1) ENVIRON["NF_LABEL"]; s = substr(s, i + length(t)) }
            print out s }')
        ;;
      *) ;;
    esac
    # shellcheck disable=SC2088 # a literal ~ from the config, expanded here
    case $nf_path in
      '~') nf_path=$HOME ;;
      '~/'*) nf_path=$HOME/${nf_path#\~/} ;;
      /*) ;;
      *) nf_path=$nf_root/$nf_path ;;
    esac
  fi
  if [ ! -e "$nf_path" ]; then
    for nf_old in $CHECKLIST_DEFAULT $CHECKLIST_OLD; do
      nf_old=$nf_root/$nf_old
      [ "$nf_old" != "$nf_path" ] && [ -f "$nf_old" ] || continue
      if [ "${2:-}" = look ]; then
        nf_path=$nf_old
      else
        mkdir -p "$(dirname "$nf_path")" 2>/dev/null && mv "$nf_old" "$nf_path" 2>/dev/null
      fi
      break
    done
  fi
  printf '%s' "$nf_path"
}

# Add an item to checklist $1: $2 is its text. Its first line is the item, and any more are indented
# under it, so Markdown keeps them together. The file and its folder are made the first time,
# under a heading naming the codebase, $3.
note_add() {
  na_text=$(printf '%s\n' "$2" | awk '{ sub(/[ \t]+$/, "") } { l[NR] = $0 } END { while (NR > 0 && l[NR] == "") NR--; s = 1; while (s <= NR && l[s] == "") s++; for (i = s; i <= NR; i++) print l[i] }')
  [ -n "$na_text" ] || return 1
  # Status 2, and why, when the file can't be written: its folder can't be made, it is a
  # folder, or it is read-only.
  {
    [ ! -d "$1" ] && mkdir -p "$(dirname "$1")" &&
      { [ -s "$1" ] || printf '# %s: checklist\n\n' "$3" >"$1"; } &&
      # A file that doesn't end in a newline would weld the item onto its last line.
      { [ -z "$(tail -c 1 "$1")" ] || printf '\n' >>"$1"; } &&
      printf '%s\n' "$na_text" | awk 'NR == 1 { print "- [ ] " $0; next } { print ($0 == "" ? "" : "  " $0) }' >>"$1"
  } 2>/dev/null || {
    say_err "trails: can't write the checklist at $(tilde_path "$1")"
    return 2
  }
}

# Checklist $1 made, under a heading naming the codebase of directory $2, so an editor opens
# on a file, not a new buffer. Fails, said, when it can't be.
checklist_make() {
  [ -e "$1" ] && return 0
  { mkdir -p "$(dirname "$1")" &&
    printf '# %s: checklist\n\n' "$(codebase_label "$(codebase_root "$2")")" >"$1"; } 2>/dev/null || {
    say_err "trails: can't make the checklist at $(tilde_path "$1")"
    return 1
  }
}

# The checklist of directory $1 in $EDITOR.
checklist_open() {
  [ -d "${1:-$PWD}" ] || {
    say_err "trails: no such directory: ${1:-$PWD}"
    exit 1
  }
  co_file=$(checklist_file "${1:-$PWD}")
  checklist_make "$co_file" "${1:-$PWD}" || exit 1
  co_ed=${EDITOR:-nvim}
  command -v "${co_ed%% *}" >/dev/null 2>&1 || {
    say_err "trails: \$EDITOR is ${co_ed%% *}, which isn't installed — the checklist is in $(tilde_path "$co_file")"
    exit 1
  }
  # shellcheck disable=SC2086 # $EDITOR may carry its own arguments
  exec $co_ed "$co_file"
}

# An item is a line starting "- [ ] " or "- [x] " (or * for -, X for x) at the left margin;
# the lines indented under it are its own. Everything else in the file is left as it is.
#
# The items of checklist $1 as the list draws them, open ones first, each kept in file order:
#   line<TAB>☐ text      the line the item starts on, which the actions below are given
#   line<TAB>☑ text      done, dimmed
checklist_rows() {
  [ -f "$1" ] || return 0
  awk -v dim="$DIM" -v rst="$RST" -v tab="$TAB" '
    /^[-*] \[[ xX]\] / {
      done = substr($0, 4, 1) != " "
      t = substr($0, 7)
      if (done) d[++nd] = NR tab dim "☑ " t rst
      else o[++no] = NR tab "☐ " t
    }
    END { for (i = 1; i <= no; i++) print o[i]; for (i = 1; i <= nd; i++) print d[i] }' "$1"
}

# Tick the item on line $2 of checklist $1 done, or back to open. Only an item's own line:
# a number that has since become some other line (an edit in between) is left alone. Written
# back into the file, not moved over it, so a checklist that is a link stays one.
checklist_toggle() {
  [ -f "$1" ] || return 0
  ct_tmp="$1.tmp.$$"
  awk -v n="$2" '
    NR == n && /^[-*] \[ \] / { print substr($0, 1, 3) "x" substr($0, 5); next }
    NR == n && /^[-*] \[[xX]\] / { print substr($0, 1, 3) " " substr($0, 5); next }
    { print }' "$1" >"$ct_tmp" && cat "$ct_tmp" >"$1"
  rm -f "$ct_tmp"
}

# The text of the item on line $2 of checklist $1: its own line without the box, then the
# lines indented under it, unindented.
checklist_text() {
  [ -f "$1" ] || return 0
  awk -v n="$2" '
    NR == n { if (!/^[-*] \[[ xX]\] /) exit; print substr($0, 7); on = 1; next }
    on && /^  / { printf "%s", blank; blank = ""; print substr($0, 3); next }
    on && /^$/ { blank = blank "\n"; next }
    on { exit }' "$1"
}

# Copy the item on line $2 of checklist $1: to tmux's buffer and, through it, the terminal's
# clipboard (set-buffer -w, OSC 52 where tmux's set-clipboard allows it, over ssh too); outside
# tmux, to the system's clipboard where there is a command for one.
checklist_copy() {
  cc_text=$(checklist_text "$1" "$2")
  [ -n "$cc_text" ] || return 0
  if [ -n "$TMUX" ]; then
    printf '%s' "$cc_text" | tmux load-buffer -w - 2>/dev/null
    tmux display-message ${CLIENT:+-c "$CLIENT"} "trails: copied" 2>/dev/null
  elif command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$cc_text" | pbcopy
  elif command -v wl-copy >/dev/null 2>&1; then
    printf '%s' "$cc_text" | wl-copy
  elif command -v xclip >/dev/null 2>&1; then
    printf '%s' "$cc_text" | xclip -selection clipboard
  else
    printf '%s\n' "$cc_text"
  fi
}

# For the status line: "☑ open/total " for the checklist of directory $1, nothing when it has
# no items. Read on tmux's status-interval, so it does no more than count.
checklist_count() {
  [ -d "${1:-}" ] || return 0
  cn_file=$(checklist_file "$1" look)
  [ -f "$cn_file" ] || return 0
  awk '/^[-*] \[[ xX]\] / { n++; if (substr($0, 4, 1) == " ") o++ } END { if (n) printf "☑ %d/%d ", o, n }' "$cn_file"
}

# Whether this fzf takes one of the newer options the lists use, asked of fzf itself (it exits
# 2 on an option it doesn't know) once per run: a distribution's older fzf still runs every
# list, with the hint in a header instead of beside the prompt, a preview that is a snapshot,
# and plain wrapping.
fzf_ok() {
  eval "fo_v=\${FZF_OK_$1:-}"
  if [ -z "$fo_v" ]; then
    case $1 in
      ghost) fo_o=--ghost=x ;;
      wrapword) fo_o=--preview-window=wrap-word ;;
      listen) fo_o="--listen=${TMPDIR:-/tmp}/trails-probe-$$.sock" ;;
      printquery) fo_o=--bind=enter:accept-or-print-query ;;
      transform) fo_o='--bind=space:transform:true' ;;
      *) fo_o=--info-command=true ;;
    esac
    fo_v=no
    # Without the test fzf's variables: a probe is no list a test drove.
    FZF_DUMP='' FZF_PICKS='' FZF_PICK='' FZF_KEYS='' FZF_KEY='' fzf "$fo_o" --filter=x </dev/null >/dev/null 2>&1 || [ $? -ne 2 ] && fo_v=yes
    eval "FZF_OK_$1=$fo_v"
  fi
  [ "$fo_v" = yes ]
}

# A list's keys, as one fzf option: beside the prompt where fzf can put them there, else a
# header line.
hint_opt() {
  if fzf_ok infocmd; then
    printf "%s" "--info-command=echo '$1'"
  else
    printf "%s" "--header=$1"
  fi
}

# fzf draws every list trails offers and the note line; without it, say so and how to get it,
# rather than have the shell say "fzf: command not found" and trails exit as if all were well.
need_fzf() {
  command -v fzf >/dev/null 2>&1 && return 0
  say_err "trails: needs fzf for its lists — brew install fzf (or apt install fzf)"
  exit 1
}

# The checklist of directory $1, as one fzf: its input line is where a new item is typed (search
# is off, so typing never filters the items away), and the items are under it. No shortcuts to
# learn, only what the input line holds:
#
#   ↑ ↓           move through the items
#   space         tick the item under the cursor done, or back, while nothing is typed;
#                 a space in what you type once something is (tab on an fzf too old to ask)
#   enter         add what was typed; with nothing typed, copy the item under the cursor and
#                 close, to paste it into the agent
#   ctrl-e        the file in $EDITOR
#   esc           close
#
# fzf runs its bindings' commands through $SHELL, here sh: a login shell's zsh would expand a
# path's = or ~ in ways sh doesn't.
checklist_ui() {
  need_fzf
  cu_dir=$1
  cu_file=$(checklist_file "$cu_dir")
  cu_label=$(codebase_label "$(codebase_root "$cu_dir")")
  cu_f=$(shq "$cu_file") cu_self=$(shq "$SELF")
  cu_tick="execute-silent($cu_self checklist --toggle $cu_f {1})+reload($cu_self checklist --rows $cu_f)"
  if fzf_ok transform; then
    cu_tick_key="space:transform:[ -z {q} ] && echo \"$cu_tick\" || echo 'put( )'"
    cu_hint="type a new item · ↑↓ to one: space ticks it, enter copies it · ctrl-e: edit · esc: close"
  else
    cu_tick_key="tab:$cu_tick"
    cu_hint="type a new item · ↑↓ to one: tab ticks it, enter copies it · ctrl-e: edit · esc: close"
  fi
  # The keys as ghost text in the empty input line, gone once you type; a header on an fzf
  # without it.
  if fzf_ok ghost; then cu_hint="--ghost=$cu_hint"; else cu_hint="--header=$cu_hint"; fi
  # A row is one line, cut to the popup's width; the pane under the list has the item under the
  # cursor whole, wrapped, with the lines under it. Nothing over an empty list, whose {1} is empty.
  cu_pane="$cu_self checklist --text $cu_f {1}"
  cu_wrap=wrap
  fzf_ok wrapword && cu_wrap=wrap-word
  # Enter prints what was typed and the row under the cursor, even over an empty list; an fzf
  # without accept-or-print-query does as much with accept, which --print-query makes print the
  # query too, and an empty list's no-match exits 1, as an abort does not.
  cu_enter=accept
  fzf_ok printquery && cu_enter=accept-or-print-query
  cu_out=$(checklist_rows "$cu_file" |
    SHELL=/bin/sh fzf --disabled --print-query --expect=ctrl-e --reverse --ansi --no-sort --no-separator --no-info \
      --delimiter="$TAB" --with-nth=2.. --prompt="Checklist for $cu_label ▸ " "$cu_hint" \
      --preview="$cu_pane" --preview-window="down,50%,$cu_wrap,border-top" \
      --bind="enter:$cu_enter" --bind="$cu_tick_key") ||
    [ $? -eq 1 ] || return 0
  cu_query=$(printf '%s\n' "$cu_out" | sed -n 1p)
  cu_key=$(printf '%s\n' "$cu_out" | sed -n 2p)
  cu_pick=$(printf '%s\n' "$cu_out" | sed -n 3p)
  if [ "$cu_key" = ctrl-e ]; then
    # In prefix N's popup the file gets a popup of its own, sized for an editor, opened on the
    # same terminal once this one has closed: a client shows one popup at a time.
    if [ -n "$TMUX" ] && [ -z "${TMUX_PANE:-}" ]; then
      cu_bg=$(popup_bg)
      tmux run-shell -b "sleep 0.2; tmux -S $(shq "${TMUX%%,*}") display-popup ${CLIENT:+-c $(shq "$CLIENT")} -E -w 80% -h 80% -s bg=$cu_bg -S bg=$cu_bg,fg=brightblack $(shq "$cu_self checklist --edit $(shq "$cu_dir")")"
      return 0
    fi
    checklist_open "$cu_dir"
  fi
  if [ -z "$(printf '%s' "$cu_query" | tr -d ' \t')" ]; then
    [ -z "$cu_pick" ] || checklist_copy "$cu_file" "${cu_pick%%"$TAB"*}"
    return 0
  fi
  note_add "$cu_file" "$cu_query" "$cu_label" || exit 1
  [ -z "$TMUX" ] || tmux refresh-client -S ${CLIENT:+-t "$CLIENT"} 2>/dev/null
}

# $1 single-quoted for a shell command line, its own single quotes and all.
shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# `trails note [TEXT]`: TEXT as an item on this codebase's checklist; without it, the checklist.
note_cmd() {
  nc_dir=$(note_where)
  if [ $# -eq 0 ]; then
    checklist_cmd
    return
  fi
  nc_file=$(checklist_file "$nc_dir")
  nc_label=$(codebase_label "$(codebase_root "$nc_dir")")
  note_add "$nc_file" "$*" "$nc_label" || {
    [ $? -eq 2 ] || say_err "trails: nothing to note"
    exit 1
  }
  echo "trails: noted in $(tilde_path "$nc_file")"
  [ -z "$TMUX" ] || tmux refresh-client -S 2>/dev/null
  return 0
}

# `trails checklist [DIR]`, and the list's own actions: --rows, --toggle, --copy and --text FILE LINE,
# --count DIR for the status line, --edit DIR.
checklist_cmd() {
  case ${1:-} in
    --rows) checklist_rows "$2" ;;
    --toggle)
      checklist_toggle "$2" "$3"
      [ -z "$TMUX" ] || tmux refresh-client -S 2>/dev/null
      ;;
    --copy) checklist_copy "$2" "$3" ;;
    --text) [ -z "${3:-}" ] || checklist_text "$2" "$3" ;;
    --count) checklist_count "${2:-}" ;;
    --edit) checklist_open "${2:-$(note_where)}" ;;
    -*)
      echo "trails: checklist takes a directory, or nothing for this codebase's" >&2
      exit 1
      ;;
    *)
      [ -d "${1:-.}" ] || {
        say_err "trails: no such directory: $1"
        exit 1
      }
      [ -t 0 ] || {
        echo "trails: checklist needs a terminal; trails note TEXT adds an item from a script" >&2
        exit 1
      }
      checklist_ui "${1:-$(note_where)}"
      ;;
  esac
}

# ─── The diff ────────────────────────────────────────────────────────────────
# `trails diff [DIR]`: a codebase's changes, side by side, to read what an agent did. prefix G
# (trails keys) shows them in a popup over the workspace, since side by side wants the
# width; from a shell it is the terminal itself.
#
# The codebase is the one `trails edit` would pick: DIR; else the window you are on, a trail's
# window naming its codebase; else the pane's directory; else $PWD. The changes are the
# working tree against HEAD, staged or not, and the untracked files, each against /dev/null:
# agents make new files, and a plain git diff leaves them out. Nothing is staged to show them.
#
# The config's "diff" is what reads them, run in the codebase: a command the diff is piped to,
#
#   "diff": "delta --side-by-side --paging=always"
#
# which is the default when delta is installed (else less), and which should page, since the
# popup closes when it exits; or a program that finds the changes itself, run in the popup,
# in the codebase, with nothing piped to it (an editor's diff view):
#
#   "diff": { "command": "nvim -c 'CodeDiff --exit-on-close'", "pipe": false }
#
# or a program with a window of its own, run instead, with no popup opened:
#
#   "diff": { "command": "fork status", "gui": true }
#
# diff_cfg prints which, then the command: pipe, run or gui, a tab between.
diff_cfg() {
  dc=
  [ -f "$CONFIG" ] && dc=$(jq -r '.diff | if type == "string" then "pipe\t" + .
    elif type == "object" then
      (if .gui == true then "gui" elif .pipe == false then "run" else "pipe" end) + "\t" + (.command // "" | tostring)
    else empty end' "$CONFIG" 2>/dev/null)
  case $dc in
    *"$TAB"?*) printf '%s' "$dc" ;;
    *)
      if command -v delta >/dev/null 2>&1; then
        printf 'pipe\tdelta --side-by-side --paging=always'
      else
        printf 'pipe\t'
      fi
      ;;
  esac
}

diff_dir() {
  dd=${1:-}
  if [ -z "$dd" ] && [ -n "$TMUX" ]; then
    dd_at=${TMUX_PANE:-$CLIENT}
    # shellcheck disable=SC2086 # the -t and its target are two words on purpose
    dd=$(tmux display-message -p ${dd_at:+-t "$dd_at"} '#{?@trails_dir,#{@trails_dir},#{pane_current_path}}' 2>/dev/null)
  fi
  dd=${dd:-$PWD}
  [ -d "$dd" ] || {
    echo "trails: no such directory: $dd" >&2
    return 1
  }
  printf '%s' "$dd"
}

# The changes in $1, through the config's command; in a popup ($2 set), a word before it
# closes on anything that has nothing to page.
diff_show() {
  cd "$1" || exit 1
  ds_hold() { [ -z "${2:-}" ] || { printf '\npress enter to close'; read -r _; }; }
  git rev-parse --git-dir >/dev/null 2>&1 || {
    echo "trails: $(tilde_path "$1") isn't a git repository"
    ds_hold "$@"
    exit 1
  }
  ds_cfg=$(diff_cfg)
  ds_cmd=${ds_cfg#*"$TAB"}
  # A program that finds the changes itself is only started when there are some.
  if [ "${ds_cfg%%"$TAB"*}" = run ]; then
    if [ -z "$(git status --porcelain 2>/dev/null)" ]; then
      echo "No changes in $(tilde_path "$1")."
      ds_hold "$@"
      exit 0
    fi
    exec sh -c "$ds_cmd"
  fi
  ds_color=--color=always
  [ -n "$ds_cmd" ] && ds_color=--no-color
  ds_base=HEAD
  git rev-parse -q --verify HEAD >/dev/null || ds_base=$(git hash-object -t tree /dev/null)
  ds=$({
    git diff "$ds_color" "$ds_base"
    # shellcheck disable=SC2016 # $1 is the inner shell's: the file xargs hands it
    git ls-files --others --exclude-standard -z |
      xargs -0 -n 1 sh -c 'git diff '"$ds_color"' --no-index -- /dev/null "$1"; :' _
  } 2>/dev/null)
  if [ -z "$ds" ]; then
    echo "No changes in $(tilde_path "$1")."
    ds_hold "$@"
    exit 0
  fi
  if [ -n "$ds_cmd" ]; then
    printf '%s\n' "$ds" | sh -c "$ds_cmd"
  else
    printf '%s\n' "$ds" | less -R
  fi
}

diff_cmd() {
  dir=$(diff_dir "${1:-}") || exit 1
  dcfg=$(diff_cfg)
  if [ "${dcfg%%"$TAB"*}" = gui ]; then
    (cd "$dir" && sh -c "${dcfg#*"$TAB"}") >/dev/null 2>&1
    exit 0
  fi
  # From prefix G, a run-shell job, with no terminal of its own: a popup on the one that pressed it.
  if [ -n "$TMUX" ] && [ -z "${TMUX_PANE:-}" ] && [ -n "$CLIENT" ]; then
    dbg=$(popup_bg)
    exec tmux display-popup -c "$CLIENT" -E -w 90% -h 90% -d "$dir" -s "bg=$dbg" -S "bg=$dbg,fg=brightblack" \
      -T " $(codebase_label "$dir") " "$(shq "$SELF") diff --show $(shq "$dir")"
  fi
  diff_show "$dir"
}

# ─── Keys ────────────────────────────────────────────────────────────────────
# trails binds nothing (principle 2 of the design). `trails keys` prints lines for a
# tmux.conf, to paste or ignore, or to load whole with the one run-shell line it opens with:
# the picker, the workspace picker and every running trail in a popup, which leaves no
# window behind, the editor and the shell, a note in a popup, the previous and next
# workspace, the map, the diff, and the workspaces and the map at the status line's left.
# P, W, A, e, `, N and G are free in tmux 3.8's default prefix table (p is previous-window, T
# pane title, E even layout, n next-window, g and D taken, so none of those); P for "pick a
# trail", A for all trails, ` for the shell because that is the editors' own toggle-terminal
# key, N for a note, G for the git diff. ? takes tmux's own list of every binding (still
# :list-keys) for trails' keys alone. ( and ) take tmux's cycling through every session, each
# trail's own among them, for the workspaces alone; M takes clearing the marked pane, which
# prefix m on it still does, for the map.
#
# By this script's own absolute path, not a bare `trails`: run-shell and display-popup run
# with the server's PATH, which a server started by launchd or over ssh may not share with
# your shell, and a bare name would then find nothing, or an older trails. The run-shell
# lines pass the client that pressed the key (TRAILS_CLIENT, see CLIENT above): run-shell
# expands formats, so #{client_name} is exact where tmux's own guess picks the most recently
# active client, which with two terminals on one workspace is sometimes the other one.
#
# The popups take the terminal's own background (-s and -S, tmux 3.3). tmux 3.8 shades a
# popup grey by default (popup-style bg=themedarkgrey; gray45 when the terminal says it is
# light, as Ghostty does over a black window), and a list drawn in dim text on that grey is
# hard to read. brightblack for the frame: a mid grey in every palette, on dark or light.
#
# Is this tmux version $1.$2 or later? A development build (next, master) is.
tmux_at_least() {
  case $(tmux -V 2>/dev/null) in
    "tmux next"* | "tmux master"*) return 0 ;;
    "tmux "*)
      kv=$(tmux -V | sed 's/^tmux //; s/[^0-9.].*$//')
      kmaj=${kv%%.*} kmin=${kv#*.}
      case $kmin in '' | *.*) kmin=0 ;; esac
      [ "${kmaj:-0}" -gt "$1" ] 2>/dev/null || { [ "${kmaj:-0}" -eq "$1" ] && [ "${kmin:-0}" -ge "$2" ]; } 2>/dev/null
      ;;
    *) return 1 ;;
  esac
}

# The colour that means "the terminal's own" depends on the tmux: in a style, bg=default
# means the *base* style's background, which for a popup is popup-style itself — so on
# 3.8 it keeps the grey. 3.8 added bg=terminal for the real thing, and a tmux before it
# rejects the word (a bad style, and no popup), while its popup-style was plain default,
# so bg=default was the terminal's there. Hence the version check: this prints for the
# tmux it runs under, and a tmux upgrade past 3.8 wants the lines pasted again.
popup_bg() {
  tbg=default
  ! tmux_at_least 3 8 || tbg=terminal
  printf '%s' "$tbg"
}

keys() {
  tbg=$(popup_bg)
  # trails' path quoted for the shell that runs it, then its backslashes doubled for tmux's
  # own double quotes: a path with a space or a ' still runs.
  kq=$(shq "$SELF" | sed 's/\\/\\\\/g')
  # A popup closes the moment its command exits, so a refusal printed on the way out would go
  # unread: on a failure the picker's and the workspaces' popups wait for Enter.
  khold='|| { echo; echo press enter to close; read -r _; }'
  # The running workspaces at the status line's left, then the map while one is up, the one you
  # are on in reverse video, apart from the window you are on, which tmux underlines. tmux draws
  # it (#{S/n:} over the sessions marked @trails_workspace) and a click switches (range=session,
  # which tmux's own MouseDown1Status acts on). A session grouped with a workspace's,
  # <workspace>~N, counts as that workspace.
  kws='#{S/n:#{?@trails_workspace,#[range=session|#{session_id}]#{?#{||:#{==:#{session_name},#{client_session}},#{m:#{session_name}~*,#{client_session}}},#[reverse] #{session_name} #[noreverse], #{session_name} }#[norange],}}'
  # Then the map, while one is up (its session carries @trails_map): after the workspaces,
  # by a loop of its own, so a name never sorts it in among them.
  # tmux before 3.6 has no /n and prints it as text, but its plain #{S:} lists by name already;
  # from 3.6 #{S:} lists in the order they were made, and /n sorts. Asked of the version, not
  # with %if: the keys are read at tmux's start, before there is a session to test #{S/n:} on.
  tmux_at_least 3 6 || kws="#{S:${kws#'#{S/n:'}"
  kws="$kws"'#{S:#{?@trails_map,#[range=session|#{session_id}]#{?#{==:#{session_name},#{client_session}},#[reverse] ▦ map #[noreverse], ▦ map }#[norange],}}'
  cat <<EOF
# trails: one line in tmux.conf loads all of these, and follows every upgrade:
#   run-shell "$kq keys | tmux source-file -"
# or paste what you want of them instead.
# Opt-in, not loaded with the rest: put this in tmux.conf to bring back, whenever tmux starts,
# the trails it lost (a reboot, a crash). To drop one for good, ctrl-x on its lost row.
# run-shell -b "$kq restore >/dev/null 2>&1"
bind P display-popup -E -w 60% -h 70% -s bg=$tbg -S bg=$tbg,fg=brightblack "$kq $khold"
bind W display-popup -E -w 60% -h 50% -s bg=$tbg -S bg=$tbg,fg=brightblack "$kq ws $khold"
bind e run-shell "TRAILS_CLIENT=#{client_name} $kq edit"
bind \` run-shell "TRAILS_CLIENT=#{client_name} $kq shell"
bind N display-popup -E -w 70% -h 50% -s bg=$tbg -S bg=$tbg,fg=brightblack "$kq checklist"
bind ( run-shell "TRAILS_CLIENT=#{client_name} $kq ws prev"
bind ) run-shell "TRAILS_CLIENT=#{client_name} $kq ws next"
bind M run-shell "TRAILS_CLIENT=#{client_name} $kq map here"
bind A display-popup -E -w 70% -h 70% -s bg=$tbg -S bg=$tbg,fg=brightblack "env TRAILS_PICKER=all $kq $khold"
bind G run-shell "TRAILS_CLIENT=#{client_name} $kq diff"
bind ? run-shell "TRAILS_CLIENT=#{client_name} $kq --keys"
set -g status-left-length 60
set -g status-right "#($kq checklist --count '#{?@trails_dir,#{@trails_dir},#{pane_current_path}}')%H:%M "
set -g status-left "${kws}│ "
EOF
}

# ─── Map ─────────────────────────────────────────────────────────────────────
# Several agents at once, in one window. The picker answers "what do I open here" and
# `trails ls` answers "who wants me"; this is the third question — watch four of them work,
# and answer whichever one stops, without leaving the window.
#
# Every pane is a tmux client attached to a live trail's session: the map *borrows* the
# session, it does not take the pane. That is the whole design, and the reason to prefer it
# over join-pane, which is the obvious other way to get four agents into one window.
# join-pane *moves* a pane, so trails-foo would stop being a session — and sessions are
# what sessions(), list_sessions() and everything reading `trails ls` ask tmux about, so all would go
# blind at once. A map that died mid-flight would leave the agents merged into a
# session none of them chose, with no way back but hand-run break-pane.
#
# Borrowed, the map owns nothing, so it can lose nothing: kill it, close the window,
# crash it, and every agent is where it was — still running, still attached to whatever
# else was viewing it. That is also why this never reuses a map. Rebuilding is free
# when there is no state to keep, so `trails map` always builds a fresh one rather
# than reconciling an old one against a new pick.
#
# Not $PWD-scoped, for `trails ls -a`'s reason: the picker asks what is running *here*, the
# map asks what is running *at all*.
#
# What it costs, and it is not nothing. A tmux window has one grid, so a session two
# clients of different shapes are watching cannot be right for both — that is not a thing
# to fix, only a thing to point somewhere. window-size is left at its default `latest`,
# which points it at the most recently *used* client, not the newest one: whichever client
# you last typed in wins, so the session you are working in is always the correct one and the
# other is the one that pays. That is the behaviour worth having, and it is why no attempt
# is made to be cleverer here.
#
# What the other one pays is a re-flow. Any *other* window
# viewing that agent — a Zed thread, an nvim panel — draws it small in the corner until
# you press a key there, which re-elects it and snaps it back (measured: 200x49 ↔ 180x44
# across a keypress, either way). The state is untouched: it comes from the agent's hooks
# and files, not its screen (ADR 18), so a re-flow reads as nothing.
#
# `-f ignore-size` on the pane clients is the other end of the lever and was measured too:
# it holds the agent at the other client's size, keeps typing (it is not read-only, which
# is a separate flag), and falls back to the map's own size when nothing else is
# looking. It is not used because it only moves the dead space into the map pane —
# a session Zed holds at 114x84 renders into a 181x45 pane as 114 columns of agent and 67
# of nothing. Neither end is free, and the active view is the better one to keep whole.

# One name, so exactly one map — a decision, not an oversight, and the difference
# matters because the fix for it is sitting right there in this file. next_session() gives
# agent sessions their -2 because each holds a live conversation that cannot be recreated:
# ~/a/foo and ~/b/foo both want trails-foo, neither can yield, so they coexist. A map
# holds nothing, so that pressure has no counterpart here — nothing collides, because
# there is nothing to lose. Reaching for next_session() when a second map "collides"
# would be solving a problem the design does not have, and would cost the thing a fixed
# name buys: the map is a *place*. `tmux a -t trails_map` finds it forever, and re-running
# builds over it. Two of them and you are tracking which is which, which is bookkeeping —
# for the one thing here whose whole point is that it needs none.
#
# The axis that scales is panes, not maps: eight agents is `trails map 8`, not two
# maps of four. Two monitors would be the honest reason to want a second, and a map
# you keep *while* building another would be a better one — but that second is a saved view,
# which is state, and state is exactly what this does not have and should not grow lightly.
#
# The cost lands on kill-session in map(): a window already sitting in the old map
# has its `tmux attach` exit under it and drops back to a shell. Measured, and in the README,
# because it is the one part of "re-running is free" that is not free. The agents are
# untouched — they always are.
MAP=trails_map

# This is the one session the script kills without asking, so be sure it is ours first.
# @trails_map is the marker, stamped at build; a session you named `trails_map` yourself has no
# marker and gets refused rather than reaped. display-message rather than show-options -t,
# and no "=": display-message silently answers nothing for an =exact target.
is_map() {
  [ "$(tmux display-message -pt "$MAP" '#{@trails_map}' 2>/dev/null)" = 1 ]
}

# Are we in a shell pane of the map itself — one you split off with C-b | to start
# or pick an agent from? Inside tmux the picker normally runs the agent bare in the
# current pane (USE_TMUX is off), and here that would be wrong in every way that matters:
# no trails- session, so status, the notifier and the picker cannot see it, and the next
# `trails map new` kills it along with the session it is squatting in. The map
# owns nothing, and an agent living inside it would be the one thing it owned.
#
# So the dispatch turns USE_TMUX back on here and the agent gets a real session like
# anywhere else; attach_to then turns this pane into a sessioner of it, so the split you made
# becomes the new map pane. Asked by $TMUX_PANE, not the current client: the shell may
# be in a map window you are not looking at.
in_map() {
  [ -n "$TMUX" ] && [ -n "$TMUX_PANE" ] || return 1
  [ "$(tmux display-message -pt "$TMUX_PANE" '#{session_name}' 2>/dev/null)" = "$MAP" ] &&
    is_map
}

# fzf's preview: the agent's own screen. It is what makes a name pickable — "trails-foundry"
# is a name, the screen tells you it is sat on a permission prompt. -e keeps the colours.
# A trail's screen as it is now, without the blank rows under its last line: the preview
# follows the bottom, and those would push the text off it. Blank is judged without colour.
# The screen is as wide as the trail's window, which the terminal that last typed in it sets
# (window-size latest): wider than the preview, its lines wrap there (wrap-word), and a rule
# drawn across the whole screen is redrawn the preview's width ($FZF_PREVIEW_COLUMNS) rather
# than wrapping into a second rule. Narrower, it keeps its width: the agent drew it so.
peek() {
  # Only a running trail: a window id (the picker's rows), or a trail's session by its exact
  # name (the map's). tmux reads "-", the target of a row that is no trail, as the last window,
  # and a name that is gone as the first session it prefixes, both some other trail's screen.
  case $1 in
    @*) pk=$1 ;;
    */*)
      tmux has-session -t "=$1" 2>/dev/null || return 0
      pk="=$1:"
      ;;
    *) return 0 ;;
  esac
  tmux capture-pane -pet "$pk" 2>/dev/null | awk -v w="${FZF_PREVIEW_COLUMNS:-0}" '
    BEGIN { rule = ""; for (i = 0; i < w; i++) rule = rule "─" }
    { line = $0; plain = $0; gsub(/\033\[[0-9;:]*[A-Za-z]/, "", plain) }
    plain ~ /^[[:space:]]*$/ { held = held line "\n"; next }
    w > 0 && plain ~ /^(─)+[[:space:]]*$/ { c = plain; if (gsub(/─/, "", c) > w) line = "\033[2m" rule "\033[0m" }
    { printf "%s%s\n", held, line; held = "" }'
}

# Keep a picker's preview current: once a second, ask the fzf listening on socket $1 to run
# its preview again (refresh-preview), so it follows the agent as it works. Runs in the
# background until the socket's directory goes (the picker's own, removed as it ends), and
# prints its pid for the picker to stop it sooner. curl is how fzf's --listen is spoken to;
# the caller checks for it.
preview_ticker() {
  (
    while [ -d "${1%/*}" ]; do
      sleep 1
      [ -S "$1" ] && curl -s --max-time 1 --unix-socket "$1" -X POST http://fzf -d refresh-preview >/dev/null 2>&1
    done
  ) </dev/null >/dev/null 2>&1 &
  printf '%s' "$!"
}

# What a map pane runs: one tmux client, attached to one trail's session. Written once
# because both callers (new-session for the first pane, split-window for the rest) need the
# same two non-obvious things, and either one missed is silent.
#
# The quotes around the '=' are for zsh, not tmux. tmux runs a pane's command through
# $SHELL, where a bare leading `=` expands to a command path — the same trap that made the
# picker internals above subcommands. Unquoted, every pane dies on arrival with
# "=trails-foo not found" and the map comes up empty.
#
# env -u TMUX because tmux sets $TMUX in every pane it creates and refuses to nest while it
# is set. Clearing it is the supported way in: the inner client is an ordinary client that
# happens to have a pane for a terminal. Truecolor and CSI-u both survive the nest and need
# nothing added to tmux.conf — tmux negotiates RGB with the outer tmux at runtime rather
# than trusting tmux-256color's terminfo (which declares neither), and extended-keys is a
# server option, so it is already true of the inner client and Shift+Enter reaches the agent.
attach_cmd() { printf "env -u TMUX tmux attach -t '=%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# The config's "map" block, one key: `map_pref two`, `map_pref layout`. Empty when unset.
map_pref() {
  [ -f "$CONFIG" ] || return 0
  jq -r --arg k "$1" '.map[$k] // empty | if type == "string" then . else empty end' "$CONFIG" 2>/dev/null
}

# The directory a map pane's agent works in — its session_path basename, frozen at launch. Stamped onto the pane as @dir so the border can lead
# with it (see the pane-border-format below). Not folded into TRAIL_TITLE, which is where
# "claude · <task>" comes from: that is also the title of a terminal attached to the trail's
# session, and the directory is wanted in the map grid only.
# Static, unlike the task half — a session's directory cannot change — so it is set once at
# build and never goes stale, where #{pane_title} stays live for the task.
# No "=" on the -t: display-message silently answers nothing for an =exact target (the
# display-message trap above), so "=$1" would hand basename an empty string and every pane
# would get a blank @dir. The name comes straight from a live list, so an unanchored match
# still lands on it exactly.
map_dir() { basename "$(tmux display-message -pt "$1" '#{session_path}' 2>/dev/null)"; }

# The agent name for a map pane, stamped as @ag so the border can tell a real task from
# the title-less fallback. Before an agent publishes a task, TRAIL_TITLE
# falls back to "#{@agent} · #{b:pane_current_path}" — i.e. "claude · <dir>" — so the border
# would read "<dir> · claude · <dir>", the directory twice. The border composes that same
# fallback string from @ag and @dir and, on a match, drops the task half (see below). Same
# no-"=" rule as map_dir, and same source, so @agent is the value launch() wrote.
map_agent() { tmux display-message -pt "$1" '#{@agent}' 2>/dev/null; }

# Every agent on the box, ranked most-wants-you first. The rank is the same blocked/idle/
# working sort list_sessions() and live_trails() use, so pane 1 of the grid is always the one
# to look at first.
#
# Each row shows its trail's key — lattiq/augur-2 — since box-wide the codebase and the
# workspace are what tell trails apart.
map_menu() {
  sessions | classify | while IFS="$TAB" read -r state _wid key _ws label _dir _cb _badge task; do
    rank_dot "$state"
    [ -n "$task" ] && task="  $task"
    # Sort key up front, stripped after — leaving the key, then what fzf draws.
    printf '%s\t%s\t%s● %-9s%s  %s · %s%s\n' \
      "$rank" "$key" "$dot" "$word" "$RST" "$label" "$key" "$task"
  done | sort | cut -f2-
}

# ─── The map, a key away ─────────────────────────────────────────────────────
# prefix M (`trails map here`): to the map, which the status line lists beside the
# workspaces as ▦ map; or, with no map up, or on the map already, its pick in a popup on the
# terminal that pressed it (a run-shell job has no terminal of its own) — up to four trails
# from every workspace, the four that most want you ticked. The pick builds the map as
# `trails map new` does, and moves that terminal to it.
map_here() {
  [ -n "$TMUX" ] || {
    echo "trails: map here is prefix M's, inside tmux — trails map works outside it" >&2
    exit 1
  }
  mh_on=$(tmux display-message -p ${CLIENT:+-t "$CLIENT"} '#{session_name}' 2>/dev/null)
  if is_map && [ "$mh_on" != "$MAP" ]; then
    switch_to "=$MAP"
  fi
  mh_bg=$(popup_bg)
  exec tmux display-popup ${CLIENT:+-c "$CLIENT"} -E -w 70% -h 60% \
    -s "bg=$mh_bg" -S "bg=$mh_bg,fg=brightblack" \
    "env TRAILS_CLIENT=$(shq "$CLIENT") $(shq "$SELF") map new"
}

map() {
  # The argument first, so a typo is named as one whatever is running; a count of more than
  # three digits is no grid.
  case ${1:-} in
    '' | new) ;;
    *[!0-9]* | 0 | 0* | ????*)
      echo "trails: map takes a number of agents (1 or more), 'new' or 'here', not '$1'" >&2
      exit 1
      ;;
    *) ;;
  esac
  command -v tmux >/dev/null 2>&1 || {
    echo "trails: map needs tmux" >&2
    exit 1
  }
  if tmux has-session -t "=$MAP" 2>/dev/null && ! is_map; then
    echo "trails: a tmux session named '$MAP' is already here and is not ours" >&2
    echo "        rename it (tmux rename-session -t $MAP <name>) and retry" >&2
    exit 1
  fi

  # Bare `trails map` means "take me to my map": if one is already up, go there
  # rather than making you re-pick and rebuilding it. The guard above has established that
  # any session named $MAP is ours, so has-session alone is enough here. `trails map
  # new` skips this to force a fresh pick (it is non-empty, so the -z test is false), and
  # `trails map N` likewise rebuilds — both keep the stateless "re-running is free"
  # contract; this only spares you the rebuild when you did not ask for one. switch-client
  # inside tmux, attach outside — the same fork the build path ends on.
  if [ -z "${1:-}" ] && tmux has-session -t "=$MAP" 2>/dev/null; then
    [ -z "$TMUX" ] || switch_to "=$MAP"
    exec tmux attach-session -t "=$MAP"
  fi

  rows=$(map_menu)
  [ -n "$rows" ] || {
    echo "trails: no trails running" >&2
    exit 1
  }

  # `trails map N` takes the N that most want you and skips the picker — the rows are
  # already sorted blocked, idle, working, so "the top N" is "the N worth looking at".
  # `trails map new` opens the picker; bare `trails map` only reaches here when no
  # map was up to attach to (the block above returns otherwise), so it opens the picker
  # too. Both arrive at the same list of names, and fzf --multi returns them in list order,
  # so the grid stays in wants-you order.
  case ${1:-} in
    '' | new)
      need_fzf
      # Four at most, the four that most want you ticked: a 2x2 grid is as many as read well.
      # The whole terminal or popup, the preview every row the list leaves (the prompt, the
      # line under it, the header, a row each, the preview's border), as the picker's: a
      # share of it left blank rows, and a row short hid the last trail under the preview.
      mrows=$(stty size </dev/tty 2>/dev/null | cut -d' ' -f1)
      case $mrows in
        '' | *[!0-9]*) mrows=0 ;;
        *) ;;
      esac
      mpv=$((mrows - 4 - $(printf '%s\n' "$rows" | wc -l)))
      [ "$mpv" -ge 10 ] || mpv=50%
      mpw=wrap
      fzf_ok wrapword && mpw=wrap-word
      choice=$(printf '%s\n' "$rows" | fzf --multi=4 --reverse --no-info --ansi \
        --prompt='Map: ' --delimiter='\t' --with-nth='2..' \
        --header='tab: pick a trail (4 at most)   enter: open the map' \
        --bind 'load:first+select+down+select+down+select+down+select+first' \
        --preview="$0 --peek {1}" --preview-window="down,$mpv,border-top,follow,$mpw") || exit 0
      names=$(printf '%s\n' "$choice" | cut -f1)
      ;;
    *[!0-9]*)
      echo "trails: map takes a number of agents or 'new', not '$1'" >&2
      exit 1
      ;;
    *)
      # 0 reaches head as `head -n 0`, which refuses with "illegal line count" and leaves
      # you reading coreutils' opinion of your typo rather than ours.
      [ "$1" -ge 1 ] || {
        echo "trails: map needs at least one agent, not '$1'" >&2
        exit 1
      }
      names=$(printf '%s\n' "$rows" | cut -f1 | head -n "$1")
      ;;
  esac
  [ -n "$names" ] || exit 0

  # Drop anything that died between the pick and here. The gap is real: map_menu ran
  # before fzf opened, so a name can be minutes stale by the time you press enter, and an
  # agent that finished and exited in the meantime is gone.
  #
  # It is worth a pass of its own because the first name failing is not survivable. tmux
  # creates the session, its command exits at once, tmux reaps the session — and
  # new-session still returns 0, so the `|| exit 1` below never fires and every call after
  # it ("no such session: map", an empty pane_id, a failed attach) fails in a heap.
  # A dead name later in the list is milder — the pane opens and closes and the grid is
  # quietly one short — but it is the same bug, so it goes the same way.
  #
  # This narrows the window to microseconds rather than closing it; a session dying between
  # this check and the attach still lands in the old behaviour. Nothing can close it — the
  # agent is another process — and narrowing is the whole of the available win.
  # A map pane attaches to the trail's session (D5 in the design), which is where the trail
  # lives: a session that is gone is a trail that is gone.
  names=$(printf '%s\n' "$names" | while read -r n; do
    [ -n "$(agent_wid "$n")" ] && printf '%s\n' "$n"
  done)
  [ -n "$names" ] || {
    echo "trails: the agents you picked are gone" >&2
    exit 1
  }
  count=$(printf '%s\n' "$names" | wc -l | tr -d ' ')

  # Build at the size of the terminal you are standing in, because the layout below is
  # decided on width. A session made without -x/-y sits at tmux's default 80x24 until a
  # client attaches, so the two-pane rule would be judged against a width that is not
  # yours. Inside tmux the client is the window, not the pane, so ask tmux rather than tput —
  # and ask about CLIENT, the one that asked: tmux's own guess can be a trail's nested session
  # client, a fraction of a window wide, which read as a narrow terminal and stacked the two.
  if [ -n "$TMUX" ]; then
    # shellcheck disable=SC2086 # the -t and its client are two words on purpose: -t, since -c answers for whichever client was last active
    size=$(tmux display-message -p ${CLIENT:+-t "$CLIENT"} '#{client_width} #{client_height}' 2>/dev/null)
  else
    size="$(tput cols 2>/dev/null) $(tput lines 2>/dev/null)"
  fi
  w=${size% *}
  h=${size#* }

  # Fall back to tmux's own default for a client-less session. Neither source is guaranteed
  # to answer: tput says nothing with no TERM or with stdout redirected, and client_width is
  # empty for a $TMUX set with no client attached. Either way the empty string reaches
  # new-session as -x '' and tmux refuses the whole map with a bare "width invalid" —
  # a real answer to a question nobody asked. 80x24 builds something you can look at, and
  # the client that attaches a moment later resizes it to the truth anyway; only the
  # two-pane rule below reads the guess, and it degrades to "stacked".
  case $w in
    '' | *[!0-9]*) w=80 ;;
    *) ;; # a real width, from a real terminal
  esac
  case $h in
    '' | *[!0-9]*) h=24 ;;
    *) ;; # likewise
  esac

  # Three or more is a grid, tiled unless the config's map.layout names another tmux
  # layout. Two is the case worth thinking about, and by default it turns on width rather
  # than taste: side by side gives each agent a full-height column, the better shape for
  # reading a conversation — but only if the halves are wide enough to read. Under ~80
  # columns an agent TUI starts wrapping its own boxes, so a 114-column window (a half-screen
  # Ghostty) is better served stacked: 114 wide and short beats 57 wide and tall. Hence 160,
  # which is that 80 doubled. map.two in the config settles it instead ("side", "stacked"),
  # and C-b Space cycles if a particular window disagrees.
  two=$(map_pref two)
  case $two in
    side | stacked | auto | '') ;;
    *)
      echo "trails: map.two is \"$two\" in $CONFIG — side, stacked or auto; using auto" >&2
      two=auto
      ;;
  esac
  layout=$(map_pref layout)
  case $layout in
    '') layout=tiled ;;
    even-horizontal | even-vertical | main-horizontal | main-vertical | tiled) ;;
    *)
      echo "trails: map.layout is \"$layout\" in $CONFIG — a tmux layout name (tiled, main-vertical, …); using tiled" >&2
      layout=tiled
      ;;
  esac
  if [ "$count" -eq 2 ]; then
    case $two in
      side) layout=even-horizontal ;;
      stacked) layout=even-vertical ;;
      *) if [ "$w" -lt 160 ]; then layout=even-vertical; else layout=even-horizontal; fi ;;
    esac
  fi

  # Built aside under its own name and swapped in at the end, where the old map is killed
  # unconditionally — the line that makes "one map" true (see MAP above). A window sitting in
  # the old one loses it there: detach-on-destroy sends its client home, its `tmux attach`
  # exits, and it lands back on a shell. That is the whole cost of asking for a map while one
  # is already open, and it is bounded — the agents never notice, because none of them live
  # here.
  #
  # Aside and not in place, because `trails map new` run from a shell split inside the map —
  # the way the header says to add one — sits in the session being replaced. Killed first, it
  # took this process with it before anything was rebuilt: no map, and a client sent home.
  # Not "trails_map…": a -t without "=" (is_map's) prefix-matches, and would find the build.
  build=trails_newmap
  # One left by a build that died halfway goes; one by that name that isn't a map's is yours.
  if tmux has-session -t "=$build" 2>/dev/null; then
    if [ "$(tmux display-message -pt "=$build:" '#{@trails_map}' 2>/dev/null)" = 1 ]; then
      tmux kill-session -t "=$build" 2>/dev/null
    else
      echo "trails: a tmux session named '$build' is already here and is not ours" >&2
      echo "        rename it (tmux rename-session -t $build <name>) and retry" >&2
      exit 1
    fi
  fi
  first=$(printf '%s\n' "$names" | head -n1)

  tmux new-session -d -s "$build" -x "$w" -y "$h" "$(attach_cmd "$first")" || exit 1

  # new-session's exit status only says the session was created, not that its command
  # lived: a pane whose command exits immediately takes the session down with it and
  # new-session still returns 0. The filter above makes that unlikely, not impossible, and
  # unnoticed it turns every line below into a "no such session" — so ask.
  tmux has-session -t "=$build" 2>/dev/null || {
    echo "trails: $first went away as the map opened it" >&2
    exit 1
  }
  tmux set-option -t "$build" @trails_map 1 \; set-option -t "$build" set-titles on \
    \; set-option -t "$build" set-titles-string "$WS_TITLE"
  home=$(tmux display-message -pt "$build" '#{pane_id}')
  tmux set-option -pt "$home" @dir "$(map_dir "$first")"
  tmux set-option -pt "$home" @ag "$(map_agent "$first")"

  # Re-tile after every split rather than once at the end, because split-window halves the
  # *current* pane and the halves get small fast: measured in an 80x24 window, the fifth
  # agent fails with "no space for new pane" and the map comes up with four and no
  # complaint (the error lands on tmux's stderr, not in the grid you are looking at).
  # Tiling as we go re-spreads the panes each round so the next split has room — the same
  # window then takes six. Four fits either way, which is exactly why this is worth doing
  # up front rather than after the first time a map quietly drops an agent.
  printf '%s\n' "$names" | tail -n +2 | while read -r n; do
    [ -n "$n" ] || continue
    # -P -F to get the new pane's id back, so @dir lands on this split and not whichever
    # pane happened to be current — split-window makes the new pane active, but reading it
    # back by id is exact and does not assume that.
    pane=$(tmux split-window -t "$build" -P -F '#{pane_id}' "$(attach_cmd "$n")")
    tmux set-option -pt "$pane" @dir "$(map_dir "$n")"
    tmux set-option -pt "$pane" @ag "$(map_agent "$n")"
    tmux select-layout -t "$build" tiled >/dev/null
  done
  tmux select-layout -t "$build" "$layout" >/dev/null

  # The border label, free and always current: the inner client emits its session's title
  # (TRAIL_TITLE — "claude · what it is working on") to its terminal,
  # which *is* this pane, so the map reads it straight off #{pane_title}. No poll and
  # no bookkeeping, and it follows the agent's own title as the task changes. The global
  # format is no use here — every pane in a map runs `tmux`, so #{pane_current_command}
  # would label all four "tmux". Set rather than inherited because the global exists for
  # other windows' reasons.
  #
  # Led with #{@dir}, the per-pane directory stamped above, so the border reads
  # "<dir> · claude · <task>": directory, then agent and task from the agent's own title.
  # @dir resolves at the pane scope, so each border shows its own agent's directory; the
  # ' · ' matches TRAIL_TITLE's separator so the three read as one string.
  #
  # The conditional drops the task half when it *is* the directory. Before an agent
  # publishes a task, TRAIL_TITLE falls back to "#{@agent} · #{b:pane_current_path}",
  # so pane_title is "claude · <dir>" and the naive form doubled the directory
  # ("<dir> · claude · <dir>"). Composing that fallback from the stamped @ag and @dir and
  # comparing pane_title to it catches exactly that state and shows "<dir> · claude"; any
  # real task fails the match and prints whole. Transient either way — it self-corrects the
  # moment the agent sets a title — but the doubling is avoided rather than blinked through.
  tmux set-option -w -t "$build" pane-border-status top
  tmux set-option -w -t "$build" pane-border-format \
    ' #{@dir} · #{?#{==:#{pane_title},#{@ag} · #{@dir}},#{@ag},#{pane_title}} '

  # Land on the one that most wants you. By pane id, which cannot be re-numbered out from
  # under us by the re-tiling above the way an index can.
  tmux select-pane -t "$home"

  # Swap the new map in for the old as one tmux command list, which the server runs to the end
  # even when killing the old map hangs up on this very process (run from a shell pane inside
  # it). A failed command stops a list, so kill-session goes in only when there is an old map.
  #
  # Already inside tmux (opened from an agent session, from your own window, or from the old
  # map), attach would refuse to nest, and switch-client is what "go there" means to a client
  # already here — switched to the new one before the old goes, so it is never sent home.
  if [ -n "$TMUX" ]; then
    if tmux has-session -t "=$MAP" 2>/dev/null; then
      exec tmux switch-client ${CLIENT:+-c "$CLIENT"} -t "=$build" \; kill-session -t "=$MAP" \; rename-session -t "=$build" "$MAP"
    fi
    exec tmux switch-client ${CLIENT:+-c "$CLIENT"} -t "=$build" \; rename-session -t "=$build" "$MAP"
  fi
  tmux kill-session -t "=$MAP" 2>/dev/null
  tmux rename-session -t "=$build" "$MAP" || exit 1
  exec tmux attach-session -t "=$MAP"
}

# ─── Where an agent may not be opened ────────────────────────────────────────
# An agent takes the directory you are standing in to be the project: it reads and edits
# from there, and launch() freezes it as the session root with -c "$PWD". / is never the
# answer and is easy to arrive at without meaning to — a `cd "$somewhere"` with the
# variable unset lands there. This box had an `trails-/` session to show for it.
#
# $HOME was refused alongside it, on the grounds that every new terminal starts there and
# so it is the stray-launch directory. It is allowed now: a session that isn't about one
# project (dotfiles-wide questions, poking at several repos) has nowhere better to live,
# and making you cd somewhere arbitrary to get one was friction with no safety behind it.
#
# / exactly, and nothing beneath it, since everything lives beneath it.
#
# Measured with `pwd -P` rather than $PWD, which keeps whatever path you walked in by: a
# symlink pointing at / is the same directory and reads as a different string.
#
# Only starting is refused, never reporting: `trails ls` is read-only, and with -a answers for
# the whole box, so it works from anywhere, and the fzf internals run from a picker that has
# already passed through here.
# A name for a new trail, checked before anything starts: it names the trail's session
# (<workspace>/<name>) and becomes the agent's own name where its config gives it a flag for
# one (session.name), so it must be a word both take, and free. Letters, digits, - and _: tmux
# refuses . and :, and a space would need quoting at every `tmux a -t`. Not digits alone,
# which would read as the #2 badge of an unnamed trail. Free means no trail and no record
# hold it (trail_name_taken), so a lost trail keeps its name until it is restored or forgotten.
check_name() {
  # An unnamed trail's session is <workspace>/<codebase>, then -2, -3: a name like the second
  # reads as one of them, and the codebase's own name, while an unnamed trail holds it, would
  # be numbered as if it were one.
  cn_label=$(codebase_label "$PWD")
  case $1 in
    '') echo "trails: a name can't be empty" >&2 ;;
    -*) echo "trails: '$1' won't do as a name — it can't start with -" >&2 ;;
    *[!A-Za-z0-9_-]*) echo "trails: '$1' won't do as a name — letters, digits, - and _ only" >&2 ;;
    "$cn_label"-[0-9]*) echo "trails: '$1' reads as an unnamed trail of $cn_label — name it something else" >&2 ;;
    "$cn_label")
      if tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -qx -e "[^/]*/$1"; then
        echo "trails: '$1' is an unnamed trail of $cn_label's already — name it something else" >&2
      elif trail_name_taken "$1"; then
        echo "trails: '$1' is taken — trails ls -a shows what by" >&2
      else
        return 0
      fi
      ;;
    *[!0-9]*)
      if trail_name_taken "$1"; then
        echo "trails: '$1' is taken — trails ls -a shows what by" >&2
      else
        return 0
      fi
      ;;
    *) echo "trails: '$1' is all digits, which reads as the #N of an unnamed trail" >&2 ;;
  esac
  return 1
}

# `trails new NAME [AGENT] [-y]`: start a named trail without the picker. AGENT is the
# default agent when left out, -y runs it YOLO and without -y the config's mode decides,
# the way a picker row starts.
new_trail() {
  nt_name='' nt_agent='' nt_mode=''
  for a in "$@"; do
    case $a in
      -y | --yolo) nt_mode=yolo ;;
      -*)
        echo "trails: new takes a name, an agent and -y, not '$a'" >&2
        exit 1
        ;;
      *)
        if [ -z "$nt_name" ]; then nt_name=$a
        elif [ -z "$nt_agent" ]; then nt_agent=$a
        else
          echo "trails: new takes one name and one agent (try: trails help)" >&2
          exit 1
        fi
        ;;
    esac
  done
  [ -n "$nt_name" ] || {
    echo "trails: new needs a name — trails new NAME [AGENT]" >&2
    exit 1
  }
  check_name "$nt_name" || exit 1
  # The default is the first agent that is installed, as the picker offers them.
  [ -n "$nt_agent" ] || nt_agent=$(available_agents | head -n 1)
  [ -n "$nt_agent" ] || {
    echo "trails: no agent to start — none in the config is on PATH (trails config lists them)" >&2
    exit 1
  }
  [ -n "$(agent_row "$nt_agent")" ] || {
    echo "trails: unknown agent '$nt_agent' — trails config lists them" >&2
    exit 1
  }
  available_agents | grep -qxF -e "$nt_agent" || {
    echo "trails: $nt_agent isn't installed — its program isn't on PATH" >&2
    exit 1
  }
  if [ -z "$nt_mode" ] && [ "$(load_mode)" = yolo ] && [ -n "$(yolo_flag "$nt_agent")" ]; then
    nt_mode=yolo
  fi
  TRAILS_NAME=$nt_name
  launch "$nt_agent" "$nt_mode"
}

refuse_bad_cwd() {
  # A directory deleted from under the shell: an agent started there would have nowhere to be.
  pwd -P >/dev/null 2>&1 && [ -d "$PWD" ] || {
    echo "trails: this directory is gone — cd somewhere that exists" >&2
    exit 1
  }
  [ "$(pwd -P)" = / ] || return 0
  echo "trails: refusing to open an agent in / — cd into a project directory" >&2
  exit 1
}

# The keys: the picker's, the tmux ones `trails keys` binds, and what the states mean. Part of
# `trails help`, and on their own as `trails help keys`, which `?` in the picker shows.
# The popup that shows them fits them: a row each, the border's two and less's prompt; the
# widest line, the border's two and a column spare. Never larger than terminal $1 (a client
# name), which tmux would refuse outright ("height too large") rather than shrink.
keys_popup_size() {
  kp_size=$(tmux list-clients -F '#{client_name} #{client_width} #{client_height}' 2>/dev/null |
    awk -v c="$1" '$1 == c { print $2, $3; exit }')
  keys_help | awk -v cw="${kp_size% *}" -v ch="${kp_size#* }" '
    { n++; if (length > w) w = length }
    END {
      w += 3; h = n + 3
      if (cw + 0 > 0 && w > cw) w = cw
      if (ch + 0 > 0 && h > ch) h = ch
      printf "-w %d -h %d", w, h
    }'
}

keys_help() {
  cat <<'EOF'
In tmux, from trails keys (prefix, then):
  ?                 these keys, in a popup
  P                 this workspace's trails, in a popup (the picker)
  W                 the workspaces
  A                 every running trail, in every workspace
  e                 the editor beside the agent; again, back
  `                 a shell along the bottom; again, back
  N                 this codebase's checklist: type a new item, or move to one to
                    read it whole; space ticks it, enter copies it
  ( )               the previous and next workspace
  M                 the map: up to four trails side by side
  G                 this codebase's changes, side by side (trails diff)

In the picker — "＋ new trail…", which lists the agents to start here (in a workspace,
a codebase first, then its agents), then running and lost trails, then "↩ resume old
trails", which lists the ones that ended (esc comes back):
  enter             open it: attach, restore, resume, or start the agent
  tab               toggle YOLO (run everything unconfirmed) on an agent to start or a
                    closed trail; "mode": "yolo" in the config starts new rows armed
  ctrl-n            in the agents list, name the trail you are about to start: type the
                    name, then enter (on the workspace picker: a new workspace)
  ctrl-e            the editor for the row's codebase (trails edit)
  ctrl-/            show or hide the preview: the trail's screen as it is now
  ctrl-x            end a running trail, or forget a lost one; in the old trails,
                    forget a closed one
  ctrl-a            every running trail, in every workspace (prefix A opens it too);
                    esc there comes back
  ?                 these keys; q comes back
  esc               up a level: to the codebase's workspace, then the workspaces, then out
                    (out at once in an editor's terminal)
  ctrl-c            quit, from any screen

States — ● running, ○ not:
  ● needs you       asking you something
  ● your turn       finished its turn, waiting on you
  ● unknown         nothing says: set up its hooks, https://github.com/gunasekar/trails#hooks-for-each-agent
  ● working         busy
  ○ lost            tmux died under it; enter (or trails restore) brings it back
  ○ closed          it ended; enter resumes its conversation, in the mode it last ran in

EOF
}

# ─── Dispatch ────────────────────────────────────────────────────────────────
# `trails help` — the commands and picker keys, for whoever forgot them. Written out rather
# than scraped from the header comment, which is written for whoever edits this file.
usage() {
  cat <<'EOF'
usage: trails [command]

  (none)            the picker for where you are: this codebase's trails and the agents
                    you can start; a workspace's trails, from a shell in its session; or
                    the workspaces, from ~
  new NAME [AGENT]  start a trail named NAME: its session is <workspace>/NAME, and
                    the agent takes the name too where its config says how
                    (session.name); -y for YOLO
  ls [-a | DIR]     this directory's trails, running or not; DIR's, or -a for
                    every directory — a table, or TSV when piped
  map here          prefix M: to the map; with none up, or on it, pick up to four
                    trails from every workspace for it
  map [N|new]       several agents in one window — pick up to four, the four that most
                    want you ticked, or take the N that most want you; `new` rebuilds
                    instead of re-attaching
  restore           bring back every trail that died with tmux (the lost ones), each
                    into its workspace; trails keys offers a line to run it whenever
                    tmux starts
  ws [NAME]         pick a workspace, or go to NAME: switch (inside tmux) or attach to
                    its session, or its picker when nothing runs there
  ws list           the workspaces in the config, and the codebases each holds
  ws of [DIR]       the workspace DIR (here) belongs to
  ws add NAME [DIR] put DIR (here) in workspace NAME, creating it if new
  ws next | prev    the terminal to the next or previous running workspace, as the
                    status line lists them (prefix ( and ), from trails keys)
  edit | shell      the editor ($EDITOR) beside the agent, or a shell along the bottom,
                    as panes of the trail's window in the workspace (the editor alone
                    in a window of its own when nothing runs there): made once, then
                    selected; run from the pane, back to where you were. The window you
                    are on says which codebase, or DIR after the command
  note TEXT         TEXT as an item on this codebase's checklist
  checklist [DIR]   the checklist: type and enter adds an item; ↑ ↓ to one, space ticks
                    it done or back, enter with nothing typed copies it; ctrl-e opens the
                    file in $EDITOR (the config's "data" says where)
  keys              print tmux.conf lines that bind the picker, every trail, the editor,
                    the shell, the checklist, the workspaces, the map and the diff, and list the
                    workspaces in the status line
  diff [DIR]        this codebase's changes, untracked files too, side by side: prefix G,
                    in a popup; the config's "diff" says what shows them
  state WORD [--id ID]
                    for an agent's hooks: working, waiting or idle, and the
                    conversation it is in (https://github.com/gunasekar/trails#hooks-for-each-agent)
  config            the agents file: written from the built-ins the first
                    time, then opened in $EDITOR (~/.config/trails/config.json)
  help [keys]       this; keys, the keys alone (? in the picker)

EOF
  echo
  keys_help
  cat <<'EOF'

Env:
  TRAILS_RECENT_DAYS  how far back closed sessions are listed (default 10)
  TRAILS_RECENT_MAX   how many of them (default 5)
EOF
}

# A config that is there but isn't a JSON object reads, quietly, as no workspaces, the default
# checklist path and the default mode, each loader seeing nothing. So it is checked once, first,
# and named for what it is: not JSON (with jq's reason), empty, or not an object. help,
# config, keys and the internals go on, as does ls, so a typo can't blank what reads it; the rest
# stop rather than act on a config they can't read.
config_check() {
  [ -f "$CONFIG" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  if [ ! -s "$CONFIG" ]; then
    cc="is empty"
  else
    cc=$(jq -e 'type == "object"' "$CONFIG" 2>&1 >/dev/null)
    case $? in
      0) return 0 ;;
      1) cc="is not a JSON object" ;;
      *) cc="is not valid JSON (${cc#jq: error*: })" ;;
    esac
  fi
  echo "trails: $(tilde_path "$CONFIG") $cc — fix it (trails config), or move it aside for the built-ins" >&2
  return 1
}
case $1 in
  help | -h | --help | config | keys | --keys | --forget | --layout | --peek) ;;
  ls) config_check || true ;;
  checklist) [ -n "$LIGHT" ] || config_check || exit 1 ;;
  *) config_check || exit 1 ;;
esac

# The agents, read once per run. Not for what never starts or names an agent — help, config,
# the wrapper's --forget and the editor pane's --layout, which have to work even when the
# config is broken. ls carries on
# without them (only its closed rows need them), so a typo in the file can't blank what reads it.
case $1 in
  help | -h | --help | config | keys | --keys | note | checklist | diff | --forget | --layout | --peek) AGENTS= ;;
  ls | ws) AGENTS=$(load_agents) || AGENTS= ;;
  *) AGENTS=$(load_agents) || exit 1 ;;
esac
# The workspaces, read once per run too; empty means none configured (see workspace_of). Not
# for the checklist's light runs, which never ask.
WORKSPACES=
[ -n "$LIGHT" ] && [ "$1" = checklist ] || WORKSPACES=$(load_workspaces)
MODE=default
case $1 in
  '' | ws | --print-menu) MODE=$(load_mode) ;;
  *) ;; # only the picker draws "+ new" rows
esac

case $1 in
  help | -h | --help)
    if [ "${2:-}" = keys ]; then
      keys_help
    else
      usage
    fi
    exit 0
    ;;
  ls)
    shift
    list_sessions "$@"
    exit 0
    ;;
  # Above refuse_bad_cwd with ls, and for the same reason: it opens no agent, so
  # where you are standing is not its business. You are most likely to want a map
  # from wherever you happened to walk back to.
  map)
    case ${2:-} in
      here) map_here ;;
      *) map "$2" ;;
    esac
    exit 0
    ;;
  config)
    edit_config
    exit 0
    ;;
  # The codebase's editor or shell (see "Editor and shell"): the window you are on says which codebase.
  edit | shell)
    tool "$1" "${2:-}"
    exit 0
    ;;
  # An item on this codebase's checklist, or the checklist (see "Checklist"): from a popup, the
  # codebase of the window it was opened over.
  note)
    shift
    note_cmd "$@"
    exit 0
    ;;
  checklist)
    shift
    checklist_cmd "$@"
    exit 0
    ;;
  keys)
    keys
    exit 0
    ;;
  diff)
    if [ "${2:-}" = --show ]; then
      diff_show "${3:-}" popup
    else
      diff_cmd "${2:-}"
    fi
    exit
    ;;
  # Box-wide like ls: the key says which trail, wherever you stand.
  # Box-wide like ls: each session comes back in its own recorded directory, so where you
  # stand does not matter.
  restore)
    restore_all "$2"
    exit 0
    ;;
  # `trails ws` on a terminal is the workspace picker, and `trails ws NAME` goes straight
  # there; the rest is about the config. Piped, bare `ws` lists, for a script.
  ws)
    shift
    case ${1:-} in
      '') [ -t 1 ] || {
        ws_cmd
        exit $?
      } ;;
      of | add | list)
        [ "$1" = list ] && shift
        ws_cmd "$@"
        exit $?
        ;;
      next | prev)
        ws_step "$1"
        exit $?
        ;;
      -*)
        ws_cmd "$@"
        exit $?
        ;;
      *) ws_switch "$1" ;;
    esac
    TRAILS_PICKER=ws
    ;;
  # Called by the wrapper launch() puts around every agent, when the agent exits: the trail
  # goes into the history, to resume.
  # From `trails state --id`, in the background, when a hook says a conversation the trail
  # doesn't carry yet: a pass over the trails moves its record (rec_note_id).
  --said)
    sessions >/dev/null
    exit 0
    ;;
  --forget)
    window_release "$2"
    rec_close "$2" "${TMUX_PANE:-}"
    exit 0
    ;;
  # prefix ? and ? in the picker: the keys, in a popup the size of them, on the terminal that
  # pressed the key (a run-shell job's TRAILS_CLIENT) or over the pane the picker runs in;
  # in less in place where the picker itself is in a popup (prefix P), since tmux shows one
  # popup at a time and refuses a second without a word, or outside tmux.
  --keys)
    if [ -n "$TMUX" ] && [ -n "$CLIENT" ] && { [ -n "${TRAILS_CLIENT:-}" ] || [ -n "${TMUX_PANE:-}" ]; }; then
      kb=$(popup_bg)
      # shellcheck disable=SC2046 # -w W -h H, four words on purpose
      exec tmux display-popup -c "$CLIENT" -E $(keys_popup_size "$CLIENT") -s "bg=$kb" -S "bg=$kb,fg=brightblack" \
        -T " trails keys " "$(shq "$SELF") help keys | less -R"
    fi
    keys_help | less -R
    exit 0
    ;;
  --print-menu)
    print_menu
    exit 0
    ;;
  # Asked by the editor pane's command as it ends (tool), so the shell under it can go
  # back along the bottom.
  --layout)
    window_layout "$2"
    tool_remark "$2"
    exit 0
    ;;
  --peek)
    peek "$2"
    exit 0
    ;;
  --kill)
    kill_session "$2"
    exit 0
    ;;
  --toggle-yolo)
    toggle_yolo "$2"
    exit 0
    ;;
  new | '') ;;
  *)
    echo "trails: unknown argument '$1' (try: trails help)" >&2
    exit 1
    ;;
esac

# In a shell pane of the map, the pane becomes the new trail's window (see in_map, attach_to).
IN_MAP=
in_map && IN_MAP=1

if [ "${1:-}" = new ]; then
  shift
  new_trail "$@"
  exit 0
fi

# Which screen (see print_menu), for a bare `trails`: an editor's terminal gets its codebase's
# trails, whatever is around it (the editor never sees workspaces); a shell in a workspace
# session — or a popup over one — gets that workspace's; nowhere in particular (~, a fresh
# SSH login, /) gets the workspaces; and a shell in a codebase gets the codebase's. The
# client's session says whether you are in a workspace: CLIENT, followed out of any nested
# client, since tmux's own guess from a popup is the most recently active client, and a key
# typed into a trail's window also wakes the nested one showing it, whose session is the
# trail's, not the workspace's; and a session grouped with a workspace's is that workspace
# (client_ws). TRAILS_PICKER already set is a
# re-entry from one screen to another (or `trails ws`), and is kept: `here` for a codebase's
# screen asked for by name, which an empty one can't say, since empty means "work it out".
if [ -z "${TRAILS_PICKER:-}" ]; then
  if from_editor; then
    :
  elif [ -n "$TMUX" ] && [ -n "$USE_TMUX" ] &&
    w=$(client_ws) && [ -n "$w" ]; then
    TRAILS_PICKER=workspace TRAILS_WS=$w
  elif [ "$PWD" = "$HOME" ] || [ "$(pwd -P)" = / ]; then
    TRAILS_PICKER=ws
  fi
fi
[ "${TRAILS_PICKER:-}" != here ] || TRAILS_PICKER=
export TRAILS_PICKER TRAILS_WS

# Every screen from here on is an fzf list.
need_fzf
fzf_ok infocmd || : # asked once here, not in every hint's subshell

# A codebase screen in a directory no workspace claims asks once where it belongs
# (ask_workspace), unless an earlier screen already settled it. The picker is the one place
# that asks: `trails new` and restore say what they did and carry on.
case ${TRAILS_PICKER:-} in
  '' | old | agents)
    if [ -z "${TRAILS_WS:-}" ] && [ -n "$WORKSPACES" ] && ! workspace_of "$PWD" >/dev/null; then
      ask_workspace
    fi
    ;;
  *) ;;
esac

# Per-invocation temp files, exported so the fzf-spawned --toggle-yolo / --print-menu /
# --kill subprocesses all share them. All three live in one private directory from mktemp -d,
# not at $$-named paths in a /tmp other users can write to, where a planted symlink would have
# had the cache write follow it. The directory goes the moment fzf returns and on exit via the
# trap, since the exec paths below never run to an EXIT trap of their own.
#
# INT and TERM exit, and the exit runs the EXIT trap. A trap that only cleaned up let a ctrl-c
# during the classify below carry straight on, into a picker built from the caches it had
# just deleted — no running trails, in the one you had tried to cancel.
#
# TRAILS_YOLO_STATE — which agent (if any) you armed for YOLO with Tab. The chosen row's verb
#                     already carries the mode by the time fzf returns, so nothing reads it after.
# TRAILS_MENU_CACHE — the running trails, classified once here rather than on every reload.
#                     print_menu is re-run for each Tab and ctrl-x; live_trails() reads every
#                     trail's state, so recomputing it per keystroke would delay the Tab
#                     relabel. The snapshot does not change over the picker's
#                     life (fzf never refreshes it on its own), so caching loses no freshness.
#                     On the workspace picker it holds every trail classified, for the counts.
# TRAILS_RECENT_CACHE — the closed rows' raw TSV, for the same reason: read once, drawn per reload.
TRAILS_TMP=$(mktemp -d "${TMPDIR:-/tmp}/trails.XXXXXX") || exit 1
TRAILS_YOLO_STATE=$TRAILS_TMP/yolo
TRAILS_MENU_CACHE=$TRAILS_TMP/menu
TRAILS_RECENT_CACHE=$TRAILS_TMP/recent
export TRAILS_YOLO_STATE TRAILS_MENU_CACHE TRAILS_RECENT_CACHE
trap 'rm -rf "$TRAILS_TMP"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Classify the running trails once, up front — the only place that pays classify's settle
# sleep on the picker's happy path. Empty (not absent) with no tmux to look in.
: >"$TRAILS_MENU_CACHE"
if [ -n "$USE_TMUX" ]; then
  case ${TRAILS_PICKER:-} in
    '') live_trails >"$TRAILS_MENU_CACHE" ;;
    workspace) live_trails "$TRAILS_WS" >"$TRAILS_MENU_CACHE" ;;
    all) live_trails --all >"$TRAILS_MENU_CACHE" ;;
    ws) sessions | classify >"$TRAILS_MENU_CACHE" ;;
    *) ;;
  esac
fi

# Lost rows on the same terms as the running ones: not where there is no tmux to restore
# into. print_menu reads the verdict rather than re-deriving it, for the reason the cache
# comment above gives.
TRAILS_RESTORE_OK=
[ -n "$USE_TMUX" ] && TRAILS_RESTORE_OK=1
export TRAILS_RESTORE_OK

# Closed rows need no tmux: resuming bare is still resuming. A workspace's are the box's
# recent conversations whose directory it claims.
recent_cache >"$TRAILS_RECENT_CACHE"

MENU=$(print_menu) || exit 1
[ -n "$MENU" ] || [ "${TRAILS_PICKER:-}" != all ] || {
  echo "trails: no trails running" >&2
  exit 1
}
[ -n "$MENU" ] || {
  echo "trails: nothing to pick from — trails ws add NAME DIR gives a workspace its first codebase" >&2
  exit 1
}

# The height: see the preview below. --wrap because a task is a sentence and a narrow pane (Zed's terminal,
# nvim's right panel) can run past the edge — wrapping costs a row and shows all of it,
# where truncating would hide the field that tells two trails of one codebase apart.
#
# tab arms the highlighted row for YOLO (toggle_yolo) and reloads so print_menu can relabel
# it; the reload keeps the cursor on the row, so Tab-then-Enter lands on what you armed.
# The keys are a dim `# …` right after the prompt rather than a header line of their own, and
# there is no rule under the prompt: two rows back for trails in a short panel. fzf's info
# area is what sits there (--info=inline), and --info-command swaps its match count for the
# hint. Beside the prompt rather than pinned to the right edge, where a wide terminal left it
# far from where you type; a pane too narrow for it cuts the hint, never the rows.
#
# The preview is the highlighted trail's screen as it is now (peek): what it is asking,
# without opening it. Under the list, full width, so an agent's lines fit, and scrolled to
# the bottom (follow), where its latest output and its prompt are: a screen is taller than a
# preview, and from the top it showed the oldest of it. Shown when the terminal has the rows
# for it, else hidden until ctrl-/; a row that is not a running trail previews nothing.
#
# The screens with a preview take the whole terminal, or the whole popup, and the preview
# every row the list doesn't need: the prompt, a row per entry, one to spare for an entry
# that wraps. A share of the height instead left blank rows under a short list, and an 80%
# box left a fifth of the popup empty. A preview under ten rows is hidden until ctrl-/. The
# workspaces and the agents, with no preview, hug their rows.
# ? shows the keys (keys_help, --keys); q comes back to the list.
set -- --reverse --ansi --wrap --no-separator \
  --info='inline:   ' --color='info:dim' \
  --delimiter='\t' --with-nth='3..' \
  --bind="?:execute($0 --keys)"
# From the terminal itself: tput, with its output going to $(...), answers its default 24.
rows=$(stty size </dev/tty 2>/dev/null | cut -d" " -f1)
case $rows in
  '' | *[!0-9]*) rows=0 ;;
  *) ;;
esac
pv=$((rows - 2 - $(printf '%s\n' "$MENU" | wc -l)))
hidden=
[ "$pv" -ge 10 ] || hidden=,hidden pv=50%
case ${TRAILS_PICKER:-} in
  ws) set -- "$@" --height=~80% --expect=ctrl-a ;;
  agents) set -- "$@" --height=~80% --expect=ctrl-e,esc --bind="tab:execute-silent($0 --toggle-yolo {2})+reload($0 --print-menu)" ;;
  *) pw_wrap=wrap
    fzf_ok wrapword && pw_wrap=wrap-word
    set -- "$@" --preview="$0 --peek {2}" --preview-window="down,$pv,border-top,follow,$pw_wrap$hidden" \
    --bind='ctrl-/:toggle-preview' --expect=ctrl-e,esc,ctrl-a \
    --bind="tab:execute-silent($0 --toggle-yolo {2})+reload($0 --print-menu)" ;;
esac

# Start the cursor on the trail that most wants you — the first "needs you", else the first
# "your turn" — else on the first row, whatever it is; on the workspace picker, on the
# workspace you were in last.
# On the first `load`, then unbound: not `start`, which fires before fzf has read a row (it
# takes input asynchronously) so pos() lands on nothing; and not a standing `load`, which
# fires on every Tab reload too and would yank the cursor off the row you just armed.
want=$(printf '%s\n' "$MENU" | awk -F"$TAB" '
  { s = $3; gsub("\033\\[[0-9;]*m", "", s) } # the glyph and word are coloured
  $1 == "workspace" && index(s, "· last") { b = NR }
  $1 != "attach" { next }
  !b && index(s, "● needs you") { b = NR }
  !i && index(s, "● your turn") { i = NR }
  END { print b ? b : i }')
case ${TRAILS_PICKER:-} in
  # ctrl-x forgets a closed trail: out of the history, and the list reloaded without it.
  old | workspace-old)
    set -- "$@" --prompt='Resume a trail: ' \
      "$(hint_opt "# enter: resume · tab: toggle YOLO · ctrl-e: editor · ctrl-/: preview · ctrl-x: forget · ?: keys · esc: back")" \
      --bind="ctrl-x:execute-silent($0 --kill {2})+reload($0 --print-menu)"
    ;;
  ws)
    # ctrl-n names a new workspace: the name is the query, as a trail's is below.
    set -- "$@" --prompt='Pick a workspace: ' --print-query \
      "$(hint_opt "# enter: open · ctrl-n: new workspace · ctrl-a: all trails · ?: keys")" \
      --bind="ctrl-n:execute-silent(touch '$TRAILS_TMP/naming')+change-prompt(Name the workspace: )+disable-search+clear-query"
    ;;
  *)
    here_ws=$(workspace_of "$PWD" 2>/dev/null || printf '%s' "${TRAILS_WS:-default}")
    case ${TRAILS_PICKER:-} in
      workspace) prompt="$TRAILS_WS ▸ Pick a trail: " ;;
      all) prompt="All trails ▸ Pick a trail: " ;;
      agents) prompt="$(label_of "$PWD") ($here_ws) ▸ Start an agent: " ;;
      *) prompt="$(label_of "$PWD") ($here_ws) ▸ Pick a trail: " ;;
    esac
    set -- "$@" --prompt="$prompt" --print-query
    # ctrl-n turns the query into the name for the new trail under the cursor: the prompt says
    # so, and search goes off so typing the name doesn't filter that row away. The marker file
    # is how the dispatch below tells a name from a filter, since --print-query prints both.
    # Only on the agents screen, the one with agent rows: the others start a trail from "＋ new
    # trail…", which leads there.
    new_keys=
    if [ "${TRAILS_PICKER:-}" = agents ]; then
      new_keys=' · tab: toggle YOLO · ctrl-n: name it'
      set -- "$@" --bind="ctrl-n:execute-silent(touch '$TRAILS_TMP/naming')+change-prompt(Name this trail: )+disable-search+clear-query"
    fi
    # ctrl-x ends a running trail, forgets a lost one and closes an editor or shell window, and
    # the hint names only what this list has — or, with none of them, no ctrl-x at all.
    x=
    printf '%s\n' "$MENU" | grep -q '^attach' && x=end
    printf '%s\n' "$MENU" | grep -q '^restore' && x=${x:+$x, }forget
    printf '%s\n' "$MENU" | grep -q '^tool' && x=${x:+$x, }close
    # Esc goes up from both main screens, but not out of an editor's one codebase; the
    # all-trails screen goes back where ctrl-a came from, or closes. ctrl-a gets there.
    up=' · esc: up'
    [ -n "${TRAILS_PICKER:-}" ] || ! from_editor || up=
    all_key=' · ctrl-a: all'
    if [ "${TRAILS_PICKER:-}" = all ]; then
      all_key=''
      up=' · esc: close'
      [ -z "${TRAILS_FROM:-}" ] || up=' · esc: back'
    fi
    if [ "${TRAILS_PICKER:-}" = agents ]; then
      set -- "$@" "$(hint_opt "# enter: start$new_keys · ctrl-e: editor · ?: keys · esc: back")"
    elif [ -n "$x" ]; then
      set -- "$@" "$(hint_opt "# enter: open$new_keys · ctrl-e: editor · ctrl-/: preview · ctrl-x: $x$all_key · ?: keys$up")" \
        --bind="ctrl-x:execute-silent($0 --kill {2})+reload($0 --print-menu)"
    else
      set -- "$@" "$(hint_opt "# enter: open$new_keys · ctrl-e: editor · ctrl-/: preview$all_key · ?: keys$up")"
    fi
    ;;
esac
[ -n "$want" ] && set -- "$@" --bind="load:pos($want)+unbind(load)"

# A screen with a preview keeps it current while you look: fzf listens on a socket in the
# picker's own directory, and preview_ticker asks it to refresh the preview once a second.
ticker=
case ${TRAILS_PICKER:-} in
  ws | agents) ;;
  *)
    if command -v curl >/dev/null 2>&1 && fzf_ok listen; then
      set -- "$@" --listen="$TRAILS_TMP/fzf.sock"
      ticker=$(preview_ticker "$TRAILS_TMP/fzf.sock")
    fi
    ;;
esac

# ctrl-c quits, from any screen. Esc goes up a level (D4 in docs/design/picker-consolidation.md):
# fzf reports it as a key (--expect), handled below, where an abort could not tell the two apart.
# The workspaces screen, the top, has no Esc key of its own: there it quits.
choice=$(printf '%s\n' "$MENU" | fzf "$@")
picked=$?
[ -z "$ticker" ] || kill "$ticker" 2>/dev/null
[ "$picked" -eq 0 ] || exit 0

# The main lists print the query first (--print-query), the old lists don't; the trail
# screens print the key that ended fzf next (--expect: ctrl-e, or empty for enter).
query=
named=
key=
case ${TRAILS_PICKER:-} in
  old | workspace-old)
    key=$(printf '%s\n' "$choice" | head -n 1)
    choice=$(printf '%s\n' "$choice" | sed 1d)
    ;;
  ws)
    query=$(printf '%s\n' "$choice" | head -n 1)
    key=$(printf '%s\n' "$choice" | sed -n 2p)
    choice=$(printf '%s\n' "$choice" | sed 1,2d)
    [ -f "$TRAILS_TMP/naming" ] && named=1
    ;;
  *)
    query=$(printf '%s\n' "$choice" | head -n 1)
    key=$(printf '%s\n' "$choice" | sed -n 2p)
    choice=$(printf '%s\n' "$choice" | sed 1,2d)
    [ -f "$TRAILS_TMP/naming" ] && named=1
    ;;
esac

# Field 2 is the target either way — a running trail's window id, a lost one's key, an agent
# to start (agent:dir on a workspace's screen), a workspace's name. cut splits on TAB by
# default, the delimiter the menu is built with.
target=$(printf '%s' "$choice" | cut -f2)

rm -rf "$TRAILS_TMP"
trap - EXIT INT TERM

# ctrl-a: every running trail, Esc there coming back to this screen (TRAILS_FROM).
if [ "$key" = ctrl-a ] && [ "${TRAILS_PICKER:-}" != all ]; then
  from="${TRAILS_PICKER:-here}|${TRAILS_WS:-}"
  TRAILS_FROM=$from TRAILS_PICKER=all exec "$SELF"
fi

# Esc: up a level. An old list goes back to its main one, the agents to the screen they were
# reached from, a workspace's screen to the workspaces, and a codebase's to its workspace —
# except in an editor's terminal, which sees one codebase and quits.
if [ "$key" = esc ]; then
  case ${TRAILS_PICKER:-} in
    old) TRAILS_PICKER=here exec "$SELF" ;;
    workspace-old) TRAILS_PICKER=workspace exec "$SELF" ;;
    agents)
      [ -z "${TRAILS_BACK:-}" ] || TRAILS_PICKER=workspace TRAILS_WS=$TRAILS_BACK exec "$SELF"
      TRAILS_PICKER=here exec "$SELF"
      ;;
    workspace) TRAILS_PICKER=ws TRAILS_WS='' exec "$SELF" ;;
    all)
      [ -n "${TRAILS_FROM:-}" ] || exit 0
      back=$TRAILS_FROM
      TRAILS_PICKER=${back%%|*} TRAILS_WS=${back#*|} TRAILS_FROM='' exec "$SELF"
      ;;
    *)
      ! from_editor || exit 0
      TRAILS_PICKER=workspace TRAILS_WS=$(workspace_of "$PWD" 2>/dev/null || printf '%s' "${TRAILS_WS:-default}") exec "$SELF"
      ;;
  esac
fi

# ctrl-n on the workspace picker: a new workspace, named by the query, given its first
# codebase from a directory picked under ~, and then that codebase's screen.
if [ -n "$named" ] && [ "${TRAILS_PICKER:-}" = ws ]; then
  check_ws_name "$query" || exit 1
  if [ "$query" = default ] || printf '%s\n' "$WORKSPACES" | cut -d'|' -f1 | grep -qxF -e "$query"; then
    echo "trails: there's a workspace $query already — pick it, or name a new one" >&2
    exit 1
  fi
  d=$(pick_dir "$HOME" "First codebase of $query: ")
  case $? in
    0) ;;
    1) TRAILS_PICKER=ws exec "$SELF" ;;
    *) exit 0 ;;
  esac
  ws_add "$query" "$d" >&2 || exit 1
  cd "$d" || exit 1
  TRAILS_PICKER=here TRAILS_WS='' exec "$SELF"
fi
if [ -n "$named" ]; then
  case $choice in
    new* | yolo*) ;;
    *)
      echo "trails: ctrl-n names a new trail — pick a \"new\" row to name" >&2
      exit 1
      ;;
  esac
  check_name "$query" || exit 1
  TRAILS_NAME=$query
fi

# A "new" row on a workspace's screen carries its codebase (agent:dir), and a closed row its
# conversation's (agent:id:dir): start there.
# Neither an agent's name nor a conversation's ID has a ":", and a directory may: the directory
# is what follows the first one or two, not the last.
case $target in
  *:/*)
    case $choice in
      resume*)
        t_dir=${target#*:}
        t_dir=${t_dir#*:}
        ;;
      *) t_dir=${target#*:} ;;
    esac
    cd "$t_dir" || exit 1
    target=${target%":$t_dir"}
    ;;
  *) ;;
esac

# ctrl-e: the editor for the row's codebase — a running trail's or tool window's row says
# it, a lost one's record, and a new or closed row has just cd'd there.
if [ "$key" = ctrl-e ]; then
  case $choice in
    attach* | tool*) tool edit "$(trail_dir "$target")" ;;
    restore*) tool edit "$(rec_get "$target" dir)" ;;
    browse* | more*)
      case ${TRAILS_PICKER:-} in
        workspace*)
          echo "trails: ctrl-e opens a codebase's editor — put the cursor on one of its rows" >&2
          exit 1
          ;;
        *) tool edit "$PWD" ;;
      esac
      ;;
    *) tool edit "$PWD" ;;
  esac
fi

case $choice in
  # "↩ resume old trails": the same picker, on the old list.
  more*)
    case ${TRAILS_PICKER:-} in
      workspace) TRAILS_PICKER=workspace-old exec "$SELF" ;;
      *) TRAILS_PICKER=old exec "$SELF" ;;
    esac
    ;;
  workspace*) ws_switch "$target" ;;
  # "＋ new trail…" on a codebase's screen: its agents, Esc coming back here.
  agents*) TRAILS_BACK='' TRAILS_PICKER=agents exec "$SELF" ;;
  # "＋ new trail…": pick a directory, then an agent to start there. Esc on either comes back.
  browse*)
    d=$(pick_codebase "$TRAILS_WS")
    case $? in
      0) ;;
      1) TRAILS_PICKER=workspace exec "$SELF" ;;
      *) exit 0 ;;
    esac
    cd "$d" || exit 1
    # The workspace this came from goes on as TRAILS_BACK: Esc on the agents returns to it, and
    # a folder no workspace claims is offered to it first.
    back=$TRAILS_WS
    TRAILS_BACK=$back TRAILS_PICKER=agents TRAILS_WS='' exec "$SELF"
    ;;
  attach*) attach_key "$(trail_key "$target")" "$target" ;;
  # An editor or shell window, in its workspace: switched to or attached, never nested.
  tool*)
    [ -z "$TMUX" ] || switch_to "=$(trail_ws "$target"):$target"
    exec tmux attach-session -t "=$(trail_ws "$target"):$target"
    ;;
  # A lost row comes back in its own directory, which on a workspace's screen is not here.
  restore*)
    new=$(cd "$(rec_get "$target" dir)" && restore_one "$target") || exit 1
    attach_key "$new"
    ;;
  # Before yolo*, which "resume-yolo" does not match but reads as if it might. A fresh trail
  # on the old conversation, recorded under its ID like any launch, so tmux dying can't lose it.
  resume*)
    mode=
    case $choice in resume-yolo*) mode=yolo ;; *) ;; esac
    launch "${target%%:*}" "$mode" "${target#*:}"
    ;;
  yolo*) launch "$target" yolo ;;
  *) launch "$target" '' ;;
esac
