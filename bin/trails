#!/usr/bin/env sh
# trails — an fzf picker for AI coding agents that live in tmux. Run it from any shell, or
# make it an editor's terminal command (nvim's agent panel, Zed's terminal_init_command) so
# every frontend lands on the same sessions. https://github.com/gunasekar/trails
#
#   trails                  pick a running session to rejoin, or an agent to start
#   trails help             the commands and picker keys (also -h, --help)
#   trails ls               where every agent session is: running, lost with tmux, or ended
#                           in the last 10 days. A table on a terminal, TSV when piped, for
#                           a notifier to read. See "Session states" below.
#   trails restore          bring back every session that died with tmux (a reboot, a
#                           crash, kill-server), each resuming its conversation, detached.
#                           See "Surviving tmux" below.
#   trails swiftbar         link the SwiftBar menu-bar plugin that ships with trails. See
#                           "Menu bar" below.
#   trails config           the agents file, ~/.config/trails/config.json. See
#                           "Agents" below.
#   trails map [N]          several agents at once in one window. Pick them, or take the
#                           N that most want you. Bare `map` re-attaches to a map
#                           already up rather than rebuilding; `map new` forces a fresh
#                           pick. Inside, all stock tmux: C-b ←↑↓→ move, C-b z zoom one
#                           full-screen, C-b Space cycle layout, C-b d detach. C-b C-b s
#                           re-points one pane at a different agent — C-b C-b is send-prefix,
#                           so the key lands on the pane's own (inner) client rather than on
#                           the map. To add one, split a shell off (C-b |) and run
#                           `trails` there: the agent gets its own session as usual and
#                           that pane becomes its view.
#
# In the picker: this directory's sessions — ● running, ○ not — then the agents you can start.
# Enter opens the highlighted row (attach, restore, resume, start), tab toggles YOLO on an
# agent or a closed session, ctrl-x ends a running session or forgets a lost one.
#
# Env:
#   AGENT_SETTLE           seconds between the two screen samples (default 0.35)
#   AGENT_ASK_RE           regex meaning "the agent is asking you something"
#   TRAILS_RECENT_DAYS     how far back closed rows look, in the picker and `trails ls` (default 10)
#   TRAILS_RECENT_MAX      how many of them to show (default 5)
#
# Not `agent`: the bin directories on PATH are a shared namespace, and cursor-agent ships
# a binary called `agent` that overwrote this script's symlink on install and on every
# self-update. Owning a name a vendor also wants is a fight you re-lose on every update.
# It was `aigent` for a while, which dodged that but not speech-to-text, which hears
# "agent" every time. `trails` is a word nobody mishears and no other tool claims.
#
# Sessions live in tmux, one per agent, named trails-<project>. $PREFIX below is the
# only definition of "a session of ours", so changing it orphans anything already
# running — rename live sessions rather than strand them:
#   tmux rename-session -t aigent-foo trails-foo
#
# Why tmux: Zed's remote mode runs this on the ssh host, and when Zed disconnects the
# agent process dies with its terminal, leaving `claude --resume` (which replays the
# transcript into a *new* process) as the only way back. Held in tmux the process
# stays alive, so reconnecting re-attaches to the running conversation with nothing to
# resume. Every frontend goes through this one script; the same session is reachable
# from a plain terminal with `tmux a -t trails-<project>`.

# ─── Agents ──────────────────────────────────────────────────────────────────
# Which agents trails can start, and how, come from a JSON file you edit — never from this
# script. The shape follows claude-squad's, so an agent is a name and the command it runs:
#
#   ~/.config/trails/config.json
#   {
#     "mode": "default",
#     "default_agent": "claude",
#     "agents": [
#       { "name": "claude", "program": "claude",
#         "yolo": "--dangerously-skip-permissions",
#         "session": { "start": "--session-id {id}", "resume": "--resume {id}", "id": "uuid" } },
#       { "name": "aider", "program": "aider --model ollama_chat/gemma3:1b", "yolo": "--yes-always" }
#     ]
#   }
#
#   name      what the picker calls it. Letters, digits, . _ - only: it is part of a picker
#             target and a tmux option value.
#   program   the command line, split on spaces. No shell quoting: anything that needs it
#             belongs in a wrapper script.
#   yolo      the flag that runs everything unconfirmed. Opt-in per launch with Tab, so a
#             stray Enter is always the safe mode. Omit it for an agent that has none.
#   session   what makes a session survive tmux (see "Surviving tmux"): `resume` picks a
#             conversation back up, {id} is where the ID goes, and one of three says how
#             trails learns the ID in the first place —
#               start   begin the conversation under an ID trails chooses; `id` is its shape,
#                       "uuid" or "ses_hex" (ses_ + 32 hex, what opencode insists on)
#               create  a command that prints a fresh ID (cursor-agent create-chat)
#               find    a reader for the agent's own files, built in below: "claude" (also
#                       follows /resume inside claude), "codex"
#             Without it the agent still runs, it just isn't brought back after a reboot.
#   default_agent  listed first in the picker.
#   mode           "default" (the agent's own, prompting mode) or "yolo": which a "+ new" row
#                  starts in. Tab flips a row from it, so with "yolo" Tab is how you start one
#                  in default mode. Closed sessions come back in the mode they last ran in
#                  either way, and an agent with no yolo flag always runs in default mode.
#
# Without a file, the built-in agents below apply; `trails config` writes them out as a
# starting point. Only agents whose command is on PATH are offered, so listing an agent you
# have not installed costs nothing.
#
# Choosing the conversation ID up front is the point of `session` — `--continue` means "the
# latest in this directory", so trails-foo and trails-foo-2 would both resume the same one.
#
# Recent conversations (closed rows) are read from claude's and opencode's own stores, and filed under
# the first agent that runs that command — the default agent, if it is one of them.
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/trails/config.json

DEFAULT_CONFIG='{
  "mode": "default",
  "default_agent": "claude",
  "agents": [
    {
      "name": "claude",
      "program": "claude",
      "yolo": "--dangerously-skip-permissions",
      "session": { "start": "--session-id {id}", "resume": "--resume {id}", "id": "uuid", "find": "claude" }
    },
    {
      "name": "codex",
      "program": "codex",
      "yolo": "--dangerously-bypass-approvals-and-sandbox",
      "session": { "resume": "resume {id}", "find": "codex" }
    },
    {
      "name": "gemini",
      "program": "gemini",
      "yolo": "--approval-mode yolo",
      "session": { "start": "--session-id {id}", "resume": "--resume {id}", "id": "uuid" }
    },
    {
      "name": "copilot",
      "program": "copilot",
      "yolo": "--allow-all",
      "session": { "start": "--session-id={id}", "resume": "--resume={id}", "id": "uuid" }
    },
    {
      "name": "cursor",
      "program": "cursor-agent",
      "yolo": "--force",
      "session": { "create": "cursor-agent create-chat", "resume": "--resume {id}" }
    },
    {
      "name": "opencode",
      "program": "opencode",
      "yolo": "--auto",
      "session": { "start": "--session {id}", "resume": "--session {id}", "id": "ses_hex" }
    }
  ]
}'

# The agents as one line each, name|command|args|yolo|start|resume|idform|create|find,
# default first.
# A bar, not a tab: tab is whitespace to `read`, which would merge the empty fields most
# agents have. jq does the JSON, because sed on hand-edited JSON is how a stray space in
# someone's config becomes a silent wrong answer. An agent with no usable name or program
# is skipped with a warning rather than failing the lot.
load_agents() {
  command -v jq >/dev/null 2>&1 || {
    echo "trails: needs jq to read its agents — brew install jq (or apt install jq)" >&2
    return 1
  }
  if [ -f "$CONFIG" ]; then
    json=$(cat "$CONFIG") || return 1
    src=$CONFIG
  else
    json=$DEFAULT_CONFIG
    src="the built-in agents"
  fi
  printf '%s' "$json" | jq -e '.agents | type == "array"' >/dev/null 2>&1 || {
    echo "trails: $src has no \"agents\": [ ... ] list — see trails help, or move it aside to use the built-ins" >&2
    return 1
  }
  out=$(printf '%s' "$json" | jq -r '
    def words: split(" ") | map(select(. != ""));
    (.default_agent // "") as $d
    | [.agents[]?] | (map(select(.name == $d)) + map(select(.name != $d)))[]
    | if (.name | type) != "string" or (.name | test("^[A-Za-z0-9._-]+$") | not)
         or (.program | type) != "string" or ((.program | words | length) == 0)
      then "!" + (.name // "(no name)" | tostring)
      else [.name, (.program | words | .[0]), (.program | words | .[1:] | join(" ")),
            (.yolo // ""), (.session.start // ""), (.session.resume // ""), (.session.id // ""),
            (.session.create // ""), (.session.find // "")]
           | map(tostring | gsub("\\|"; "")) | join("|")
      end' 2>&1) || {
    echo "trails: can't read $src: $out" >&2
    return 1
  }
  printf '%s\n' "$out" | while read -r line; do
    case $line in
      !*) echo "trails: skipping agent '${line#!}' in $src — it needs a name (letters, digits, . _ -) and a program" >&2 ;;
      *) printf '%s\n' "$line" ;;
    esac
  done
}

agent_row() {
  printf '%s\n' "$AGENTS" | awk -F'|' -v n="$1" '$1 == n { print; exit }'
}

# The config's mode, as "default" or "yolo". Anything else is a typo, and a typo must not
# decide to run every agent unconfirmed, so it reads as default with a warning.
load_mode() {
  if [ -f "$CONFIG" ]; then
    m=$(jq -r '.mode // "default"' "$CONFIG" 2>/dev/null) || m=default
  else
    m=$(printf '%s' "$DEFAULT_CONFIG" | jq -r '.mode // "default"')
  fi
  case $m in
    default | yolo) printf '%s' "$m" ;;
    *)
      echo "trails: mode is \"$m\" in $CONFIG — it takes \"default\" or \"yolo\"; using default" >&2
      printf default
      ;;
  esac
}

# The first agent that runs command $1 (by basename): who recent conversations from that
# agent's own store are filed under.
store_agent() {
  printf '%s\n' "$AGENTS" | awk -F'|' -v c="$1" '{ n = split($2, p, "/"); if (p[n] == c) { print $1; exit } }'
}

# Can agent $1 pick a conversation back up? It has a session.resume.
resumable() { [ -n "$1" ] && [ -n "$(agent_row "$1" | awk -F'|' '{ print $6 }')" ]; }

# A session template with its ID filled in. A template written as a bare flag ("--resume")
# gets the ID appended, which is what that spelling can only mean.
with_id() {
  case $1 in
    *"{id}"*) printf '%s' "$1" | sed "s/{id}/$2/g" ;;
    *) printf '%s %s' "$1" "$2" ;;
  esac
}

# `trails config` — the agents file, created from the built-ins the first time so there is
# something to edit, then opened in $EDITOR when there is a terminal to open it in.
edit_config() {
  if [ ! -f "$CONFIG" ]; then
    command -v jq >/dev/null 2>&1 || {
      echo "trails: needs jq — brew install jq (or apt install jq)" >&2
      exit 1
    }
    mkdir -p "$(dirname "$CONFIG")" || exit 1
    printf '%s\n' "$DEFAULT_CONFIG" | jq . >"$CONFIG" || exit 1
    echo "trails: wrote the built-in agents to $CONFIG" >&2
  fi
  if [ -t 0 ] && [ -t 1 ] && [ -n "${VISUAL:-${EDITOR:-}}" ]; then
    exec ${VISUAL:-$EDITOR} "$CONFIG"
  fi
  printf '%s\n' "$CONFIG"
}

# The flag that turns on an agent's YOLO (run-everything-unconfirmed) mode, empty for an agent
# that has none. toggle_yolo and launch both ask through here, so "which agents can be armed"
# has a single answer and a session name (an attach row) simply misses.
yolo_flag() {
  agent_row "$1" | awk -F'|' '{ print $4 }'
}

# Only offer an agent whose command actually exists here.
available_agents() {
  printf '%s\n' "$AGENTS" | while IFS='|' read -r name cmd _; do
    command -v "$cmd" >/dev/null 2>&1 && printf '%s\n' "$name"
  done
}

# ─── This project's sessions ─────────────────────────────────────────────────
# The one place the session prefix is spelled. sessions() and is_ours() both read it
# from here rather than hard-coding the string — two copies is two chances to rename
# only one of them.
PREFIX=trails-

# tmux forbids '.' and ':' in session names (both are target separators), and spaces
# make `tmux a -t <name>` a quoting chore. Two projects sharing a basename both want
# this name; the loser lands on an -N sibling and is_ours tells them apart by path.
# A function because restore re-derives it after cd'ing into each session's directory.
session_base() { printf '%s%s' "$PREFIX" "$(basename "$PWD" | tr ':. ' '___')"; }
SESSION=$(session_base)

# One definition of "a session of ours": a trails- session started in this directory.
# The menu and the kill both ask through here.
#
# Not the name, because the name cannot answer it. `trails-foo-2` is equally "foo's
# second agent" and "project foo-2's first", and reading it as the former let the picker
# list — and ctrl-x kill — another project's live session. The exact name is no better:
# ~/a/foo and ~/b/foo both want trails-foo, so whoever launched second sits on
# trails-foo-2 and the name says nothing about which of them owns it.
#
# So ask tmux where the session was started: launch() passes -c "$PWD" and tmux keeps it
# verbatim as #{session_path}. Exact, needs no bookkeeping of our own, and already true
# of every session started before this rule existed.
#
# The prefix check leads and does the refusing — a "new  claude" row reaches kill_session
# as the agent name and must not resolve to a session at all. No "=" on -t: unlike
# has-session, display-message ignores it and silently answers nothing (same trap as
# set-option, see launch()). Safe without: these names always come from a live
# list-sessions, so an exact match exists and wins.
is_ours() {
  case $1 in
    "$PREFIX"*) ;;
    *) return 1 ;;
  esac
  [ "$(tmux display-message -pt "$1" '#{session_path}' 2>/dev/null)" = "$PWD" ]
}

# Wrap the agent in tmux everywhere except inside tmux itself, where the process is
# persistent anyway and nesting would double every prefix key. The map is the
# exception, and the dispatch turns USE_TMUX back on for it (see in_map).
USE_TMUX=
if [ -z "$TMUX" ] && command -v tmux >/dev/null 2>&1; then
  USE_TMUX=1
fi

TAB=$(printf '\t')

# Agents running here. ("Zed reconnected" and "give me a second agent" are
# indistinguishable from here, so show what's running and let you choose.)
#
# Three labels answering three questions:
#   @agent      what is running (claude, cursor, opencode). launch() wrote it down;
#               falls back to the process name for a session we did not start.
#   $TASK_FMT   what it's working on — the agent's own session name, published as the
#               terminal title (OSC 2) and exposed by tmux as pane_title. Claude Code
#               puts its /resume summary there.
#   status      whether it's working or wants you back — see live_sessions below.
#
# TASK_FMT defends against two things: tmux seeds pane_title with the *hostname*, so
# "has a title" is not "is non-empty" (an unset pane reads back `airbochs`) — compared
# against #{host} and not #{host_short}, because that seed is gethostname() verbatim and
# the two differ wherever the box answers with an FQDN; and Claude Code prefixes an
# animated spinner glyph, so a leading glyph is stripped.
#
# "Glyph" has to be spelled out rather than taken as "whatever comes first". `^[^ ]+ `
# ate the first word of any title that had one — "Fixing the flaky test" displayed as
# "the flaky test", and a quoted opener lost the quote and the word inside it. Barring
# alphanumerics from the run confines it to decoration: every Claude title (✳, ⠂) still
# loses its glyph, and a title that opens with a plain word now survives whole, as one
# with no glyph and no space (opencode's "OpenCode") always did.
TASK_FMT='#{=45:#{?#{==:#{pane_title},#{host}},,#{s|^[^A-Za-z0-9 ]+ ||:pane_title}}}'

# ─── Is this agent working, or does it want you? ─────────────────────────────
# The question the picker exists to answer, and "wants you" is the only reason you
# opened it. tmux's session_attached is a fact about your terminal, not the agent —
# every session here reads "attached" whether mid-edit or sat on a finished turn.
#
# The signal is the screen, and it's agent-agnostic: every one of these TUIs animates
# while it works (spinner, token count, timer), so a working pane's screen differs
# 300ms later and a stopped one's is byte-identical. A permission prompt doesn't
# animate (the blinking cursor is drawn by the terminal, not the pty). So: hash the
# screen, wait, hash again.
#
# That's why there are no hooks. Claude Code's Stop/PermissionRequest hooks would
# report this exactly — and only for Claude; cursor-agent, opencode and antigravity
# have nothing, so a hook-built status would light one row and leave the rest blank.
# Repainting a pty is the one thing all four already do.
#
# And not a tmux timestamp: #{session_activity} tracks tmux's sticky alert bookkeeping,
# not pty bytes — a detached pane printing every 200ms still had its "activity" age
# grow 0 → 3 → 5s. Two captures is the honest way, and costs one sleep for the list.
#
#   working   the screen changed across the gap
#   blocked   still, and the bottom is asking you a question
#   idle      still, and not asking — finished its turn, your move
#
# blocked-vs-idle is the one heuristic: it greps the screen, so an agent that prints
# "Approve" can fool it. Both mean "wants you" and sort above working, so a wrong guess
# costs a colour. AGENT_ASK_RE overrides the pattern for an agent that asks in other words.
#
# AGENT_SETTLE is the gap, and the whole latency this adds. It must outlast the slowest
# repaint of a *working* agent; real ones spin at ~10Hz (Claude repainted on 5/5 samples
# 300ms apart), so 0.35 has room. The error is one-sided by construction: guessing
# working needs both samples to differ, so a still screen can never read as working. The
# bad case is a slow agent shown idle (you open it and it's busy); a stopped agent
# hidden under "working" cannot happen.
SETTLE=${AGENT_SETTLE:-0.35}
ASK_RE=${AGENT_ASK_RE:-'Do you want|Would you like|Allow |Approve|\[y/[nN]\]|\(y/[nN]\)|❯ +[0-9]\.'}

RED=$(printf '\033[31m')
YEL=$(printf '\033[33m')
CYN=$(printf '\033[36m')
DIM=$(printf '\033[2m')
RST=$(printf '\033[0m')

# The *visible* screen only (no -S): a question is on screen by definition, and
# scrollback would turn old questions into current ones.
#
# Both samples must hash through the identical pipeline or every session reads as
# working forever: `$(screen_of x)` strips the capture's trailing blank rows (command
# substitution eats trailing newlines) and piping straight to cksum does not, so the
# two passes hashed different bytes. screen_hash takes the *content*, so both callers
# normalise the same way by construction.
screen_of() { tmux capture-pane -pt "$1" 2>/dev/null; }
screen_hash() { printf '%s\n' "$1" | cksum; }

# Every agent session on the box, TSV: name, agent, task. Unclassified and unfiltered —
# is_ours narrows it to this project for the picker, `trails ls` keeps the lot.
#
# Also the one place a session's record learns what it is working on (rec_note_task): the
# task is only ever on screen, and a session that dies takes its screen with it. This runs
# every time anything asks — the SwiftBar plugin polls `trails ls` every 10s — so the
# record is never more than a poll behind, and a lost row can say what it was doing.
sessions() {
  tmux list-sessions -F \
    "#{session_name}|#{?@agent,#{@agent},#{pane_current_command}}|$TASK_FMT" 2>/dev/null |
    while IFS='|' read -r name label task; do
      case $name in
        "$PREFIX"*)
          rec_note_task "$name" "$task"
          rec_note_id "$name"
          printf '%s\t%s\t%s\n' "$name" "$label" "$task"
          ;;
        *) ;; # a tmux session you started yourself — not ours to report on
      esac
    done
}

# stdin: name/agent/task. stdout: the same with a state in front. The sleep is paid
# once for the whole list: hash every screen, wait, hash every screen again.
classify() {
  rows=$(cat)
  [ -n "$rows" ] || return 0

  before=$(printf '%s\n' "$rows" | cut -f1 | while read -r name; do
    printf '%s\t%s\n' "$name" "$(screen_hash "$(screen_of "$name")")"
  done)
  sleep "$SETTLE"

  printf '%s\n' "$rows" | while IFS="$TAB" read -r name label task; do
    now=$(screen_of "$name")
    was=$(printf '%s\n' "$before" | awk -F"$TAB" -v n="$name" '$1 == n { print $2 }')

    if [ "$(screen_hash "$now")" != "$was" ]; then
      state=working
    elif printf '%s\n' "$now" | awk 'NF' | tail -n 15 | grep -Eq "$ASK_RE"; then
      state=blocked
    else
      state=idle
    fi
    printf '%s\t%s\t%s\t%s\n' "$state" "$name" "$label" "$task"
  done
}

# ─── Session states ───────────────────────────────────────────────────────────
# Two questions, two signals. Is the tmux session there? The glyph says: ● running, ○ not.
# If it is, what is the agent doing; if it isn't, why not, and can it come back? The word
# says, in its colour. Every view — the picker, `trails ls`, their legends, the map — draws
# a state from this one table, so a state is named and drawn one way everywhere.
#
#   id|glyph|colour|word|legend, most-wants-you first (the order is the sort order)
#
# running:  needs you  the agent is asking you something (a permission prompt, a question)
#           your turn  it finished its turn and is waiting on you
#           working    it is getting on with it
# stopped:  lost       tmux died under it (a reboot, a crash); `trails restore` brings it back
#           closed     it ended, and its conversation can be resumed
#           elsewhere  its conversation is open in a claude trails did not start
#
#   start/resume/restore ──▶ working ⇄ your turn ⇄ needs you ──(you quit)──▶ closed
#                                         └──────────(tmux dies)──────────▶ lost
STATES='needs-you|●|red|needs you|running, asking you something
your-turn|●|yellow|your turn|running, finished its turn
working|●|dim|working|running, busy
lost|○|plain|lost|not running: tmux died · trails restore brings it back
closed|○|dim|closed|not running: it ended · resume it from its directory
elsewhere|○|dim|elsewhere|not running here: open in a claude trails did not start'

# STATES on one line, `;` between states, for awk: macOS's awk refuses a -v value with a
# newline in it. No state's text has a `;`.
STATES_FLAT=$(printf '%s' "$STATES" | tr '\n' ';')

# classify()'s screen verdict (blocked, idle, working) → the state it is shown as.
state_of() {
  case $1 in
    blocked) echo needs-you ;;
    idle) echo your-turn ;;
    *) echo working ;;
  esac
}

# The awk that turns STATES into lookups: rank[], glyph[], word[], legend[] and paint[], the
# colour escape. Shared text rather than a function, because every caller is already in awk
# when it needs it, and a shell callout per row would be absurd.
STATES_AWK='
  BEGIN {
    ns = split(states, L, ";")
    for (i = 1; i <= ns; i++) {
      split(L[i], f, "|"); id = f[1]; order[i] = id; rank[id] = i
      glyph[id] = f[2]; word[id] = f[4]; legend[id] = f[5]
      paint[id] = f[3] == "red" ? red : (f[3] == "yellow" ? yel : (f[3] == "dim" ? dim : ""))
    }
  }
  function show(id) { return paint[id] glyph[id] " " sprintf("%-9s", word[id]) rst }
  function key(id) { return paint[id] glyph[id] " " sprintf("%-9s", word[id]) rst "  " legend[id] }
'

# rank and colour for the map, which draws in shell: sets $rank, $dot and $word. classify()
# state in, so the map need not translate first.
rank_dot() {
  case $1 in
    blocked) rank=0 dot=$RED word="needs you" ;;
    idle) rank=1 dot=$YEL word="your turn" ;;
    *) rank=2 dot=$DIM word=working ;;
  esac
}

# `trails ls` — where every agent session on this machine is: running, lost with tmux, or
# ended recently. Deliberately not scoped to $PWD: the picker answers "what's here", this
# answers "what did I leave where" — the question the menu-bar plugin asks too
# (extras/swiftbar, the caller the TSV was built for).
#
# ls_rows is the one list, TSV, in display order:
#
#   life  state  session  agent  yolo  dir  id  when  pid  title
#
#   life     running (the tmux session is there) or stopped (it isn't)
#   state    a STATES id: needs-you, your-turn, working · lost, closed, elsewhere
#   session  the tmux session name, or - for a conversation nothing is running
#   yolo     yolo or -
#   when     when an ended conversation was last active (Unix time), - otherwise
#   pid      the process holding an "elsewhere" one, - otherwise
#
# Never an empty field mid-row, for recent_rows' reason, and the title last since it is free
# text. In STATES order, each state keeping its own: running sessions most-wants-you first,
# ended ones newest first.
ls_rows() {
  sessions | classify | while IFS="$TAB" read -r state name label task; do
    agent=${label%% *}
    yolo=-
    case $label in *"(YOLO)"*) yolo=yolo ;; *) ;; esac
    dir=$(tmux display-message -pt "$name" '#{session_path}' 2>/dev/null)
    id=$(tmux display-message -pt "$name" '#{@trails_id}' 2>/dev/null)
    printf 'running\t%s\t%s\t%s\t%s\t%s\t%s\t-\t-\t%s\n' \
      "$(state_of "$state")" "$name" "$agent" "$yolo" "${dir:--}" "${id:--}" "$task"
  done | awk -F"$TAB" -v states="$STATES_FLAT" "$STATES_AWK"'
    { n++; row[n] = $0; st[n] = $2 }
    END { for (r = 1; r <= ns; r++) for (i = 1; i <= n; i++) if (rank[st[i]] == r) print row[i] }'
  rec_dead | while read -r name; do
    yolo=$(rec_get "$name" yolo)
    printf 'stopped\tlost\t%s\t%s\t%s\t%s\t%s\t-\t-\t%s\n' "$name" "$(rec_get "$name" agent)" \
      "${yolo:--}" "$(rec_get "$name" dir)" "$(rec_get "$name" id)" "$(rec_get "$name" task)"
  done
  recent_rows "" | while IFS="$TAB" read -r m agent dir id yolo pid title; do
    state=closed
    [ "$pid" = - ] || state=elsewhere
    printf 'stopped\t%s\t-\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$state" "$agent" "$yolo" "$dir" "$id" "$m" "$pid" "$title"
  done
}

# Two audiences, so two views: the TSV above for a notifier, and for a person one row per
# session in columns — a tab jumps to the next 8-stop, so a TSV on screen is a ragged grid.
# `[ -t 1 ]` tells them apart with no flag: a caller's `$(...)` is a pipe.
#
#   ● needs you  claude · yolo  ~/code/api                Rework the retry budget
#   ● your turn  claude         ~/.dotfiles #2            Fix the flaky test
#   ○ lost       claude · yolo  ~/code/foundry            Improve observability
#   ○ closed     claude         ~/notes         2h ago    Weekly review
#
# The #2 is read off the session name against its directory, and only then: trails-<dir> is
# the first agent there and trails-<dir>-N the Nth, but the name alone could equally be
# project <dir>-N's first, so a name that doesn't match its own directory gets no badge.
list_sessions() {
  rows=$(ls_rows)
  [ -t 1 ] || {
    [ -z "$rows" ] || printf '%s\n' "$rows"
    return 0
  }
  [ -n "$rows" ] || {
    echo "trails: no agent sessions, and none ended in the last $RECENT_DAYS days"
    return 0
  }

  # Widths off the widest cell, the agent column measured on an ASCII stand-in: awk counts
  # bytes, and the · in "claude · yolo" is two of them. A dim legend follows for the states
  # this listing used, in table order — reference, not news.
  printf '%s\n' "$rows" | awk -F"$TAB" -v now="$(date +%s)" -v home="$HOME" -v pfx="$PREFIX" \
    -v states="$STATES_FLAT" -v red="$RED" -v yel="$YEL" -v dim="$DIM" -v rst="$RST" "$STATES_AWK"'
    function ago(t,   d) {
      d = now - t
      if (d < 3600) return int(d / 60) "m ago"
      if (d < 86400) return int(d / 3600) "h ago"
      return int(d / 86400) "d ago"
    }
    {
      n++; st[n] = $2; nm = $3; dir = $6
      ag[n] = $4 ($5 == "yolo" ? " · yolo" : ""); aw[n] = length($4 ($5 == "yolo" ? " - yolo" : ""))
      badge = ""
      if (nm != "-") {
        base = dir; sub(/.*\//, "", base); gsub(/[:. ]/, "_", base); base = pfx base
        rest = substr(nm, length(base) + 2)
        if (index(nm, base "-") == 1 && rest ~ /^[0-9]+$/) badge = " #" rest
      }
      if (index(dir, home) == 1) dir = "~" substr(dir, length(home) + 1)
      c3[n] = dir badge
      c4[n] = $8 != "-" ? ago($8) : ""
      ti[n] = $10 ($2 == "elsewhere" ? "  (open in " $4 ", pid " $9 ")" : "")
      if (aw[n] > w2) w2 = aw[n]
      if (length(c3[n]) > w3) w3 = length(c3[n])
      if (length(c4[n]) > w4) w4 = length(c4[n])
      seen[$2] = 1
    }
    END {
      for (i = 1; i <= n; i++) {
        line = show(st[i]) "  " ag[i] sprintf("%*s", w2 - aw[i], "") "  " sprintf("%-*s", w3, c3[i])
        if (w4) line = line "  " sprintf("%-*s", w4, c4[i])
        line = line "  " ti[i]
        sub(/ +$/, "", line)
        print line
      }
      first = 1
      for (k = 1; k <= ns; k++) {
        if (!(order[k] in seen)) continue
        if (first) { print ""; first = 0 }
        print dim glyph[order[k]] " " sprintf("%-9s", word[order[k]]) "  " legend[order[k]] rst
      }
    }'
}

# Menu lines are TAB-delimited; fzf draws only field 3 on (--with-nth). Fields 1-2 are
# carried but never drawn: field 1 (verb) is what the dispatch matches for attach-vs-launch,
# field 2 (target) is what ctrl-x reads as {2}. The session name is worth hiding — every
# row is the same project, so `trails-_dotfiles` repeats identically and in a half-width
# pane pushed the task (the part that differs) off the end. The suffix survives as a `#2` badge.
#
# This emits one more field in front — the agent — which print_menu strips after using it to
# file each session under its agent's "new" row. The agent is left out of the drawn badge for
# the same reason: the row it hangs under already says it.
#
# Sorted by what it wants from you: blocked, idle, then the ones getting on with it — the
# order each agent's branch keeps, and what the dispatch reads to land the cursor on the
# session you have to unblock.
live_sessions() {
  sessions | while IFS="$TAB" read -r name label task; do
    is_ours "$name" || continue
    printf '%s\t%s\t%s\n' "$name" "$label" "$task"
  done | classify | while IFS="$TAB" read -r state name label task; do
    # launch() writes @agent as "claude (YOLO)" for an armed launch: the first word is the
    # agent, and the YOLO it ran with goes in its own field.
    agent=${label%% *}
    yolo=-
    case $label in *"(YOLO)"*) yolo=yolo ;; *) ;; esac
    printf '%s\tattach\t%s\t%s\t%s\t%s\t-\t%s\n' \
      "$(state_of "$state")" "$name" "$agent" "$yolo" "$(ordinal "$name")" "$task"
  done
}

# The #2 a session's name earns in the picker: the -N on $SESSION-<digits>, and only that.
# is_ours admits any trails- session started here, so a name that isn't $SESSION-<digits>
# (one you made by hand) would otherwise badge itself with the whole leftover string. "-"
# for none: these feed tab-separated rows, where an empty field would collapse.
ordinal() {
  n=${1#"$SESSION"}
  n=${n#-}
  case $n in
    '' | *[!0-9]*) echo - ;;
    *) echo "#$n" ;;
  esac
}

# What a session of ours looks like. Everything here is session-scoped, so a tmux
# session you started yourself keeps its own keys, chrome and layout. Applied on create
# *and* on attach, so a session started before any of this existed picks it up next time.
#
# @agent_locked marks "one agent, one pane": a session here *is* an agent (Zed, nvim and
# the picker each treat it as a single view), so a second pane would make all three lie.
# The enforcing lives in tmux.conf, where the split/new-window keys are guarded by
# `if -F '#{@agent_locked}'` — tmux has no before-split-window, so a hook could only
# create the pane then kill it; a guarded key refuses and nothing is created. Deliberate
# routes stay open: `tmux split-window -t <session>`, join-pane (fires no hook), and the
# prefix + < / > context menus.
#
# No status bar: it would spend the bottom row on a session name you already know, a
# clock, and a one-window list. No pane border either — tmux.conf sets pane-border-status
# top *globally* (useful in a grid), but an agent session is a single pane, so that label
# is dead weight costing a line of height. Both overridden per-session, so a grid you
# build yourself keeps them.
apply_policy() {
  tmux set-option -t "$1" @agent_locked 1
  tmux set-option -t "$1" status off
  tmux set-option -t "$1" pane-border-status off
}

# Taken means running, or recorded: a session that died with tmux keeps its name reserved
# until it is restored or forgotten. Otherwise a fresh agent started in that project after a
# reboot would land on the dead one's name and its new record would overwrite the old — the
# one pointer to the conversation you meant to come back to.
name_taken() { tmux has-session -t "=$1" 2>/dev/null || [ -f "$(rec_path "$1")" ]; }

next_free() {
  name_taken "$SESSION" || {
    printf '%s' "$SESSION"
    return
  }
  n=2
  while name_taken "$SESSION-$n"; do
    n=$((n + 1))
  done
  printf '%s-%s' "$SESSION" "$n"
}

# ─── Picker internals (invoked by fzf, one process each) ─────────────────────
# These are subcommands rather than shell inline in the fzf flags: fzf single-quotes
# every placeholder and runs the result through $SHELL, where zsh expands a bare leading
# `=` to a command path — both traps silently ate the kill. As subcommands they're plain
# shell and directly testable: `trails --kill <name>`.

# ctrl-x: kill the highlighted session. Sessions outlive the terminal that started them,
# so nothing else ever reaps them. is_ours guards it: a "new  default" row would otherwise
# hand us the agent name and try to kill a session literally called "default".
#
# On a lost row it forgets instead: there is no process to kill, only the record that would
# bring one back. restorable_here guards that half the way is_ours guards the other.
#
# A kill is on purpose, so it forgets the record too. The agent's wrapper would forget it
# anyway were it allowed to finish, but kill-session hangs up on the wrapper along with the
# agent — which is exactly what keeps a record alive when tmux dies — so it never gets to.
kill_session() {
  if restorable_here "$1"; then
    rec_forget "$1"
    return 0
  fi
  is_ours "$1" || return 0
  tmux kill-session -t "=$1" 2>/dev/null
  rec_forget "$1"
  # Recompute the cached running block so the reload that follows drops the killed row (and
  # re-reads the survivors' state). Guarded on the cache path so a bare `trails --kill x` (no
  # picker, path unset) skips it. This is the one reload that pays classify's settle sleep, and
  # it should: a kill is rare and wants fresh state — unlike a Tab, which only relabels.
  [ -n "$TRAILS_MENU_CACHE" ] && live_sessions >"$TRAILS_MENU_CACHE"
}

# tab: flip the highlighted row from the config's mode — arm it for YOLO, or under "mode":
# "yolo" take a "+ new" row back to default mode — and flip it back on a second Tab. Exactly one
# agent can be armed at a time — arming a second replaces the first — so the state is a single
# name in a file, not a set. Only an agent with a YOLO flag can be armed; Tab on an attach row
# (a session name) or a flagless agent (pi, antigravity) finds no flag and is a no-op. A closed row
# arms too: its target is agent:id, and the flag is its agent's. The
# file is $TRAILS_YOLO_STATE, exported by the dispatch below and so inherited by this
# subprocess fzf spawns. print_menu reads the same file to relabel the row and set its verb.
toggle_yolo() {
  [ -n "$TRAILS_YOLO_STATE" ] || return 0
  [ -n "$(yolo_flag "${1%%:*}")" ] || return 0
  cur=
  [ -s "$TRAILS_YOLO_STATE" ] && cur=$(cat "$TRAILS_YOLO_STATE")
  if [ "$cur" = "$1" ]; then
    : >"$TRAILS_YOLO_STATE"
  else
    printf '%s' "$1" >"$TRAILS_YOLO_STATE"
  fi
}

# The picker: this directory's sessions first — what you usually came for — then the agents
# you can start, under a "start new" rule. Re-run by fzf after every Tab and ctrl-x, hence a
# subcommand.
#
# Every row is three tab-separated fields: verb, target, what's drawn. fzf draws only the
# third (--with-nth); the verb is what the dispatch matches on Enter, the target what Tab and
# ctrl-x act on. Sessions are gathered first as raw rows —
#
#   state  verb  target  agent  yolo  badge  when  title
#
# — then drawn together, so their columns line up across running and stopped alike.
print_menu() {
  agents=$(available_agents)
  [ -n "$agents" ] || {
    echo "trails: no agent CLIs found on PATH" >&2
    exit 1
  }
  # Running sessions, from the cache the dispatch classified once. classify() sleeps
  # AGENT_SETTLE to sample each screen twice, and this runs on every Tab and ctrl-x; the
  # snapshot is fixed for the picker's life anyway (fzf never live-refreshes it). Empty with
  # no tmux.
  running=
  [ -n "$TRAILS_MENU_CACHE" ] && [ -s "$TRAILS_MENU_CACHE" ] && running=$(cat "$TRAILS_MENU_CACHE")

  # The one row Tab flipped (toggle_yolo wrote it); empty if none.
  armed=
  [ -n "$TRAILS_YOLO_STATE" ] && [ -s "$TRAILS_YOLO_STATE" ] && armed=$(cat "$TRAILS_YOLO_STATE")

  # Lost: sessions here that died with tmux. Read fresh on every reload — a few small files,
  # and ctrl-x on one has to see it gone. TRAILS_RESTORE_OK is the dispatch's verdict,
  # exported because this also runs as fzf's reload subprocess, which can't see the map's
  # USE_TMUX override.
  lost=
  if [ -n "$TRAILS_RESTORE_OK" ]; then
    lost=$(rec_dead | while read -r name; do
      [ "$(rec_get "$name" dir)" = "$PWD" ] || continue
      yolo=$(rec_get "$name" yolo)
      printf 'lost\trestore\t%s\t%s\t%s\t%s\t-\t%s\n' "$name" "$(rec_get "$name" agent)" \
        "${yolo:--}" "$(ordinal "$name")" "$(rec_get "$name" task)"
    done)
  fi

  # Closed and elsewhere: recent conversations here that nothing is running, from the
  # dispatch's cache (reading them costs ~150ms, which every Tab would pay). The target is
  # agent:id. One that last ran YOLO resumes YOLO, the way a lost one comes back in its
  # recorded mode; Tab arms one that didn't ("armed" draws its yolo in yellow). One still open
  # in a claude trails didn't start is shown so you know where it went, under a verb the
  # dispatch refuses.
  recent=
  if [ -n "$TRAILS_RECENT_CACHE" ] && [ -s "$TRAILS_RECENT_CACHE" ]; then
    now=$(date +%s)
    recent=$(while IFS="$TAB" read -r m agent _ id yolo pid title; do
      if [ "$pid" != - ]; then
        printf 'elsewhere\topen\t%s:%s\t%s\t%s\t-\t%s\t%s  (open in %s, pid %s)\n' \
          "$agent" "$id" "$agent" "$yolo" "$(ago "$m" "$now")" "$title" "$agent" "$pid"
        continue
      fi
      verb=resume
      if [ "$yolo" = yolo ]; then
        verb='resume-yolo'
      elif [ "$agent:$id" = "$armed" ]; then
        verb=resume-yolo yolo=armed
      fi
      printf 'closed\t%s\t%s:%s\t%s\t%s\t-\t%s\t%s\n' \
        "$verb" "$agent" "$id" "$agent" "$yolo" "$(ago "$m" "$now")" "$title"
    done <"$TRAILS_RECENT_CACHE")
  fi

  # `$(...)` eats trailing newlines, so each block gets its own back or the last row of one
  # welds onto the first of the next.
  rows=$(
    [ -n "$running" ] && printf '%s\n' "$running"
    [ -n "$lost" ] && printf '%s\n' "$lost"
    [ -n "$recent" ] && printf '%s\n' "$recent"
  )

  # Drawn in state order (the STATES table's), keeping each state's own order — closed ones
  # newest first. Widths off the widest cell, the agent column measured on an ASCII stand-in:
  # awk counts bytes, and the · in "claude · yolo" is two of them.
  [ -n "$rows" ] && printf '%s\n' "$rows" | awk -F"$TAB" -v OFS="$TAB" -v states="$STATES_FLAT" \
    -v red="$RED" -v yel="$YEL" -v dim="$DIM" -v rst="$RST" "$STATES_AWK"'
    NF >= 8 {
      n++; st[n] = $1; vb[n] = $2; tg[n] = $3; ag[n] = $4; yo[n] = $5; ti[n] = $8
      aw[n] = length($4 ($5 == "-" ? "" : " - yolo")); if (aw[n] > w2) w2 = aw[n]
      c3[n] = ($6 != "-" ? $6 : "") ($7 != "-" ? $7 : ""); if (length(c3[n]) > w3) w3 = length(c3[n])
    }
    END {
      for (r = 1; r <= ns; r++) for (i = 1; i <= n; i++) {
        if (rank[st[i]] != r) continue
        y = yo[i] == "yolo" ? " · yolo" : (yo[i] == "armed" ? " · " yel "yolo" rst : "")
        line = show(st[i]) "  " ag[i] y sprintf("%*s", w2 - aw[i], "")
        if (w3) line = line "  " sprintf("%-*s", w3, c3[i])
        line = line "  " ti[i]
        sub(/ +$/, "", line)
        print vb[i], tg[i], line
      }
    }'

  # Then the agents you can start. The rule above them is a row like any other to fzf, so it
  # carries a verb the dispatch reads as "nothing chosen" and reopens the picker on.
  [ -n "$rows" ] && printf 'none\t-\t%s─── start new ──────────────────────────%s\n' "$DIM" "$RST"
  # An agent's row is YOLO when the config's mode says so or Tab flipped it, not both — and
  # only if the agent has a flag at all. Then its verb is "yolo" and it says so in yellow.
  for a in $agents; do
    y=
    if [ "$MODE" = yolo ]; then
      [ "$a" = "$armed" ] || y=1
    else
      [ "$a" = "$armed" ] && y=1
    fi
    if [ -n "$y" ] && [ -n "$(yolo_flag "$a")" ]; then
      printf 'yolo\t%s\t▸ %s  %s(YOLO)%s\n' "$a" "$a" "$YEL" "$RST"
    else
      printf 'new\t%s\t▸ %s\n' "$a" "$a"
    fi
  done
}

# ─── Launch ──────────────────────────────────────────────────────────────────
# How long to give an agent to fall over before assuming it came up, and the whole cost of
# the dead-on-arrival guard in launch() — every launch that works waits this long before
# attaching.
#
# It buys margin over a real measurement: cursor-agent with no keychain took 350ms and
# 650ms to die on two runs, and a bare `echo; exit 1` took 350-450ms, most of it process
# startup rather than the failure itself. So a value near the measurement is not safe —
# 0.5 sat inside the range and let the very failure this exists for through. 1.5 is ~2.3x
# the slowest seen.
#
# Guessing low is not a cheap mistake, which is what pushed this up rather than down: the
# check turns remain-on-exit back off, so an agent dying just after the deadline has its
# session torn down with the error inside it — the exact silence this guard removes. A
# death later than this reads as a normal exit and you are back to today's behaviour, so
# the guard only ever adds.
BOOT=1.5

# Created detached, stamped with @agent, then attached — not a single new-session, which
# would exec away before we could set the option. @agent records which entry you picked so
# the picker can label the session without inspecting it: claude reports `claude.exe`,
# cursor-agent reports bare `node`, only opencode sets a pane title.
#
#   launch AGENT [yolo] [RESUME_ID] [NAME]
#
# The last two are restore's: RESUME_ID picks up that conversation instead of starting one,
# and NAME is the session name to come back under if it is still free. With LAUNCH_DETACHED
# set, it prints the session name and returns instead of attaching — restore needs the name
# back, and `trails restore` brings back several without sitting in any of them.
launch() {
  row=$(agent_row "$1")
  [ -n "$row" ] || {
    echo "trails: unknown agent '$1'" >&2
    exit 1
  }
  # args is normally empty; the yolo flag is appended only when this launch was armed (see
  # mode below), and the session templates only matter to agents that can be restored.
  IFS='|' read -r _ cmd args yolo start resume idform create find <<EOF
$row
EOF

  # $2 is "yolo" when the picker row was Tab-armed, empty otherwise. A row can only be armed
  # if it has a flag (toggle_yolo enforces it), so the empty-flag branch is belt-and-braces
  # rather than a path the picker can reach.
  if [ "$2" = yolo ]; then
    [ -n "$yolo" ] || {
      echo "trails: $1 has no YOLO mode" >&2
      exit 1
    }
    args="${args:+$args }$yolo"
  fi

  # Skip-permissions mode runs any command unconfirmed, so refuse the one place left where
  # that is catastrophic rather than merely unwise. Only the yolo launch is refused: plain,
  # prompting mode is merely ordinary as root.
  #
  # Keyed on the flag, not the agent, so any agent using one of these is covered however
  # it is named: --dangerously-skip-permissions (claude, and agy, which reused the name) also
  # auto-approves the sandbox-bypass prompt, and codex's --dangerously-bypass-approvals-and-sandbox
  # drops the sandbox outright. That is what makes them, and not --force or --auto, the ones
  # worth refusing as root.
  if [ "$2" = yolo ] && [ "$(id -u)" -eq 0 ]; then
    case $yolo in
      *--dangerously-skip-permissions* | *--dangerously-bypass-approvals-and-sandbox*)
        echo "trails: refusing $1 $yolo as root" >&2
        exit 1
        ;;
    esac
  fi

  # $args is a controlled, space-separated field from the table above; splitting it into
  # separate arguments is the point. A closed row resumes here too, with nothing to record: there
  # is no tmux session for a record to bring back.
  # shellcheck disable=SC2086
  [ -n "$USE_TMUX" ] || exec "$cmd" $args ${3:+$(with_id "$resume" "$3")}

  # The conversation ID: the one being resumed, or one this session starts under so it can be
  # resumed later — chosen here (session.start), or asked of the agent (session.create, a
  # command that prints a fresh ID, then started on with session.resume). An agent that can
  # only make its own IDs (session.find) starts with none: rec_note_id reads the ID back once
  # the agent has written it, and writes the record then. No session block, no record.
  id=
  if [ -n "$3" ]; then
    id=$3
    args="${args:+$args }$(with_id "$resume" "$id")"
  elif [ -n "$start" ] && [ -n "$resume" ]; then
    id=$(new_id "$idform")
    args="${args:+$args }$(with_id "$start" "$id")"
  elif [ -n "$create" ] && [ -n "$resume" ]; then
    id=$(sh -c "$create" 2>/dev/null | awk 'NF { print $1; exit }')
    case $id in
      '' | *[!A-Za-z0-9._-]*)
        echo "trails: \`$create\` gave no usable ID — starting $1 without restore" >&2
        id=
        ;;
      *) args="${args:+$args }$(with_id "$resume" "$id")" ;;
    esac
  fi

  # Restore asks for its old name back, and gets it unless something has since taken it —
  # a fresh agent you started in that project after the reboot, say. Then it lands on the
  # next free -N like any second agent would, and the old name's record goes with it below.
  if [ -n "$4" ] && ! tmux has-session -t "=$4" 2>/dev/null; then
    SESSION=$4
  else
    SESSION=$(next_free)
  fi

  # Written before the agent starts, not after it survives BOOT: the wrapper's --forget is
  # what clears it, and that only works if the record is already there when the agent exits.
  # An agent that dies at 1.6s would otherwise outrun its own record and leave a lost row for a
  # session that never was.
  [ -n "$id" ] && rec_write "$SESSION" "$1" "$PWD" "$id" "$2"
  [ -n "$4" ] && [ "$4" != "$SESSION" ] && rec_forget "$4"
  # No "=" prefix on set-option: it does not accept one and fails with `no such session:
  # =name` (attach-session and has-session do accept it). Safe anyway — we just created
  # this exact name.
  #
  # remain-on-exit keeps the pane after the agent exits, so the guard below can read why.
  # Chained into new-session's own command list rather than set by a second tmux call: an
  # agent that dies in milliseconds is reaped before a follow-up call can land, which is
  # the exact case worth catching. remain-on-exit-format '' drops tmux's own "Pane is
  # dead" banner, leaving the capture to be the agent's words and nothing else.
  #
  # The agent runs under $WRAP (see "Surviving tmux"), which forgets the record when the
  # agent exits by itself and is killed alongside it when tmux goes.
  # shellcheck disable=SC2086
  tmux new-session -d -s "$SESSION" -c "$PWD" \
    sh -c "$WRAP" trails-wrap "$SELF" "$SESSION" "$cmd" $args \
    \; set-option -w -t "$SESSION" remain-on-exit on \
    \; set-option -w -t "$SESSION" remain-on-exit-format '' || exit 1
  # The picked entry, tagged (YOLO) when armed, so the picker and status table can label the
  # session without inspecting the process. ${2:+ (YOLO)} adds the tag only for a yolo launch.
  tmux set-option -t "$SESSION" @agent "$1${2:+ (YOLO)}"
  # Which conversation this is, so rec_is_dead can tell this session from a stranger that
  # happens to share its name.
  [ -n "$id" ] && tmux set-option -t "$SESSION" @trails_id "$id"

  # Dead on arrival. tmux drops a session the moment its command exits and the error goes
  # with it, so an agent that can't start (bad token, no keychain) made trails look like it
  # simply did nothing — the failure and a successful launch were both silence. Print what
  # the agent said rather than attaching to a corpse.
  #
  # -S- to read history, unlike screen_of(): a dying pane scrolls its output up out of the
  # visible screen, so the last thing it said is only in the scrollback.
  sleep "$BOOT"
  if [ "$(tmux display-message -pt "$SESSION" '#{pane_dead}' 2>/dev/null)" = 1 ]; then
    echo "trails: $1 exited immediately (status $(tmux display-message -pt "$SESSION" '#{pane_dead_status}' 2>/dev/null))" >&2
    tmux capture-pane -pS- -t "$SESSION" 2>/dev/null | awk 'NF' | tail -n 15 >&2
    tmux kill-session -t "=$SESSION" 2>/dev/null
    rec_forget "$SESSION"
    exit 1
  fi
  # Survived, so back to the default: quitting the agent should close the session, not
  # leave a dead pane the picker would keep listing.
  tmux set-option -w -t "$SESSION" remain-on-exit off

  apply_policy "$SESSION"
  if [ -n "$LAUNCH_DETACHED" ]; then
    printf '%s\n' "$SESSION"
    return 0
  fi
  attach_to "$SESSION"
}

# The last step of every route into a session, launched or picked: attach the terminal
# you are standing in to it. Normally that is a plain attach. In the map (see
# in_map) the terminal is a map pane, so the pane becomes a viewer the way
# map() builds them: an inner client, stamped with @dir/@ag so its border reads like
# its neighbours'. Exec'd directly rather than through view_cmd's string — no $SHELL is
# in the way here, so the leading-`=` trap that string quotes around does not apply.
attach_to() {
  if [ -n "$IN_MAP" ]; then
    tmux set-option -pt "$TMUX_PANE" @dir "$(map_dir "$1")"
    tmux set-option -pt "$TMUX_PANE" @ag "$(map_agent "$1")"
    exec env -u TMUX tmux attach-session -t "=$1"
  fi
  exec tmux attach-session -t "=$1"
}

# ─── Surviving tmux ──────────────────────────────────────────────────────────
# Every agent lives inside the tmux server, so when the server goes — a reboot, a crash,
# kill-server — every agent goes with it. The conversations survive (each CLI keeps its
# transcripts on disk); what dies is the knowledge of which conversation was which session,
# because that lived only in tmux. So write it down outside tmux, one small file per session:
#
#   ~/.local/state/trails/sessions/trails-foo     agent= dir= id= yolo= task=
#
# and bring sessions back from it: lost rows in the picker, or `trails restore` for the lot.
#
# The hard part is not writing records but knowing when to delete one. A session you quit
# is over; a session tmux took down is the whole point. Both look identical from outside —
# the session is gone — so the deletion has to happen at a moment only one of them reaches.
#
# tmux's own hooks cannot tell them apart, and both were measured. session-closed fires for
# kill-server as well, and only for whichever sessions it tears down before the server
# exits, so it deletes some records in exactly the case they exist for. pane-exited reports
# the wrong session name and does not fire at all when the last session quits.
#
# So the agent runs under a small sh wrapper, and the moment is "the agent exited and the
# wrapper is still alive to notice". An agent that quits — /exit, ctrl-c, a crash — returns
# to the wrapper, which forgets the record and exits with the agent's status. When tmux
# dies it hangs up on the pane's whole process group, and sh's default for SIGHUP is to die
# where it stands, so the wrapper goes down with the agent and the forget never runs. A
# reboot runs nothing at all. Measured on an isolated server: own exit and ctrl-c forget,
# kill-server keeps every record.
#
# What the wrapper costs: it is now the pane's process, so #{pane_pid} is sh's, and
# #{pane_current_command} reads sh — which matters only as sessions()' fallback label,
# and every session launch() makes has @agent. The exit status is passed through, so the
# dead-on-arrival guard still reads the agent's own.
#
# trap : INT QUIT keeps the wrapper alive through a ctrl-c meant for the agent. It is a
# no-op *handler*, not an ignore, so the agent execs with default dispositions and handles
# ctrl-c itself as usual; an inherited ignore would not be reset. HUP is left alone, since
# dying to it is the entire mechanism.
#
# Records begin with this version: a session started before it has none, and so cannot be
# brought back.
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/trails/sessions

# The wrapper calls back into this script by absolute path, because it runs long after
# whatever relative path or PATH lookup started us.
case $0 in
  /*) SELF=$0 ;;
  *) SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0") ;;
esac

# shellcheck disable=SC2016 # expanded by the wrapper's sh, not here
WRAP='self=$1 name=$2; shift 2; trap : INT QUIT; "$@"; s=$?; "$self" --forget "$name"; exit $s'

# A conversation ID in the shape the agent's session.id asks for.
new_id() {
  if command -v uuidgen >/dev/null 2>&1; then
    u=$(uuidgen | tr '[:upper:]' '[:lower:]')
  else
    u=$(cat /proc/sys/kernel/random/uuid)
  fi
  case $1 in
    ses_hex) printf 'ses_%s' "$(printf '%s' "$u" | tr -d -)" ;;
    *) printf '%s' "$u" ;;
  esac
}

rec_path() { printf '%s/%s' "$STATE_DIR" "$1"; }
rec_get() { sed -n "s/^$2=//p" "$(rec_path "$1")" 2>/dev/null | head -n 1; }
rec_forget() { [ -n "$1" ] && rm -f "$(rec_path "$1")"; }

# name agent dir id yolo. Through a temp file and mv, so a reader never sees half a record.
rec_write() {
  mkdir -p "$STATE_DIR" || return 0
  printf 'agent=%s\ndir=%s\nid=%s\nyolo=%s\ntask=\n' "$2" "$3" "$4" "$5" >"$(rec_path "$1").tmp" &&
    mv -f "$(rec_path "$1").tmp" "$(rec_path "$1")"
}

# Called for every live session on every sessions() pass, so it touches the disk only when a
# record exists and its task actually changed.
rec_note_task() {
  [ -n "$2" ] && [ -f "$(rec_path "$1")" ] || return 0
  [ "$(rec_get "$1" task)" = "$2" ] && return 0
  awk -v t="$2" '/^task=/ { print "task=" t; next } 1' "$(rec_path "$1")" >"$(rec_path "$1").tmp" &&
    mv -f "$(rec_path "$1").tmp" "$(rec_path "$1")"
}

# The conversation a session's claude has open *now*, by claude's own account: a file per
# running process, ~/.claude/sessions/<pid>.json, naming its sessionId. The pane's process is
# the wrapper (see "Surviving tmux"), so the claude is its child; a session started before the
# wrapper existed runs claude as the pane itself, hence both are tried. ps rather than pgrep -P,
# which missed children here.
claude_conv_of() {
  pp=$(tmux display-message -pt "$1" '#{pane_pid}' 2>/dev/null)
  case $pp in
    '' | *[!0-9]*) return 1 ;;
    *) ;; # a pid
  esac
  for k in "$pp" $(ps -A -o pid= -o ppid= | awk -v p="$pp" '$2 == p { print $1 }'); do
    f=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions/$k.json
    [ -f "$f" ] || continue
    grep -o '"sessionId":"[^"]*"' "$f" | head -n 1 | json_field sessionId
    return 0
  done
  return 1
}

# Follow a session to the conversation it is actually in, for an agent whose config names a
# session.find reader. Two jobs, one mechanism:
#
#   claude moves on: /resume or /clear inside it switches the conversation, and a record left
#   on the first would restore the wrong one after tmux dies — and leave the real one looking
#   like a stranger's (a ! row in `trails ls`).
#
#   codex and gemini can't start under an ID trails chooses, so launch() writes no record for
#   them. Once the agent has written its conversation, this reads the ID back and writes it.
#
# Only while the session still carries the ID the record has (none, before the first write),
# so a record is never rewritten from a session that isn't its own. Only sessions launch()
# made, too: they carry @agent, and the agent's config row is what names the reader.
rec_note_id() {
  label=$(tmux display-message -pt "$1" '#{@agent}' 2>/dev/null)
  agent=${label%% *}
  [ -n "$agent" ] || return 0
  finder=$(agent_row "$agent" | awk -F'|' '{ print $9 }')
  [ -n "$finder" ] || return 0
  carried=$(tmux display-message -pt "$1" '#{@trails_id}' 2>/dev/null)
  was=
  [ -f "$(rec_path "$1")" ] && was=$(rec_get "$1" id)
  [ "$carried" = "$was" ] || return 0
  now=$(find_conv "$finder" "$1") || return 0
  [ -n "$now" ] && [ "$now" != "$was" ] || return 0
  if [ -f "$(rec_path "$1")" ]; then
    awk -v i="$now" '/^id=/ { print "id=" i; next } 1' "$(rec_path "$1")" >"$(rec_path "$1").tmp" &&
      mv -f "$(rec_path "$1").tmp" "$(rec_path "$1")" || return 0
  else
    mode=
    case $label in *"(YOLO)"*) mode=yolo ;; *) ;; esac
    rec_write "$1" "$agent" "$(tmux display-message -pt "$1" '#{session_path}')" "$now" "$mode"
  fi
  tmux set-option -t "$1" @trails_id "$now"
}

# The conversation session $2 has open, by reader $1 (an agent's session.find).
find_conv() {
  case $1 in
    claude) claude_conv_of "$2" ;;
    codex) codex_conv_of "$2" ;;
    *) return 1 ;;
  esac
}

# The pids under session $1's pane: the wrapper, the agent, and what the agent runs (an npm-
# installed codex is a node shim in front of the real binary). Three levels is all of those.
pane_pids() {
  pp=$(tmux display-message -pt "$1" '#{pane_pid}' 2>/dev/null)
  case $pp in
    '' | *[!0-9]*) return 1 ;;
    *) ;; # a pid
  esac
  ps -A -o pid= -o ppid= | awk -v p="$pp" '
    { kid[$2] = kid[$2] " " $1 }
    END {
      print p; lvl = p
      for (d = 0; d < 3; d++) {
        next_lvl = ""; n = split(lvl, cur, " ")
        for (i = 1; i <= n; i++) if (cur[i] in kid) { print substr(kid[cur[i]], 2); next_lvl = next_lvl kid[cur[i]] }
        lvl = next_lvl
      }
    }' | tr ' ' '\n' | awk 'NF'
}

# The newest rollout under $1 for directory $2, written at or after $3, that no record other
# than $4's claims ($5 is held_ids). A function, not inline in codex_conv_of's $( ... ): a case
# pattern's ) inside a command substitution ends it early in bash 3.2, macOS's sh.
codex_rollout_for() {
  newest_first "$1" -mindepth 4 -maxdepth 4 -name 'rollout-*.jsonl' -mtime -2 |
    while read -r m path; do
      [ "$m" -ge "$3" ] || break
      meta=$(head -n 1 "$path" | jq -r '.payload | "\(.id)\t\(.cwd)"' 2>/dev/null)
      id=${meta%%"$TAB"*}
      [ "${meta#*"$TAB"}" = "$2" ] || continue
      case $5 in
        *" $id "*) [ "$id" = "$4" ] || continue ;;
        *) ;;
      esac
      printf '%s' "$path"
      break
    done
}

# codex's conversation for session $1. codex picks its own ID and writes it nowhere until the
# first message: then $CODEX_HOME/sessions/YYYY/MM/DD/rollout-<time>-<uuid>.jsonl appears,
# its first line a session_meta whose payload carries the id and the cwd
# (codex-rs/rollout/src/recorder.rs). Two ways to find it, best first:
#
#   the rollout file the codex process holds open, by lsof — exact, if codex keeps it open;
#   else the newest rollout for this directory started since the session was, that no other
#   session's record claims — right unless two codex sessions in one directory both start
#   talking between two listings.
#
# Files older than two days are skipped, and so is codex's later .jsonl.zst compression, which
# only reaches files untouched for a week.
codex_conv_of() {
  root=${CODEX_HOME:-$HOME/.codex}/sessions
  [ -d "$root" ] || return 1
  f=
  if command -v lsof >/dev/null 2>&1; then
    for k in $(pane_pids "$1"); do
      f=$(lsof -p "$k" -Fn 2>/dev/null | sed -n 's/^n//p' | grep '/rollout-[^/]*\.jsonl$' | head -n 1)
      [ -n "$f" ] && break
    done
  fi
  if [ -z "$f" ]; then
    dir=$(tmux display-message -pt "$1" '#{session_path}' 2>/dev/null)
    since=$(tmux display-message -pt "$1" '#{session_created}' 2>/dev/null)
    own=$(rec_get "$1" id)
    held=$(held_ids)
    f=$(codex_rollout_for "$root" "$dir" "${since:-0}" "$own" "$held")
  fi
  [ -n "$f" ] || return 1
  head -n 1 "$f" | jq -r '.payload.id // empty' 2>/dev/null
}

# Is this record's session gone? Not "is a session of that name running": a name can be
# taken by something else (a `tmux new -s trails-foo` of your own), and that would hide the
# dead record from every lost row and from restore. launch() stamps each session with its
# conversation ID as @trails_id, and a record is alive only while a session carries its ID.
# No "=" on -t, the display-message trap is_ours() documents; a prefix match onto a
# neighbour reads back the neighbour's ID, which does not match, so it still says dead.
rec_is_dead() {
  [ -f "$(rec_path "$1")" ] || return 1
  [ "$(tmux display-message -pt "$1" '#{@trails_id}' 2>/dev/null)" != "$(rec_get "$1" id)" ]
}

# Every record whose session is not running: what died with tmux. Names only.
rec_dead() {
  for f in "$STATE_DIR"/"$PREFIX"*; do
    [ -f "$f" ] || continue
    name=${f##*/}
    case $name in
      *.tmp) continue ;;
      *) ;; # a record
    esac
    rec_is_dead "$name" && printf '%s\n' "$name"
  done
}

# The lost half of is_ours: a dead session started in this directory.
restorable_here() {
  rec_is_dead "$1" && [ "$(rec_get "$1" dir)" = "$PWD" ]
}

# Bring one dead session back, detached, from its record; prints the name it came back
# under. Run from the session's own directory.
#
# Resuming can fail where starting would not: claude refuses an ID that never got a message
# ("No conversation found with session ID"), which is what an agent you opened and never
# typed into leaves behind. There is nothing to resume then, so start fresh in its place.
# If that fails too the agent itself is broken (a bad token, no keychain), and the record is
# put back — it is the only pointer to the conversation, and a failed restore must not cost it.
restore_one() {
  agent=$(rec_get "$1" agent)
  id=$(rec_get "$1" id)
  mode=$(rec_get "$1" yolo)
  saved=$(cat "$(rec_path "$1")")
  SESSION=$(session_base)

  # Subshells because launch() exits on failure, which would take the fallback with it.
  (LAUNCH_DETACHED=1 launch "$agent" "$mode" "$id" "$1") && return 0
  echo "trails: nothing to resume for ${1#"$PREFIX"} — starting $agent fresh in its place" >&2
  (LAUNCH_DETACHED=1 launch "$agent" "$mode" "" "$1") && return 0
  mkdir -p "$STATE_DIR" && printf '%s\n' "$saved" >"$(rec_path "$1")"
  echo "trails: could not bring ${1#"$PREFIX"} back — its record is kept, try again once $agent starts" >&2
  return 1
}

# `trails restore` — every dead session on the box, each in its own directory. Detached,
# because there may be several and you can only sit in one: attach afterwards with the
# picker or the map, which already know how to find them. `trails ls` lists them first,
# as its lost rows.
restore_all() {
  [ -z "${1:-}" ] || {
    echo "trails: restore takes no arguments — trails ls shows what it would bring back (lost)" >&2
    exit 1
  }
  command -v tmux >/dev/null 2>&1 || {
    echo "trails: restore needs tmux" >&2
    exit 1
  }
  names=$(rec_dead)
  [ -n "$names" ] || {
    echo "trails: nothing to restore"
    return 0
  }

  # Each in a subshell: restore_one cds, and launch exits on failure — neither may leak into
  # the next one. USE_TMUX forced on, since run from inside tmux it would otherwise mean
  # "run the agent bare in this pane", and there is no pane here to run it in.
  for name in $names; do
    dir=$(rec_get "$name" dir)
    if [ ! -d "$dir" ]; then
      echo "trails: skipping ${name#"$PREFIX"} — $dir is gone (ctrl-x its lost row, or rm $(rec_path "$name"))" >&2
      continue
    fi
    new=$(cd "$dir" && USE_TMUX=1 restore_one "$name") || continue
    if [ "$new" = "$name" ]; then
      echo "restored ${name#"$PREFIX"}"
    else
      echo "restored ${name#"$PREFIX"} as ${new#"$PREFIX"}"
    fi
  done
}

# ─── Recent conversations ────────────────────────────────────────────────────
# Records are no history: the wrapper forgets one the moment its agent exits, so they only
# ever hold what is running or what tmux took down. Each CLI keeps a history anyway — it is
# what its own --resume reads — so "what was I working on" is answered from there, read when
# asked, rather than from a log of our own that would start empty and miss every agent
# started without trails. Old and new conversations take the same path; nothing to import.
#
# The cost is bounded by the rows shown, not the history behind them: a RECENT_DAYS window
# on mtime, newest first, and only as many files opened as it takes to fill RECENT_MAX rows.
#
# Only an agent with a session block can resume, and of those, the first to run each of
# these two commands is the one whose store is read:
#   claude    ~/.claude/projects/<cwd, non-alphanumerics as ->/<id>.jsonl, a JSON line per
#             event. "entrypoint":"cli" keeps out conversations scripts ran through the SDK —
#             most of the files there, measured. The title is the last ai-title line, the
#             text the tmux title (and so a record's task) carries, else the last prompt for
#             a conversation too short to have earned one. Neither: it never got a message,
#             and claude refuses to resume it.
#   opencode  its SQLite store's session table: top-level (a subagent run has a parent_id),
#             not archived, and titled — "New session - <date>" is the placeholder until the
#             first message.
#
# A conversation a record holds is left out, being a live or lost row already. One still open in
# a claude that trails did not start (a plain `claude` in some terminal) is shown, marked !,
# and Enter refuses it: resuming would put a second claude on the conversation, each adding
# turns the other never sees. claude says which are open itself — a file per running process,
# ~/.claude/sessions/<pid>.json, naming its sessionId — so "open" is that file's pid alive.
RECENT_DAYS=${TRAILS_RECENT_DAYS:-10}
RECENT_MAX=${TRAILS_RECENT_MAX:-5}

# find's matches as "mtime path", newest first, one stat for the lot. Asked rather than
# guessed which stat this is: GNU reads BSD's -f as --file-system and answers something else.
newest_first() {
  if stat -c %Y / >/dev/null 2>&1; then
    find "$@" -exec stat -c '%Y %n' {} + 2>/dev/null
  else
    find "$@" -exec stat -f '%m %N' {} + 2>/dev/null
  fi | sort -rn
}

# A string field off one JSON line, then made readable. sed rather than jq, which a fresh
# Debian box lacks; these are flat lines read for display, not data to round-trip.
json_field() { sed -En "s/.*\"$1\":\"(([^\"\\\\]|\\\\.)*)\".*/\1/p"; }
json_text() { sed -e 's/\\[nt]/ /g' -e 's/\\"/"/g' -e 's/\\\\/\\/g'; }

# Every conversation ID a record holds, space-separated and padded for a case match.
held_ids() { printf ' %s ' "$(cat "$STATE_DIR"/"$PREFIX"* 2>/dev/null | sed -n 's/^id=//p' | tr '\n' ' ')"; }

# The pid of the running claude that has conversation $1 open, if any. A file whose pid is
# gone is one claude did not get to clean up (a crash, a kill -9), and means nothing.
claude_open_pid() {
  for f in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/sessions/*.json; do
    [ -f "$f" ] || continue
    grep -qF "\"sessionId\":\"$1\"" "$f" || continue
    pid=${f##*/}
    pid=${pid%.json}
    kill -0 "$pid" 2>/dev/null && printf '%s' "$pid" && return 0
  done
  return 1
}

# The rows below are all one shape, TSV: mtime, agent, dir, id, yolo, pid, title. yolo is
# "yolo" or "-", pid the process still holding the conversation open or "-", and the title
# goes last. Never an empty field mid-row: tab is whitespace to `read`, so two tabs in a row
# collapse into one and every field after shifts left. $1 is the directory to keep, or empty
# for every one.
#
# yolo is claude's own record of the last turn's permission mode: "bypassPermissions" is what
# --dangerously-skip-permissions runs as. opencode keeps nothing like it, so its rows say "-".
#
# Scoped, it opens the one folder claude files that directory under and checks each file's
# own cwd, since the folder name is lossy (/a.b and /a-b share one).
claude_recent() {
  root=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects
  if [ -n "$1" ]; then
    where=$root/$(printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g') depth=1
  else
    where=$root depth=2
  fi
  [ -d "$where" ] || return 0
  held=$(held_ids)
  n=0
  newest_first "$where" -mindepth "$depth" -maxdepth "$depth" -name '*.jsonl' -mtime "-$RECENT_DAYS" |
    while read -r m f; do
      id=${f##*/}
      id=${id%.jsonl}
      case $held in *" $id "*) continue ;; *) ;; esac
      [ "$(grep -m1 -o '"entrypoint":"[^"]*"' "$f")" = '"entrypoint":"cli"' ] || continue
      dir=$(grep -m1 -o '"cwd":"[^"]*"' "$f" | json_field cwd)
      [ -z "$1" ] || [ "$dir" = "$1" ] || continue
      title=$(grep -F '"type":"ai-title"' "$f" | tail -n 1 | json_field aiTitle | json_text)
      [ -n "$title" ] ||
        title=$(grep -F '"type":"last-prompt"' "$f" | tail -n 1 | json_field lastPrompt | json_text | cut -c1-80)
      [ -n "$title" ] || continue
      yolo=-
      [ "$(grep -o '"permissionMode":"[^"]*"' "$f" | tail -n 1)" = '"permissionMode":"bypassPermissions"' ] && yolo=yolo
      pid=$(claude_open_pid "$id") || pid=-
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$m" "$2" "$dir" "$id" "$yolo" "$pid" "$title"
      n=$((n + 1))
      [ "$n" -lt "$RECENT_MAX" ] || break
    done
}

# Read-only, so a running opencode holding the database is never in the way.
opencode_recent() {
  db=${XDG_DATA_HOME:-$HOME/.local/share}/opencode/opencode.db
  [ -f "$db" ] && command -v sqlite3 >/dev/null 2>&1 || return 0
  since=$((($(date +%s) - RECENT_DAYS * 86400) * 1000))
  where=
  [ -n "$1" ] && where="AND directory = '$(printf '%s' "$1" | sed "s/'/''/g")'"
  sqlite3 -readonly -separator "$TAB" "$db" "
    SELECT time_updated / 1000, '$2', directory, id, '-', '-',
           replace(replace(title, char(9), ' '), char(10), ' ')
    FROM session
    WHERE parent_id IS NULL AND time_archived IS NULL AND time_updated >= $since
      AND title NOT LIKE 'New session - %' $where
    ORDER BY time_updated DESC" 2>/dev/null |
    awk -F"$TAB" -v held="$(held_ids)" -v max="$RECENT_MAX" \
      'index(held, " " $4 " ") == 0 { print; if (++n >= max) exit }'
}

# Both stores, newest first, RECENT_MAX in all. Each source stops at RECENT_MAX of its own,
# which is enough: the overall newest five are among the union of each one's newest five.
# TRAILS_RECENT_MAX=0 turns it off, for a caller that only wants what is running.
recent_rows() {
  [ "$RECENT_MAX" -gt 0 ] 2>/dev/null || return 0
  avail=" $(available_agents | tr '\n' ' ') "
  cp=$(store_agent claude)
  op=$(store_agent opencode)
  {
    resumable "$cp" && case $avail in *" $cp "*) claude_recent "$1" "$cp" ;; *) ;; esac
    resumable "$op" && case $avail in *" $op "*) opencode_recent "$1" "$op" ;; *) ;; esac
  } | sort -t "$TAB" -k1,1nr | head -n "$RECENT_MAX"
}

# mtime, now → "5m ago", "3h ago", "2d ago".
ago() {
  s=$(($2 - $1))
  if [ "$s" -lt 3600 ]; then
    printf '%sm ago' $((s / 60))
  elif [ "$s" -lt 86400 ]; then
    printf '%sh ago' $((s / 3600))
  else
    printf '%sd ago' $((s / 86400))
  fi
}

# ─── Map ─────────────────────────────────────────────────────────────────────
# Several agents at once, in one window. The picker answers "what do I open here" and
# `trails ls` answers "who wants me"; this is the third question — watch four of them work,
# and answer whichever one stops, without leaving the window.
#
# Every pane is a tmux client attached to a live agent session: the map *borrows* the
# view, it does not take the pane. That is the whole design, and the reason to prefer it
# over join-pane, which is the obvious other way to get four agents into one window.
# join-pane *moves* a pane, so trails-foo would stop being a session — and sessions are
# what is_ours, list_sessions() and the SwiftBar plugin all ask tmux about, so all three would go
# blind at once. A map that died mid-flight would leave the agents merged into a
# session none of them chose, with no way back but hand-run break-pane.
#
# Borrowed, the map owns nothing, so it can lose nothing: kill it, close the window,
# crash it, and every agent is where it was — still running, still attached to whatever
# else was viewing it. That is also why this never reuses a map. Rebuilding is free
# when there is no state to keep, so `trails map` always builds a fresh one rather
# than reconciling an old one against a new pick.
#
# Not $PWD-scoped, for list_sessions()'s reason: the picker asks what is running *here*, the
# map asks what is running *at all*.
#
# What it costs, and it is not nothing. A tmux window has one grid, so a session two
# clients of different shapes are watching cannot be right for both — that is not a thing
# to fix, only a thing to point somewhere. window-size is left at its default `latest`,
# which points it at the most recently *used* client, not the newest one: whichever client
# you last typed in wins, so the view you are working in is always the correct one and the
# other is the one that pays. That is the behaviour worth having, and it is why no attempt
# is made to be cleverer here.
#
# What the other one pays is a re-flow, and two consequences follow. Any *other* window
# viewing that agent — a Zed thread, an nvim panel — draws it small in the corner until
# you press a key there, which re-elects it and snaps it back (measured: 200x49 ↔ 180x44
# across a keypress, either way). And a re-flow is a screen change, so the `trails ls`
# poll that straddles an attach reads those agents as `working` — classify() calls a
# changed screen working by construction — and the SwiftBar plugin re-announces them once
# as they settle. That is the one place the map dents the notifier's one-sided error:
# a still screen can never read as working, and a resize is a still screen that moves
# (measured: capture-pane's content hash does change across a resize). AGENT_NOTIFY_AFTER
# is the existing dial for it, for the same reason it exists at all.
#
# `-f ignore-size` on the pane clients is the other end of the lever and was measured too:
# it holds the agent at the other client's size, keeps typing (it is not read-only, which
# is a separate flag), and falls back to the map's own size when nothing else is
# looking. It is not used because it only moves the dead space into the map pane —
# a session Zed holds at 114x84 renders into a 181x45 pane as 114 columns of agent and 67
# of nothing. Neither end is free, and the active view is the better one to keep whole.

# One name, so exactly one map — a decision, not an oversight, and the difference
# matters because the fix for it is sitting right there in this file. next_free() gives
# agent sessions their -2 because each holds a live conversation that cannot be recreated:
# ~/a/foo and ~/b/foo both want trails-foo, neither can yield, so they coexist. A map
# holds nothing, so that pressure has no counterpart here — nothing collides, because
# there is nothing to lose. Reaching for next_free() when a second map "collides"
# would be solving a problem the design does not have, and would cost the thing a fixed
# name buys: the map is a *place*. `tmux a -t trails_map` finds it forever, and re-running
# builds over it. Two of them and you are tracking which is which, which is bookkeeping —
# for the one thing here whose whole point is that it needs none.
#
# The axis that scales is panes, not maps: eight agents is `trails map 8`, not two
# maps of four. Two monitors would be the honest reason to want a second, and a map
# you keep *while* building another would be a better one — but that second is a saved view,
# which is state, and state is exactly what this does not have and should not grow lightly.
#
# The cost lands on kill-session in map(): a window already sitting in the old map
# has its `tmux attach` exit under it and drops back to a shell. Measured, and in the README,
# because it is the one part of "re-running is free" that is not free. The agents are
# untouched — they always are.
#
# Outside $PREFIX on purpose, and load-bearing rather than taste: sessions() calls
# anything named trails-* an agent session, so a `trails-map` would be listed by
# `trails ls` and counted by the notifier as one more agent — a viewer reported as a
# thing to watch, permanently "working" because its panes always repaint. The prefix
# means "an agent lives here", and no agent lives here. An underscore, not a dash, for the
# same reason: trails-map is what a project folder called "map" gets.
MAP=trails_map

# This is the one session the script kills without asking, so be sure it is ours first.
# @trails_map is the marker, stamped at build; a session you named `trails_map` yourself has no
# marker and gets refused rather than reaped. display-message rather than show-options -t,
# and no "=": the same trap is_ours() documents.
is_map() {
  [ "$(tmux display-message -pt "$MAP" '#{@trails_map}' 2>/dev/null)" = 1 ]
}

# Are we in a shell pane of the map itself — one you split off with C-b | to start
# or pick an agent from? Inside tmux the picker normally runs the agent bare in the
# current pane (USE_TMUX is off), and here that would be wrong in every way that matters:
# no trails- session, so status, the notifier and the picker cannot see it, and the next
# `trails map new` kills it along with the session it is squatting in. The map
# owns nothing, and an agent living inside it would be the one thing it owned.
#
# So the dispatch turns USE_TMUX back on here and the agent gets a real session like
# anywhere else; attach_to then turns this pane into a viewer of it, so the split you made
# becomes the new grid cell. Asked by $TMUX_PANE, not the current client: the shell may
# be in a map window you are not looking at.
in_map() {
  [ -n "$TMUX" ] && [ -n "$TMUX_PANE" ] || return 1
  [ "$(tmux display-message -pt "$TMUX_PANE" '#{session_name}' 2>/dev/null)" = "$MAP" ] &&
    is_map
}

# fzf's preview: the agent's own screen. It is what makes a name pickable — "trails-foundry"
# is a name, the screen tells you it is sat on a permission prompt. -e keeps the colours.
peek() { tmux capture-pane -pet "$1" 2>/dev/null; }

# What a map pane runs: one tmux client, attached to one agent session. Written once
# because both callers (new-session for the first pane, split-window for the rest) need the
# same two non-obvious things, and either one missed is silent.
#
# The quotes around the '=' are for zsh, not tmux. tmux runs a pane's command through
# $SHELL, where a bare leading `=` expands to a command path — the same trap that made the
# picker internals above subcommands. Unquoted, every pane dies on arrival with
# "=trails-foo not found" and the map comes up empty.
#
# env -u TMUX because tmux sets $TMUX in every pane it creates and refuses to nest while it
# is set. Clearing it is the supported way in: the inner client is an ordinary client that
# happens to have a pane for a terminal. Truecolor and CSI-u both survive the nest and need
# nothing added to tmux.conf — tmux negotiates RGB with the outer tmux at runtime rather
# than trusting tmux-256color's terminfo (which declares neither), and extended-keys is a
# server option, so it is already true of the inner client and Shift+Enter reaches the agent.
view_cmd() { printf "env -u TMUX tmux attach -t '=%s'" "$1"; }

# The directory a map pane's agent works in — its session_path basename, frozen at
# launch by launch()'s -c "$PWD". Stamped onto the pane as @dir so the border can lead
# with it (see the pane-border-format below). Not folded into tmux.conf's set-titles-string,
# which is where "claude · <task>" comes from: that string is also the Ghostty tab title and
# the normal agent session's title, and the directory is wanted in the map grid only.
# Static, unlike the task half — a session's directory cannot change — so it is set once at
# build and never goes stale, where #{pane_title} stays live for the task.
# No "=" on the -t: display-message silently answers nothing for an =exact target (the
# trap is_ours() documents), so "=$1" would hand basename an empty string and every pane
# would get a blank @dir. The name comes straight from a live list, so an unanchored match
# still lands on it exactly.
map_dir() { basename "$(tmux display-message -pt "$1" '#{session_path}' 2>/dev/null)"; }

# The agent name for a map pane, stamped as @ag so the border can tell a real task from
# the title-less fallback. Before an agent publishes a task, tmux.conf's set-titles-string
# falls back to "#{@agent} · #{b:pane_current_path}" — i.e. "claude · <dir>" — so the border
# would read "<dir> · claude · <dir>", the directory twice. The border composes that same
# fallback string from @ag and @dir and, on a match, drops the task half (see below). Same
# no-"=" rule as map_dir, and same source, so @agent is the value launch() wrote.
map_agent() { tmux display-message -pt "$1" '#{@agent}' 2>/dev/null; }

# Every agent on the box, ranked most-wants-you first. The rank is the same blocked/idle/
# working sort list_sessions() and live_sessions() use, so pane 1 of the grid is always the one
# to look at first.
#
# The name keeps its -N suffix here, for the reason list_sessions() spells out and live_sessions()
# is exempt from: box-wide, `trails-foo-2` is equally foo's second agent and project
# foo-2's only one, so the `#2` badge would be a guess. Print the name and let it be read.
map_menu() {
  sessions | classify | while IFS="$TAB" read -r state name label task; do
    rank_dot "$state"
    [ -n "$task" ] && task="  $task"
    # Sort key up front, stripped after — leaving name, then what fzf draws.
    printf '%s\t%s\t%s● %-9s%s  %s · %s%s\n' \
      "$rank" "$name" "$dot" "$word" "$RST" "$label" "${name#"$PREFIX"}" "$task"
  done | sort | cut -f2-
}

map() {
  command -v tmux >/dev/null 2>&1 || {
    echo "trails: map needs tmux" >&2
    exit 1
  }
  if tmux has-session -t "=$MAP" 2>/dev/null && ! is_map; then
    echo "trails: a tmux session named '$MAP' is already here and is not ours" >&2
    echo "        rename it (tmux rename-session -t $MAP <name>) and retry" >&2
    exit 1
  fi

  # Bare `trails map` means "take me to my map": if one is already up, go there
  # rather than making you re-pick and rebuilding it. The guard above has established that
  # any session named $MAP is ours, so has-session alone is enough here. `trails map
  # new` skips this to force a fresh pick (it is non-empty, so the -z test is false), and
  # `trails map N` likewise rebuilds — both keep the stateless "re-running is free"
  # contract; this only spares you the rebuild when you did not ask for one. switch-client
  # inside tmux, attach outside — the same fork the build path ends on.
  if [ -z "${1:-}" ] && tmux has-session -t "=$MAP" 2>/dev/null; then
    [ -z "$TMUX" ] || exec tmux switch-client -t "=$MAP"
    exec tmux attach-session -t "=$MAP"
  fi

  rows=$(map_menu)
  [ -n "$rows" ] || {
    echo "trails: no agent sessions running" >&2
    exit 1
  }

  # `trails map N` takes the N that most want you and skips the picker — the rows are
  # already sorted blocked, idle, working, so "the top N" is "the N worth looking at".
  # `trails map new` opens the picker; bare `trails map` only reaches here when no
  # map was up to attach to (the block above returns otherwise), so it opens the picker
  # too. Both arrive at the same list of names, and fzf --multi returns them in list order,
  # so the grid stays in wants-you order.
  case ${1:-} in
    '' | new)
      choice=$(printf '%s\n' "$rows" | fzf --multi --reverse --no-info --ansi \
        --prompt='Map: ' --delimiter='\t' --with-nth='2..' --height=~80% \
        --header='tab: pick an agent   enter: open the map' \
        --preview="$0 --peek {1}" --preview-window='right,60%,border-left') || exit 0
      names=$(printf '%s\n' "$choice" | cut -f1)
      ;;
    *[!0-9]*)
      echo "trails: map takes a number of agents or 'new', not '$1'" >&2
      exit 1
      ;;
    *)
      # 0 reaches head as `head -n 0`, which refuses with "illegal line count" and leaves
      # you reading coreutils' opinion of your typo rather than ours.
      [ "$1" -ge 1 ] || {
        echo "trails: map needs at least one agent, not '$1'" >&2
        exit 1
      }
      names=$(printf '%s\n' "$rows" | cut -f1 | head -n "$1")
      ;;
  esac
  [ -n "$names" ] || exit 0

  # Drop anything that died between the pick and here. The gap is real: map_menu ran
  # before fzf opened, so a name can be minutes stale by the time you press enter, and an
  # agent that finished and exited in the meantime is gone.
  #
  # It is worth a pass of its own because the first name failing is not survivable. tmux
  # creates the session, its command exits at once, tmux reaps the session — and
  # new-session still returns 0, so the `|| exit 1` below never fires and every call after
  # it ("no such session: map", an empty pane_id, a failed attach) fails in a heap.
  # A dead name later in the list is milder — the pane opens and closes and the grid is
  # quietly one short — but it is the same bug, so it goes the same way.
  #
  # This narrows the window to microseconds rather than closing it; a session dying between
  # this check and the attach still lands in the old behaviour. Nothing can close it — the
  # agent is another process — and narrowing is the whole of the available win.
  names=$(printf '%s\n' "$names" | while read -r n; do
    tmux has-session -t "=$n" 2>/dev/null && printf '%s\n' "$n"
  done)
  [ -n "$names" ] || {
    echo "trails: the agents you picked are gone" >&2
    exit 1
  }
  count=$(printf '%s\n' "$names" | wc -l | tr -d ' ')

  # Build at the size of the terminal you are standing in, because the layout below is
  # decided on width. A session made without -x/-y sits at tmux's default 80x24 until a
  # client attaches, so the two-pane rule would be judged against a width that is not
  # yours. Inside tmux the client is the window, not the pane, so ask tmux rather than tput.
  if [ -n "$TMUX" ]; then
    size=$(tmux display-message -p '#{client_width} #{client_height}' 2>/dev/null)
  else
    size="$(tput cols 2>/dev/null) $(tput lines 2>/dev/null)"
  fi
  w=${size% *}
  h=${size#* }

  # Fall back to tmux's own default for a client-less session. Neither source is guaranteed
  # to answer: tput says nothing with no TERM or with stdout redirected, and client_width is
  # empty for a $TMUX set with no client attached. Either way the empty string reaches
  # new-session as -x '' and tmux refuses the whole map with a bare "width invalid" —
  # a real answer to a question nobody asked. 80x24 builds something you can look at, and
  # the client that attaches a moment later resizes it to the truth anyway; only the
  # two-pane rule below reads the guess, and it degrades to "stacked".
  case $w in
    '' | *[!0-9]*) w=80 ;;
    *) ;; # a real width, from a real terminal
  esac
  case $h in
    '' | *[!0-9]*) h=24 ;;
    *) ;; # likewise
  esac

  # Three or more is a grid and there is nothing to decide. Two is the case worth thinking
  # about, and it turns on width rather than taste: side by side gives each agent a
  # full-height column, the better shape for reading a conversation — but only if the
  # halves are wide enough to read. Under ~80 columns an agent TUI starts wrapping its own
  # boxes, so a 114-column window (a half-screen Ghostty) is better served stacked: 114
  # wide and short beats 57 wide and tall. Hence 160, which is that 80 doubled. C-b Space
  # cycles if a particular window disagrees.
  if [ "$count" -eq 2 ] && [ "$w" -lt 160 ]; then
    layout=even-vertical
  elif [ "$count" -eq 2 ]; then
    layout=even-horizontal
  else
    layout=tiled
  fi

  # Unconditional, and this is the line that makes "one map" true (see MAP above).
  # A window sitting in the old one loses it here: detach-on-destroy sends its client home,
  # its `tmux attach` exits, and it lands back on a shell. That is the whole cost of asking
  # for a map while one is already open, and it is bounded — the agents never notice,
  # because none of them live here.
  tmux kill-session -t "=$MAP" 2>/dev/null
  first=$(printf '%s\n' "$names" | head -n1)

  tmux new-session -d -s "$MAP" -x "$w" -y "$h" "$(view_cmd "$first")" || exit 1

  # new-session's exit status only says the session was created, not that its command
  # lived: a pane whose command exits immediately takes the session down with it and
  # new-session still returns 0. The filter above makes that unlikely, not impossible, and
  # unnoticed it turns every line below into a "no such session" — so ask.
  tmux has-session -t "=$MAP" 2>/dev/null || {
    echo "trails: $first went away as the map opened it" >&2
    exit 1
  }
  tmux set-option -t "$MAP" @trails_map 1
  home=$(tmux display-message -pt "$MAP" '#{pane_id}')
  tmux set-option -pt "$home" @dir "$(map_dir "$first")"
  tmux set-option -pt "$home" @ag "$(map_agent "$first")"

  # Re-tile after every split rather than once at the end, because split-window halves the
  # *current* pane and the halves get small fast: measured in an 80x24 window, the fifth
  # agent fails with "no space for new pane" and the map comes up with four and no
  # complaint (the error lands on tmux's stderr, not in the grid you are looking at).
  # Tiling as we go re-spreads the panes each round so the next split has room — the same
  # window then takes six. Four fits either way, which is exactly why this is worth doing
  # up front rather than after the first time a map quietly drops an agent.
  printf '%s\n' "$names" | tail -n +2 | while read -r n; do
    [ -n "$n" ] || continue
    # -P -F to get the new pane's id back, so @dir lands on this split and not whichever
    # pane happened to be current — split-window makes the new pane active, but reading it
    # back by id is exact and does not assume that.
    pane=$(tmux split-window -t "$MAP" -P -F '#{pane_id}' "$(view_cmd "$n")")
    tmux set-option -pt "$pane" @dir "$(map_dir "$n")"
    tmux set-option -pt "$pane" @ag "$(map_agent "$n")"
    tmux select-layout -t "$MAP" tiled >/dev/null
  done
  tmux select-layout -t "$MAP" "$layout" >/dev/null

  # The border label, free and always current: the inner client emits its session's title
  # (tmux.conf's set-titles-string — "claude · what it is working on") to its terminal,
  # which *is* this pane, so the map reads it straight off #{pane_title}. No poll and
  # no bookkeeping, and it follows the agent's own title as the task changes. The global
  # format is no use here — every pane in a map runs `tmux`, so #{pane_current_command}
  # would label all four "tmux". Set rather than inherited because the global exists for
  # other windows' reasons and apply_policy turns it off for agent sessions.
  #
  # Led with #{@dir}, the per-pane directory stamped above, so the border reads
  # "<dir> · claude · <task>": directory, then agent and task from the agent's own title.
  # @dir resolves at the pane scope, so each border shows its own agent's directory; the
  # ' · ' matches set-titles-string's separator so the three read as one string.
  #
  # The conditional drops the task half when it *is* the directory. Before an agent
  # publishes a task, set-titles-string falls back to "#{@agent} · #{b:pane_current_path}",
  # so pane_title is "claude · <dir>" and the naive form doubled the directory
  # ("<dir> · claude · <dir>"). Composing that fallback from the stamped @ag and @dir and
  # comparing pane_title to it catches exactly that state and shows "<dir> · claude"; any
  # real task fails the match and prints whole. Transient either way — it self-corrects the
  # moment the agent sets a title — but the doubling is avoided rather than blinked through.
  tmux set-option -w -t "$MAP" pane-border-status top
  tmux set-option -w -t "$MAP" pane-border-format \
    ' #{@dir} · #{?#{==:#{pane_title},#{@ag} · #{@dir}},#{@ag},#{pane_title}} '

  # Land on the one that most wants you. By pane id, which cannot be re-numbered out from
  # under us by the re-tiling above the way an index can.
  tmux select-pane -t "$home"

  # Already inside tmux (opened from an agent session, or from your own window): attach
  # would refuse to nest, and switch-client is what "go there" means to a client already here.
  [ -z "$TMUX" ] || exec tmux switch-client -t "=$MAP"
  exec tmux attach-session -t "=$MAP"
}

# ─── Menu bar ────────────────────────────────────────────────────────────────
# A SwiftBar plugin ships with trails (extras/swiftbar in the repo, share/trails/swiftbar
# once installed): the agents that want you, in the macOS menu bar. It reads `trails ls`
# like any other caller, so it is not part of trails' job — this only puts it where SwiftBar
# looks, so that installing it is one command and not a path to copy out of `brew info`.
#
#   trails swiftbar            link it into SwiftBar's plugin folder and refresh SwiftBar
#   trails swiftbar --remove   take the link out again
#
# A link and not a copy, and to the plugin through Homebrew's unversioned path
# (/opt/homebrew/share/trails/…), so `brew upgrade trails` updates it with nothing to redo.
# Found next to this script as it was invoked, not as it resolves: resolving would land in
# the versioned Cellar directory, which the next upgrade deletes.

# The plugin that came with this copy of trails, as an absolute path, or nothing.
swiftbar_plugin() {
  for f in "$(dirname "$SELF")/../share/trails/swiftbar/trails.10s.sh" \
    "$(dirname "$SELF")/../extras/swiftbar/trails.10s.sh"; do
    [ -f "$f" ] || continue
    printf '%s/trails.10s.sh' "$(cd "$(dirname "$f")" && pwd)"
    return 0
  done
  return 1
}

swiftbar_link() {
  case ${1:-} in
    '' | --remove) ;;
    *)
      echo "trails: swiftbar takes --remove or nothing, not '$1'" >&2
      exit 1
      ;;
  esac
  [ "$(uname -s)" = Darwin ] || {
    echo "trails: the menu-bar plugin is for SwiftBar, which is macOS-only" >&2
    exit 1
  }
  open -Ra SwiftBar 2>/dev/null || {
    echo "trails: SwiftBar isn't installed — brew install --cask swiftbar, open it once, then run this again" >&2
    exit 1
  }
  dir=$(defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null)
  case $dir in
    '')
      echo "trails: SwiftBar has no plugin folder yet — open SwiftBar, choose one, then run this again" >&2
      exit 1
      ;;
    \~/*) dir=$HOME/${dir#\~/} ;; # stored with a literal ~, which nothing expands for us
    *) ;;                         # already absolute
  esac
  link=$dir/trails.10s.sh

  if [ "${1:-}" = --remove ]; then
    if [ -L "$link" ]; then
      rm "$link" && echo "removed $link"
    else
      echo "trails: no plugin link at $link"
    fi
    open -g "swiftbar://refreshallplugins" 2>/dev/null
    return 0
  fi

  src=$(swiftbar_plugin) || {
    echo "trails: can't find the plugin that ships with trails (looked next to $SELF)" >&2
    exit 1
  }
  # Never over a real file: that is someone's own plugin, not a link this made.
  if [ -e "$link" ] && [ ! -L "$link" ]; then
    echo "trails: $link is a file, not a link — move it aside, then run this again" >&2
    exit 1
  fi
  mkdir -p "$dir" && ln -sfn "$src" "$link" || exit 1
  echo "linked $link"
  echo "    -> $src"
  open -g "swiftbar://refreshallplugins" 2>/dev/null
}

# ─── Where an agent may not be opened ────────────────────────────────────────
# An agent takes the directory you are standing in to be the project: it reads and edits
# from there, and launch() freezes it as the session root with -c "$PWD". / is never the
# answer and is easy to arrive at without meaning to — a `cd "$somewhere"` with the
# variable unset lands there. This box had an `trails-/` session to show for it.
#
# $HOME was refused alongside it, on the grounds that every new terminal starts there and
# so it is the stray-launch directory. It is allowed now: a session that isn't about one
# project (dotfiles-wide questions, poking at several repos) has nowhere better to live,
# and making you cd somewhere arbitrary to get one was friction with no safety behind it.
#
# / exactly, and nothing beneath it, since everything lives beneath it.
#
# Measured with `pwd -P` rather than $PWD, which keeps whatever path you walked in by: a
# symlink pointing at / is the same directory and reads as a different string.
#
# Only starting is refused, never reporting: `trails ls` answers for the whole box and
# is read-only, so it works from anywhere, and the fzf internals run from a picker that has
# already passed through here.
refuse_bad_cwd() {
  [ "$(pwd -P)" = / ] || return 0
  echo "trails: refusing to open an agent in / — cd into a project directory" >&2
  exit 1
}

# ─── Dispatch ────────────────────────────────────────────────────────────────
# `trails help` — the commands and picker keys, for whoever forgot them. Written out rather
# than scraped from the header comment, which is written for whoever edits this file.
usage() {
  cat <<'EOF'
usage: trails [command]

  (none)            this directory's sessions, then the agents you can start
  ls                where every agent session is, running or not — a table, or TSV
                    when piped
  map [N|new]       several agents in one window — pick them, or take the N that
                    most want you; `new` rebuilds instead of re-attaching
  restore           bring back every session that died with tmux (the lost ones)
  swiftbar          link the menu-bar plugin into SwiftBar (macOS); --remove unlinks
  config            the agents file: written from the built-ins the first
                    time, then opened in $EDITOR (~/.config/trails/config.json)
  help              this

In the picker:
  enter             open it: attach, restore, resume, or start the agent
  tab               toggle YOLO (run everything unconfirmed) on an agent to start or a
                    closed session; "mode": "yolo" in the config starts new rows armed
  ctrl-x            end a running session, or forget a lost one

States — ● running, ○ not:
  ● needs you       asking you something
  ● your turn       finished its turn, waiting on you
  ● working         busy
  ○ lost            tmux died under it; enter (or trails restore) brings it back
  ○ closed          it ended; enter resumes its conversation, in the mode it last ran in
  ○ elsewhere       open in a claude trails didn't start; enter says where

Env:
  AGENT_SETTLE        seconds between the two screen samples (default 0.35)
  AGENT_ASK_RE        regex meaning "the agent is asking you something"
  TRAILS_RECENT_DAYS  how far back closed sessions are listed (default 10)
  TRAILS_RECENT_MAX   how many of them (default 5)
EOF
}

# The agents, read once per run. Not for what never starts or names an agent — help, config,
# and the wrapper's --forget, which has to work even when the config is broken. ls carries on
# without them (only its closed rows need them), so a typo in the file can't blank a menu bar.
case $1 in
  help | -h | --help | config | swiftbar | --forget | --peek) AGENTS= ;;
  ls) AGENTS=$(load_agents) || AGENTS= ;;
  *) AGENTS=$(load_agents) || exit 1 ;;
esac
MODE=default
case $1 in
  '' | --print-menu) MODE=$(load_mode) ;;
  *) ;; # only the picker draws "+ new" rows
esac

case $1 in
  help | -h | --help)
    usage
    exit 0
    ;;
  ls)
    list_sessions
    exit 0
    ;;
  # Above refuse_bad_cwd with ls, and for the same reason: it opens no agent, so
  # where you are standing is not its business. You are most likely to want a map
  # from wherever you happened to walk back to.
  map)
    map "$2"
    exit 0
    ;;
  config)
    edit_config
    exit 0
    ;;
  swiftbar)
    swiftbar_link "$2"
    exit 0
    ;;
  # Box-wide like ls: each session comes back in its own recorded directory, so where you
  # stand does not matter.
  restore)
    restore_all "$2"
    exit 0
    ;;
  # Called by the wrapper launch() puts around every agent, when the agent exits.
  --forget)
    rec_forget "$2"
    exit 0
    ;;
  --print-menu)
    print_menu
    exit 0
    ;;
  --peek)
    peek "$2"
    exit 0
    ;;
  --kill)
    kill_session "$2"
    exit 0
    ;;
  --toggle-yolo)
    toggle_yolo "$2"
    exit 0
    ;;
  '') ;;
  *)
    echo "trails: unknown argument '$1' (try: trails help)" >&2
    exit 1
    ;;
esac

refuse_bad_cwd

IN_MAP=
if in_map; then
  IN_MAP=1
  USE_TMUX=1
fi

# Per-invocation temp files, exported so the fzf-spawned --toggle-yolo / --print-menu /
# --kill subprocesses all share them. Both are removed the moment fzf returns and on
# Esc/interrupt via the trap, since the exec paths below never run to an EXIT trap of their own.
#
# TRAILS_YOLO_STATE — which agent (if any) you armed for YOLO with Tab. The chosen row's verb
#                     already carries the mode by the time fzf returns, so nothing reads it after.
# TRAILS_MENU_CACHE — the running-sessions block, classified once here rather than on every
#                     reload. print_menu is re-run for each Tab and ctrl-x; live_sessions() sleeps
#                     AGENT_SETTLE to sample screens twice, so recomputing it per keystroke is
#                     what delayed the Tab relabel. The snapshot does not change over the picker's
#                     life (fzf never refreshes it on its own), so caching loses no freshness.
# TRAILS_RECENT_CACHE — the closed rows' raw TSV, for the same reason: read once, drawn per reload.
TRAILS_YOLO_STATE="${TMPDIR:-/tmp}/trails-yolo.$$"
TRAILS_MENU_CACHE="${TMPDIR:-/tmp}/trails-menu.$$"
TRAILS_RECENT_CACHE="${TMPDIR:-/tmp}/trails-recent.$$"
export TRAILS_YOLO_STATE TRAILS_MENU_CACHE TRAILS_RECENT_CACHE
rm -f "$TRAILS_YOLO_STATE"
trap 'rm -f "$TRAILS_YOLO_STATE" "$TRAILS_MENU_CACHE" "$TRAILS_RECENT_CACHE"' EXIT INT TERM

# Classify the running sessions once, up front — the only place that pays classify's settle
# sleep on the picker's happy path. Empty (not absent) with no tmux to look in.
if [ -n "$USE_TMUX" ]; then
  live_sessions >"$TRAILS_MENU_CACHE"
else
  : >"$TRAILS_MENU_CACHE"
fi

# lost rows on the same terms as the running ones: not where there is no tmux to restore into (inside plain tmux the agent would run bare, with nothing to hold
# its record). print_menu reads the verdict rather than re-deriving it, for the reason the
# cache comment above gives.
TRAILS_RESTORE_OK=
[ -n "$USE_TMUX" ] && TRAILS_RESTORE_OK=1
export TRAILS_RESTORE_OK

# closed rows need no tmux: resuming bare is still resuming.
recent_rows "$PWD" >"$TRAILS_RECENT_CACHE"

MENU=$(print_menu) || exit 1

# --height=~80%: hug the content, capped at 80%, so three sessions don't open a
# full-screen box. --wrap because a task is a sentence and a narrow pane (Zed's terminal,
# nvim's right panel) can run past the edge — wrapping costs a row and shows all of it,
# where truncating would hide the field that tells two sessions of one project apart.
#
# tab arms the highlighted row for YOLO (toggle_yolo) and reloads so print_menu can relabel
# it; the reload keeps the cursor on the row, so Tab-then-Enter lands on what you armed.
set -- --prompt='Pick a trail: ' --reverse --no-info --ansi --wrap \
  --delimiter='\t' --with-nth='3..' --height=~80% \
  --bind="tab:execute-silent($0 --toggle-yolo {2})+reload($0 --print-menu)"
# Sessions sit under their agents now, so the one that wants you is no longer row one. Start
# the cursor on it instead — the first blocked, else the first idle — so Enter still rejoins it.
# On the first `load`, then unbound: not `start`, which fires before fzf has read a row (it
# takes input asynchronously) so pos() lands on nothing; and not a standing `load`, which
# fires on every Tab reload too and would yank the cursor off the row you just armed.
want=$(printf '%s\n' "$MENU" | awk -F"$TAB" '
  $1 != "attach" { next }
  { s = $3; gsub("\033\\[[0-9;]*m", "", s) } # the glyph and word are coloured
  !b && index(s, "● needs you") { b = NR }
  !i && index(s, "● your turn") { i = NR }
  END { print b ? b : i }')
[ -n "$want" ] && set -- "$@" --bind="load:pos($want)+unbind(load)"
if printf '%s\n' "$MENU" | grep -Eq '^(attach|restore)'; then
  set -- "$@" --header='enter: open   tab: toggle YOLO   ctrl-x: end a running one, forget a lost one' \
    --bind="ctrl-x:execute-silent($0 --kill {2})+reload($0 --print-menu)"
else
  set -- "$@" --header='enter: open   tab: toggle YOLO'
fi

choice=$(printf '%s\n' "$MENU" | fzf "$@") || exit 0

# Field 2 is the target either way — a session name to attach to, or an agent to start.
# cut splits on TAB by default, the delimiter the menu is built with.
target=$(printf '%s' "$choice" | cut -f2)

rm -f "$TRAILS_YOLO_STATE" "$TRAILS_MENU_CACHE" "$TRAILS_RECENT_CACHE"
trap - EXIT INT TERM

case $choice in
  # The "start new" rule: nothing was chosen, so ask again.
  none*) exec "$SELF" ;;
  attach*)
    apply_policy "$target"
    attach_to "$target"
    ;;
  restore*)
    new=$(restore_one "$target") || exit 1
    attach_to "$new"
    ;;
  # A closed row whose conversation a claude outside trails still has open. Say where, start nothing.
  open*)
    pid=$(claude_open_pid "${target#*:}")
    echo "trails: that conversation is still open in ${target%%:*}${pid:+ (pid $pid)} — switch to it there, or quit it first" >&2
    exit 1
    ;;
  # Before yolo*, which "resume-yolo" does not match but reads as if it might. A fresh session
  # on the old conversation, recorded under its ID like any launch, so tmux dying can't lose it.
  resume*)
    mode=
    case $choice in resume-yolo*) mode=yolo ;; *) ;; esac
    launch "${target%%:*}" "$mode" "${target#*:}"
    ;;
  yolo*) launch "$target" yolo ;;
  *) launch "$target" '' ;;
esac
